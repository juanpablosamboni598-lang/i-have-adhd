[{"tipo": "planos", "titulo": "", "frames": 526, "words": [["Me", 0.15], ["cayeron", 0.26], ["cuarenta", 0.7], ["y", 1.33], ["siete", 1.38], ["dólares", 1.63], ["en", 1.99], ["un", 2.35], ["solo", 2.51], ["día.", 2.74], ["Y", 3.76], ["todos", 4.06], ["venían", 4.31], ["de", 4.79], ["ella.", 4.99], ["La", 5.9], ["regla", 6.06], ["era", 6.4], ["simple.", 6.54], ["Cada", 7.65], ["vez", 7.83], ["que", 8.01], ["mi", 8.17], ["crush", 8.31], ["me", 8.54], ["miente,", 8.76], ["me", 9.56], ["cae", 9.67], ["un", 9.92], ["dólar.", 10.04], ["Todo", 11.04], ["era", 11.24], ["divertido…", 11.49], ["hasta", 12.63], ["que", 12.9], ["me", 13.08], ["dijo…", 13.2], ["te", 13.95], ["quiero…", 13.99], ["como", 14.9], ["amigo.", 15.24], ["Y", 16.38], ["cayó", 16.42], ["una", 16.74], ["moneda.", 16.88]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "chip": null}, "planos": [{"v": "noche;X=sorprendido@0.5;fx:monedas;sh", "f": "Me cayeron cuarenta y siete dólares en un solo día."}, {"v": "noche;S=pensando@0.5;cu;kw:TODOS DE ELLA", "f": "Y todos venían de ella."}, {"v": "neutro;X=pensando@0.5;fx:moneda", "f": "La regla era simple: cada vez que mi crush me miente, me cae un dólar."}, {"v": "balcon;S=sonrojado@0.5;cu", "f": "Todo era divertido… hasta que me dijo: te quiero… como amigo."}, {"v": "balcon;X=sorprendido@0.5;cu;fx:moneda;sh", "f": "Y cayó una moneda."}]}, {"tipo": "planos", "titulo": "", "frames": 892, "words": [["Todo", 0.05], ["empezó", 0.21], ["un", 0.71], ["lunes", 0.85], ["cualquiera.", 1.16], ["Me", 2.23], ["desperté,", 2.46], ["me", 3.41], ["puse", 3.53], ["mi", 3.82], ["gorra", 3.98], ["de", 4.32], ["siempre", 4.46], ["y", 4.85], ["fui", 5.21], ["a", 5.41], ["la", 5.53], ["escuela.", 5.62], ["En", 6.66], ["el", 6.82], ["pasillo", 6.91], ["me", 7.3], ["encontré", 7.46], ["con", 7.87], ["Sofía.", 8.03], ["Pelo", 8.96], ["largo,", 9.16], ["pinza", 9.91], ["de", 10.23], ["estrella,", 10.37], ["la", 11.3], ["sonrisa", 11.37], ["que", 11.87], ["me", 12.03], ["arruina", 12.19], ["la", 12.5], ["concentración.", 12.6], ["Le", 13.94], ["pregunté,", 14.07], ["nervioso,", 14.87], ["¿te", 15.94], ["gusta", 16.03], ["mi", 16.3], ["gorra", 16.53], ["nueva?", 16.82], ["Ella", 17.62], ["dijo.", 17.91], ["¡Me", 18.85], ["encanta!", 18.94], ["Y", 20.1], ["de", 20.19], ["la", 20.3], ["nada,", 20.41], ["¡clink!", 21.05], ["Una", 21.82], ["moneda", 22.05], ["de", 22.39], ["un", 22.55], ["dólar", 22.69], ["cayó", 23.03], ["justo", 23.35], ["en", 23.62], ["mi", 23.78], ["cabeza.", 23.87], ["Miré", 24.75], ["al", 25.1], ["techo.", 25.25], ["Nada.", 26.1], ["Sofía", 26.82], ["no", 27.3], ["vio", 27.48], ["nada.", 27.66], ["Nadie", 28.55], ["vio", 28.87], ["nada.", 29.07]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "chip": ["$", "$1", "GANADO"]}, "planos": [{"v": "cuarto;X=normal@0.5", "f": "Todo empezó un lunes cualquiera. Me desperté, me puse mi gorra de siempre y fui a la escuela."}, {"v": "pasillo;S=normal@0.62;X=normal@0.3", "f": "En el pasillo me encontré con Sofía. Pelo largo, pinza de estrella, la sonrisa que me arruina la concentración."}, {"v": "pasillo;X=sonrojado@0.5;cu", "f": "Le pregunté, nervioso: ¿te gusta mi gorra nueva?"}, {"v": "pasillo;S=riendo@0.5;cu", "f": "Ella dijo: ¡me encanta!"}, {"v": "pasillo;X=sorprendido@0.4;S=riendo@0.7;fx:moneda;kw:+$1", "f": "Y de la nada, ¡clink! Una moneda de un dólar cayó justo en mi cabeza."}, {"v": "pasillo;X=pensando@0.5;cu;th:¿de dónde salió?", "f": "Miré al techo. Nada. Sofía no vio nada. Nadie vio nada."}]}, {"tipo": "planos", "titulo": "", "frames": 1031, "words": [["En", 0.05], ["el", 0.16], ["recreo", 0.3], ["hice", 0.78], ["un", 1.0], ["experimento.", 1.21], ["¿Hiciste", 2.44], ["la", 2.78], ["tarea", 2.96], ["de", 3.16], ["mate?", 3.39], ["Sí,", 3.96], ["toda,", 4.73], ["clink,", 5.6], ["otra", 6.53], ["moneda.", 6.89], ["¿Te", 8.03], ["gustó", 8.12], ["mi", 8.48], ["chiste", 8.6], ["de", 8.87], ["ayer?", 9.05], ["Jajaja,", 10.0], ["buenísimo,", 10.73], ["clink.", 11.73], ["Tres", 12.8], ["dólares,", 13.14], ["probé", 13.89], ["con", 14.16], ["mi", 14.3], ["mamá,", 14.44], ["con", 15.16], ["mi", 15.25], ["hermano,", 15.37], ["con", 16.03], ["el", 16.12], ["profe,", 16.25], ["nada.", 17.16], ["Sólo", 18.0], ["funcionaba", 18.28], ["con", 18.82], ["ella.", 19.05], ["Y", 19.8], ["ojo,", 20.05], ["que", 20.62], ["esto", 20.73], ["no", 20.94], ["es", 21.1], ["tan", 21.28], ["raro.", 21.35], ["En", 22.32], ["estudios", 22.48], ["con", 22.82], ["diarios,", 23.07], ["la", 23.87], ["gente", 23.94], ["admitió", 24.16], ["decir", 24.62], ["en", 24.87], ["promedio", 25.07], ["una", 25.62], ["o", 26.03], ["dos", 26.21], ["mentiras", 26.39], ["al", 26.82], ["día,", 27.05], ["casi", 27.73], ["todas", 28.14], ["pequeñas,", 28.53], ["para", 29.48], ["no", 29.8], ["herir", 30.0], ["a", 30.19], ["nadie.", 30.3], ["Pero", 31.28], ["yo", 31.57], ["no", 31.73], ["lo", 31.87], ["veía", 32.0], ["así,", 32.32], ["yo", 33.19], ["veía", 33.37], ["dinero.", 33.64]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "chip": ["$", "$3", "GANADO"]}, "planos": [{"v": "patio;X=pensando@0.5;th:¿y si…?", "f": "En el recreo hice un experimento."}, {"v": "patio;X=normal@0.3;S=normal@0.7", "f": "¿Hiciste la tarea de mate? Sí, toda."}, {"v": "patio;X=sorprendido@0.4;S=normal@0.7;fx:moneda", "f": "Clink. Otra moneda."}, {"v": "patio;S=riendo@0.5;cu", "f": "¿Te gustó mi chiste de ayer? Jajaja, buenísimo."}, {"v": "patio;X=riendo@0.5;cu;fx:moneda;sh", "f": "Clink. Tres dólares."}, {"v": "patio;M=normal@0.6;X=pensando@0.3", "f": "Probé con mi mamá, con mi hermano, con el profe. Nada. Solo funcionaba con ella."}, {"v": "patio;X=sorprendido@0.35;S=normal@0.7;kw:1 O 2 AL DÍA;ui:1 O 2 AL DÍA", "f": "Y ojo, que esto no es tan raro. En estudios con diarios, la gente admitió decir en promedio una o dos mentiras al día."}, {"v": "neutro;X=pensando@0.5;cu;th:casi todas pequeñitas", "f": "Casi todas pequeñas. Para no herir a nadie. Pero yo no lo veía así. Yo veía dinero."}]}, {"tipo": "planos", "titulo": "", "frames": 1192, "words": [["Así", 0.05], ["que", 0.28], ["armé", 0.44], ["un", 0.71], ["plan", 0.82], ["millonario.", 1.14], ["¿Te", 2.3], ["gusta", 2.39], ["el", 2.57], ["brócoli?", 2.78], ["¿Te", 3.64], ["encanta", 3.78], ["madrugar?", 4.1], ["¿Mi", 5.32], ["peinado", 5.53], ["se", 5.96], ["ve", 6.12], ["bien?", 6.23], ["Clink,", 7.19], ["clink,", 7.98], ["clink.", 8.55], ["Las", 9.5], ["monedas", 9.75], ["caían", 10.21], ["como", 10.64], ["lluvia.", 10.89], ["En", 11.71], ["una", 11.89], ["hora", 12.1], ["ya", 12.3], ["llevaba", 12.53], ["doce", 12.87], ["dólares.", 13.3], ["Me", 14.3], ["imaginaba", 14.48], ["comprando", 14.96], ["una", 15.46], ["consola,", 15.66], ["unos", 16.71], ["tenis,", 16.89], ["una", 17.85], ["pizza", 17.98], ["gigante.", 18.37], ["Pero", 19.41], ["Sofía", 19.78], ["empezó", 20.21], ["a", 20.69], ["mirarme", 20.71], ["raro.", 21.05], ["¿Por", 22.05], ["qué", 22.21], ["me", 22.35], ["haces", 22.46], ["tantas", 22.69], ["preguntas", 23.03], ["tontas?", 23.3], ["Y", 24.44], ["se", 24.62], ["fue", 24.73], ["a", 24.91], ["otra", 25.03], ["mesa.", 25.19], ["Sola.", 25.82], ["Con", 26.8], ["los", 27.0], ["audífonos", 27.14], ["puestos.", 27.66], ["Mi", 28.66], ["amiga", 28.85], ["Camila", 29.03], ["me", 29.46], ["jaló", 29.69], ["del", 29.89], ["brazo.", 30.03], ["Oye,", 30.96], ["la", 31.3], ["estás", 31.75], ["poniendo", 31.96], ["incómoda", 32.35], ["a", 32.94], ["propósito.", 32.98], ["Eso", 34.03], ["es", 34.3], ["tóxico.", 34.46], ["Me", 35.32], ["dolió.", 35.48], ["Porque", 36.21], ["tenía", 36.53], ["razón.", 36.89], ["Dejé", 37.73], ["de", 38.14], ["preguntarle", 38.16], ["tonterías.", 38.75]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "chip": ["$", "$12", "GANADO"]}, "planos": [{"v": "biblio;X=riendo@0.5;kw:PLAN MILLONARIO", "f": "Así que armé un plan millonario."}, {"v": "biblio;X=riendo@0.3;S=normal@0.7", "f": "¿Te gusta el brócoli? ¿Te encanta madrugar? ¿Mi peinado se ve bien?"}, {"v": "biblio;S=sonrojado@0.7;X=riendo@0.3;fx:monedas", "f": "Clink, clink, clink. Las monedas caían como lluvia."}, {"v": "biblio;X=riendo@0.5;cu;th:$12 en una hora", "f": "En una hora ya llevaba doce dólares. Me imaginaba comprando una consola, unos tenis, una pizza gigante."}, {"v": "biblio;S=enojado@0.5;cu", "f": "Pero Sofía empezó a mirarme raro. ¿Por qué me haces tantas preguntas tontas?"}, {"v": "biblio;S=preocupado@0.62;X=preocupado@0.3", "f": "Y se fue a otra mesa. Sola. Con los audífonos puestos."}, {"v": "comedor;C=enojado@0.62;X=normal@0.3", "f": "Mi amiga Camila me jaló del brazo."}, {"v": "comedor;C=enojado@0.5;cu;kw:ESO ES TÓXICO", "f": "Oye, la estás poniendo incómoda a propósito. Eso es tóxico."}, {"v": "comedor;X=preocupado@0.5;cu;th:…tiene razón", "f": "Me dolió. Porque tenía razón. Dejé de preguntarle tonterías."}]}, {"tipo": "planos", "titulo": "", "frames": 893, "words": [["Pero", 0.05], ["el", 0.19], ["viernes", 0.32], ["pasó", 0.66], ["algo", 0.98], ["raro.", 1.32], ["Le", 2.3], ["dije", 2.44], ["hola.", 2.71], ["Ella", 3.75], ["dijo.", 3.91], ["No", 4.73], ["estoy", 4.82], ["haciendo", 5.07], ["nada", 5.48], ["raro.", 5.71], ["Clink.", 6.48], ["No", 7.19], ["tengo", 7.37], ["planes", 7.66], ["el", 7.96], ["sábado.", 8.21], ["Clink.", 9.16], ["No", 9.91], ["sé", 9.98], ["ni", 10.14], ["cuándo", 10.28], ["es", 10.62], ["tu", 10.75], ["cumpleaños.", 10.82], ["Clink.", 11.89], ["Para", 12.78], ["la", 12.87], ["salida", 13.0], ["ya", 13.37], ["llevaba", 13.53], ["cuarenta", 13.87], ["y", 14.37], ["siete", 14.41], ["dólares.", 14.69], ["Todos", 15.75], ["de", 15.98], ["ella.", 16.23], ["En", 16.98], ["un", 17.1], ["solo", 17.23], ["día.", 17.46], ["Y", 18.39], ["entonces", 18.44], ["la", 18.73], ["vi.", 19.03], ["Secreteándose", 20.05], ["con", 20.64], ["Mateo.", 20.85], ["Riéndose.", 21.85], ["Escondiendo", 22.82], ["algo", 23.37], ["en", 23.69], ["la", 23.82], ["mochila.", 23.91], ["Sentí", 24.89], ["el", 25.23], ["estómago", 25.35], ["en", 25.78], ["el", 25.91], ["piso.", 26.0], ["Me", 26.82], ["estaba", 26.96], ["mintiendo", 27.19], ["todo", 27.75], ["el", 28.19], ["día…", 28.37], ["¿por", 29.16], ["él?", 29.25]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "chip": ["$", "$59", "GANADO"]}, "planos": [{"v": "pasillo;X=normal@0.3;S=preocupado@0.7;kw:VIERNES", "f": "Pero el viernes pasó algo raro."}, {"v": "pasillo;S=preocupado@0.5;cu;fx:moneda", "f": "Le dije hola. Ella dijo: no estoy haciendo nada raro. Clink."}, {"v": "patio;S=preocupado@0.7;X=pensando@0.3;fx:moneda", "f": "No tengo planes el sábado. Clink."}, {"v": "patio;S=sonrojado@0.5;cu;fx:moneda", "f": "No sé ni cuándo es tu cumpleaños. Clink."}, {"v": "patio;X=sorprendido@0.5;fx:monedas;sh", "f": "Para la salida ya llevaba cuarenta y siete dólares. Todos de ella. En un solo día."}, {"v": "calle;MT=riendo@0.7;S=riendo@0.45;X=preocupado@0.15", "f": "Y entonces la vi. Secreteándose con Mateo. Riéndose. Escondiendo algo en la mochila."}, {"v": "calle;X=llorando@0.5;cu;th:me está mintiendo por él…", "f": "Sentí el estómago en el piso. Me estaba mintiendo todo el día… ¿por él?"}]}, {"tipo": "planos", "titulo": "", "frames": 419, "words": [["Esa", 0.05], ["noche", 0.28], ["puse", 0.44], ["las", 0.87], ["cuarenta", 1.0], ["y", 1.5], ["siete", 1.57], ["monedas", 1.8], ["sobre", 2.32], ["la", 2.5], ["cama.", 2.69], ["Tenía", 3.64], ["más", 4.05], ["dinero", 4.35], ["que", 4.69], ["nunca.", 4.87], ["Y", 6.1], ["nunca", 6.21], ["me", 6.46], ["había", 6.69], ["sentido", 6.89], ["tan", 7.23], ["mal.", 7.5], ["Entendí", 8.32], ["algo.", 8.85], ["No", 9.64], ["quería", 9.82], ["ganar", 10.05], ["dinero", 10.48], ["con", 10.8], ["sus", 11.0], ["mentiras.", 11.19], ["Quería", 12.32], ["que", 12.64], ["me", 12.75], ["dijera", 12.89], ["la", 13.23], ["verdad.", 13.35]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "chip": ["$", "$59", "GANADO"]}, "planos": [{"v": "cuarto;X=llorando@0.5;fx:lluvia", "f": "Esa noche puse las cuarenta y siete monedas sobre la cama."}, {"v": "cuarto;X=preocupado@0.5;cu", "f": "Tenía más dinero que nunca. Y nunca me había sentido tan mal."}, {"v": "cuarto;X=pensando@0.5;cu;th:no quiero ganar así", "f": "Entendí algo: no quería ganar dinero con sus mentiras. Quería que me dijera la verdad."}]}, {"tipo": "planos", "titulo": "", "frames": 677, "words": [["Y", 0.05], ["entonces", 0.16], ["hice", 0.46], ["algo", 0.82], ["de", 1.1], ["lo", 1.28], ["que", 1.37], ["todavía", 1.48], ["me", 1.91], ["arrepiento.", 2.12], ["Le", 3.32], ["escribí.", 3.48], ["Ya", 4.75], ["sé", 4.94], ["que", 5.19], ["me", 5.32], ["estás", 5.48], ["mintiendo.", 5.69], ["Ella", 6.98], ["respondió.", 7.23], ["No", 8.53], ["te", 8.69], ["estoy", 8.8], ["mintiendo,", 9.05], ["te", 10.0], ["lo", 10.12], ["juro.", 10.21], ["Clink.", 11.1], ["Me", 11.89], ["dio", 12.1], ["tanta", 12.23], ["rabia", 12.71], ["que", 13.19], ["la", 13.28], ["dejé", 13.39], ["en", 13.69], ["visto.", 13.75], ["Ella", 14.71], ["me", 14.89], ["mandó", 15.07], ["tres", 15.37], ["mensajes", 15.64], ["más.", 16.12], ["No", 16.91], ["abrí", 17.05], ["ninguno.", 17.3], ["Apagué", 18.28], ["el", 18.71], ["celular", 18.78], ["y", 19.16], ["me", 19.8], ["quedé", 19.94], ["mirando", 20.16], ["el", 20.5], ["techo", 20.66], ["hasta", 21.0], ["las", 21.23], ["dos", 21.46], ["de", 21.64], ["la", 21.8], ["mañana.", 21.89]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "chip": ["$", "$60", "GANADO"]}, "planos": [{"v": "cuarto;X=enojado@0.5;fx:chat", "f": "Y entonces hice algo de lo que todavía me arrepiento. Le escribí: ya sé que me estás mintiendo."}, {"v": "cuarto;X=enojado@0.5;cu;fx:moneda", "f": "Ella respondió: no te estoy mintiendo, te lo juro. Clink."}, {"v": "cuarto;X=enojado@0.5;cu;kw:VISTO", "f": "Me dio tanta rabia que la dejé en visto."}, {"v": "cuarto;X=preocupado@0.5;cu;th:¿y si me equivoco?", "f": "Ella me mandó tres mensajes más. No abrí ninguno. Apagué el celular y me quedé mirando el techo hasta las dos de la mañana."}]}, {"tipo": "planos", "titulo": "", "frames": 1385, "words": [["El", 0.05], ["sábado", 0.16], ["mi", 0.57], ["mamá", 0.78], ["me", 1.05], ["pidió", 1.19], ["que", 1.57], ["la", 1.73], ["acompañara", 1.85], ["a", 2.46], ["casa", 2.62], ["de", 2.87], ["una", 3.07], ["vecina.", 3.21], ["Raro,", 4.07], ["pero", 4.82], ["fui.", 4.96], ["Toqué", 5.87], ["el", 6.19], ["timbre.", 6.35], ["Las", 7.28], ["luces", 7.46], ["estaban", 7.78], ["apagadas.", 8.19], ["Y", 9.3], ["de", 9.41], ["pronto.", 9.5], ["¡Sorpresa!", 10.48], ["Era", 11.64], ["mi", 11.85], ["cumpleaños.", 12.0], ["Se", 13.21], ["me", 13.41], ["había", 13.5], ["olvidado", 13.69], ["por", 14.16], ["completo.", 14.37], ["Sofía", 15.41], ["lo", 15.82], ["había", 15.98], ["organizado", 16.16], ["todo.", 16.73], ["Mateo", 17.6], ["la", 18.12], ["ayudó", 18.23], ["con", 18.5], ["el", 18.62], ["pastel.", 18.73], ["Camila", 19.62], ["con", 20.03], ["los", 20.21], ["globos.", 20.39], ["Las", 21.23], ["cuarenta", 21.37], ["y", 21.8], ["siete", 21.89], ["mentiras", 22.14], ["del", 22.6], ["viernes.", 22.82], ["Eran", 23.75], ["para", 24.07], ["que", 24.3], ["yo", 24.46], ["no", 24.6], ["descubriera", 24.69], ["nada.", 25.23], ["Y", 26.07], ["yo", 26.25], ["la", 26.39], ["había", 26.48], ["dejado", 26.66], ["en", 27.05], ["visto.", 27.19], ["Me", 28.12], ["sentí", 28.37], ["el", 28.85], ["peor", 28.98], ["amigo", 29.32], ["del", 29.53], ["mundo.", 29.75], ["Me", 30.62], ["acerqué", 30.78], ["y", 31.25], ["le", 31.46], ["dije…", 31.53], ["Perdón", 32.41], ["por", 32.73], ["lo", 32.94], ["de", 33.03], ["anoche.", 33.16], ["Pensé", 34.12], ["que", 34.46], ["me", 34.5], ["escondías", 34.64], ["algo", 35.07], ["malo.", 35.32], ["Ella", 36.3], ["se", 36.5], ["rió.", 36.71], ["¿Te", 37.55], ["escondía", 37.66], ["algo?", 38.14], ["Sí.", 38.62], ["Pero", 39.25], ["era", 39.41], ["bonito.", 39.6], ["Cantamos,", 40.5], ["comimos", 41.21], ["pastel", 41.48], ["y", 41.91], ["por", 42.55], ["primera", 42.71], ["vez", 42.98], ["en", 43.28], ["toda", 43.44], ["la", 43.66], ["semana", 43.8], ["me", 44.16], ["olvidé", 44.66], ["de", 45.1], ["las", 45.16], ["monedas.", 45.3]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "chip": ["$", "$60", "GANADO"]}, "planos": [{"v": "cuarto;M=riendo@0.62;X=normal@0.28", "f": "El sábado mi mamá me pidió que la acompañara a casa de una vecina. Raro, pero fui."}, {"v": "entrada;X=normal@0.5", "f": "Toqué el timbre. Las luces estaban apagadas."}, {"v": "fiesta;S=riendo@0.5;MT=riendo@0.78;C=riendo@0.22;fx:confeti;sh;kw:¡SORPRESA!", "f": "Y de pronto: ¡sorpresa!"}, {"v": "fiesta;X=sorprendido@0.5;cu", "f": "Era mi cumpleaños. Se me había olvidado por completo."}, {"v": "fiesta;S=sonrojado@0.62;X=sorprendido@0.3", "f": "Sofía lo había organizado todo. Mateo la ayudó con el pastel. Camila con los globos."}, {"v": "fiesta;X=pensando@0.5;cu;th:47 mentiras = 47 sorpresas", "f": "Las cuarenta y siete mentiras del viernes… eran para que yo no descubriera nada."}, {"v": "fiesta;X=preocupado@0.5;cu;th:soy un idiota", "f": "Y yo la había dejado en visto. Me sentí el peor amigo del mundo."}, {"v": "fiesta;X=preocupado@0.3;S=normal@0.7", "f": "Me acerqué y le dije: perdón por lo de anoche. Pensé que me escondías algo malo."}, {"v": "fiesta;S=riendo@0.5;cu", "f": "Ella se rió: te escondía algo, sí. Pero era bonito."}, {"v": "fiesta;X=riendo@0.3;S=riendo@0.7;fx:confeti", "f": "Cantamos, comimos pastel y por primera vez en toda la semana me olvidé de las monedas."}]}, {"tipo": "planos", "titulo": "", "frames": 779, "words": [["Más", 0.05], ["tarde", 0.37], ["salimos", 0.62], ["al", 1.07], ["balcón.", 1.3], ["Hacía", 2.41], ["frío", 2.75], ["y", 3.16], ["se", 3.3], ["veían", 3.41], ["las", 3.71], ["estrellas.", 3.85], ["Le", 5.05], ["pregunté", 5.19], ["¿por", 5.66], ["qué", 6.48], ["hiciste", 6.73], ["todo", 7.1], ["esto", 7.32], ["por", 7.62], ["mí?", 7.89], ["Ella", 8.78], ["miró", 9.0], ["al", 9.32], ["suelo", 9.44], ["y", 9.75], ["dijo…", 9.91], ["porque", 10.89], ["te", 11.0], ["quiero…", 11.23], ["como", 12.05], ["amigo.", 12.21], ["Clink.", 13.41], ["Una", 14.39], ["moneda", 14.57], ["rodó", 15.0], ["entre", 15.41], ["los", 15.64], ["dos.", 15.87], ["Y", 16.82], ["yo", 16.98], ["sabía", 17.1], ["exactamente", 17.46], ["lo", 17.89], ["que", 18.39], ["significaba.", 18.5], ["Si", 19.75], ["decir", 19.94], ["te", 20.23], ["quiero", 20.39], ["como", 20.64], ["amigo", 20.85], ["era", 21.16], ["mentira…", 21.37], ["entonces", 22.46], ["ella", 22.78], ["no", 23.14], ["me", 23.35], ["quería", 23.48], ["como", 23.66], ["amigo.", 23.96], ["Me", 24.85], ["quería", 25.0], ["más.", 25.23]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "chip": ["$", "$61", "GANADO"]}, "planos": [{"v": "balcon;X=sonrojado@0.3;S=sonrojado@0.7", "f": "Más tarde salimos al balcón. Hacía frío y se veían las estrellas."}, {"v": "balcon;X=sonrojado@0.5;cu", "f": "Le pregunté: ¿por qué hiciste todo esto por mí?"}, {"v": "balcon;S=sonrojado@0.5;cu", "f": "Ella miró al suelo y dijo: porque te quiero… como amigo."}, {"v": "balcon;X=sorprendido@0.5;cu;fx:moneda;sh;kw:CLINK", "f": "Clink."}, {"v": "balcon;X=riendo@0.5;cu;th:¡¿era MENTIRA?!", "f": "Una moneda rodó entre los dos. Y yo sabía exactamente lo que significaba."}, {"v": "balcon;X=pensando@0.5;cu;th:si es mentira…", "f": "Si decir te quiero como amigo era mentira… entonces ella no me quería como amigo. Me quería más."}]}, {"tipo": "planos", "titulo": "", "frames": 1077, "words": [["Ella", 0.05], ["vio", 0.19], ["la", 0.39], ["moneda.", 0.53], ["¿De", 1.48], ["dónde", 1.62], ["salió", 1.78], ["eso?", 2.16], ["Y", 2.78], ["le", 2.98], ["conté", 3.07], ["todo.", 3.48], ["Lo", 4.39], ["de", 4.55], ["las", 4.66], ["monedas,", 4.82], ["lo", 5.48], ["del", 5.55], ["plan", 5.66], ["millonario,", 5.96], ["lo", 6.78], ["del", 6.8], ["viernes.", 6.94], ["Hasta", 7.73], ["lo", 8.03], ["del", 8.19], ["brócoli.", 8.3], ["Ella", 9.37], ["se", 9.75], ["rió", 9.96], ["tanto", 10.21], ["que", 10.6],