8], ["la", 11.09], ["concentración.", 11.4], ["Le", 11.71], ["pregunté,", 12.03], ["nervioso:", 12.34], ["¿te", 12.65], ["gusta", 12.96], ["mi", 13.28], ["gorra", 13.59], ["nueva?", 13.9], ["Ella", 14.21], ["dijo:", 14.53], ["¡me", 14.84], ["encanta!", 15.15], ["Y", 15.46], ["de", 15.78], ["la", 16.09], ["nada,", 16.4], ["¡clink!", 16.71], ["Una", 17.02], ["moneda", 17.34], ["de", 17.65], ["un", 17.96], ["dólar", 18.27], ["cayó", 18.59], ["justo", 18.9], ["en", 19.21], ["mi", 19.52], ["cabeza.", 19.84], ["Miré", 20.15], ["al", 20.46], ["techo.", 20.77], ["Nada.", 21.09], ["Sofía", 21.4], ["no", 21.71], ["vio", 22.02], ["nada.", 22.34], ["Nadie", 22.65], ["vio", 22.96], ["nada.", 23.27]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "chip": ["$", "$1", "GANADO"]}, "planos": [{"v": "cuarto;X=normal@0.5", "f": "Todo empezó un lunes cualquiera. Me desperté, me puse mi gorra de siempre y fui a la escuela."}, {"v": "pasillo;S=normal@0.62;X=normal@0.3", "f": "En el pasillo me encontré con Sofía. Pelo largo, pinza de estrella, la sonrisa que me arruina la concentración."}, {"v": "pasillo;X=sonrojado@0.5;cu", "f": "Le pregunté, nervioso: ¿te gusta mi gorra nueva?"}, {"v": "pasillo;S=riendo@0.5;cu", "f": "Ella dijo: ¡me encanta!"}, {"v": "pasillo;X=sorprendido@0.4;S=riendo@0.7;fx:moneda;kw:+$1", "f": "Y de la nada, ¡clink! Una moneda de un dólar cayó justo en mi cabeza."}, {"v": "pasillo;X=pensando@0.5;cu;th:¿de dónde salió?", "f": "Miré al techo. Nada. Sofía no vio nada. Nadie vio nada."}]}, {"tipo": "planos", "titulo": "", "frames": 793, "words": [["En", 0.15], ["el", 0.46], ["recreo", 0.78], ["hice", 1.09], ["un", 1.4], ["experimento.", 1.71], ["¿Hiciste", 2.02], ["la", 2.34], ["tarea", 2.65], ["de", 2.96], ["mate?", 3.27], ["Sí,", 3.59], ["toda.", 3.9], ["Clink.", 4.21], ["Otra", 4.53], ["moneda.", 4.84], ["¿Te", 5.15], ["gustó", 5.46], ["mi", 5.78], ["chiste", 6.09], ["de", 6.4], ["ayer?", 6.71], ["Jajaja,", 7.03], ["buenísimo.", 7.34], ["Clink.", 7.65], ["Tres", 7.96], ["dólares.", 8.28], ["Probé", 8.59], ["con", 8.9], ["mi", 9.21], ["mamá,", 9.53], ["con", 9.84], ["mi", 10.15], ["hermano,", 10.46], ["con", 10.78], ["el", 11.09], ["profe.", 11.4], ["Nada.", 11.71], ["Solo", 12.03], ["funcionaba", 12.34], ["con", 12.65], ["ella.", 12.96], ["Y", 13.28], ["ojo,", 13.59], ["que", 13.9], ["esto", 14.21], ["no", 14.53], ["es", 14.84], ["tan", 15.15], ["raro.", 15.46], ["En", 15.78], ["estudios", 16.09], ["con", 16.4], ["diarios,", 16.71], ["la", 17.02], ["gente", 17.34], ["admitió", 17.65], ["decir", 17.96], ["en", 18.27], ["promedio", 18.59], ["una", 18.9], ["o", 19.21], ["dos", 19.52], ["mentiras", 19.84], ["al", 20.15], ["día.", 20.46], ["Casi", 20.77], ["todas", 21.09], ["pequeñas.", 21.4], ["Para", 21.71], ["no", 22.02], ["herir", 22.34], ["a", 22.65], ["nadie.", 22.96], ["Pero", 23.27], ["yo", 23.59], ["no", 23.9], ["lo", 24.21], ["veía", 24.52], ["así.", 24.84], ["Yo", 25.15], ["veía", 25.46], ["dinero.", 25.77]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "chip": ["$", "$3", "GANADO"]}, "planos": [{"v": "patio;X=pensando@0.5;th:¿y si…?", "f": "En el recreo hice un experimento."}, {"v": "patio;X=normal@0.3;S=normal@0.7", "f": "¿Hiciste la tarea de mate? Sí, toda."}, {"v": "patio;X=sorprendido@0.4;S=normal@0.7;fx:moneda", "f": "Clink. Otra moneda."}, {"v": "patio;S=riendo@0.5;cu", "f": "¿Te gustó mi chiste de ayer? Jajaja, buenísimo."}, {"v": "patio;X=riendo@0.5;cu;fx:moneda;sh", "f": "Clink. Tres dólares."}, {"v": "patio;M=normal@0.6;X=pensando@0.3", "f": "Probé con mi mamá, con mi hermano, con el profe. Nada. Solo funcionaba con ella."}, {"v": "neutro;ui:1 O 2 AL DÍA", "f": "Y ojo, que esto no es tan raro. En estudios con diarios, la gente admitió decir en promedio una o dos mentiras al día."}, {"v": "neutro;X=pensando@0.5;cu;th:casi todas pequeñitas", "f": "Casi todas pequeñas. Para no herir a nadie. Pero yo no lo veía así. Yo veía dinero."}]}, {"tipo": "planos", "titulo": "", "frames": 887, "words": [["Así", 0.15], ["que", 0.46], ["armé", 0.78], ["un", 1.09], ["plan", 1.4], ["millonario.", 1.71], ["¿Te", 2.02], ["gusta", 2.34], ["el", 2.65], ["brócoli?", 2.96], ["¿Te", 3.27], ["encanta", 3.59], ["madrugar?", 3.9], ["¿Mi", 4.21], ["peinado", 4.53], ["se", 4.84], ["ve", 5.15], ["bien?", 5.46], ["Clink,", 5.78], ["clink,", 6.09], ["clink.", 6.4], ["Las", 6.71], ["monedas", 7.03], ["caían", 7.34], ["como", 7.65], ["lluvia.", 7.96], ["En", 8.28], ["una", 8.59], ["hora", 8.9], ["ya", 9.21], ["llevaba", 9.53], ["doce", 9.84], ["dólares.", 10.15], ["Me", 10.46], ["imaginaba", 10.78], ["comprando", 11.09], ["una", 11.4], ["consola,", 11.71], ["unos", 12.03], ["tenis,", 12.34], ["una", 12.65], ["pizza", 12.96], ["gigante.", 13.28], ["Pero", 13.59], ["Sofía", 13.9], ["empezó", 14.21], ["a", 14.53], ["mirarme", 14.84], ["raro.", 15.15], ["¿Por", 15.46], ["qué", 15.78], ["me", 16.09], ["haces", 16.4], ["tantas", 16.71], ["preguntas", 17.02], ["tontas?", 17.34], ["Y", 17.65], ["se", 17.96], ["fue", 18.27], ["a", 18.59], ["otra", 18.9], ["mesa.", 19.21], ["Sola.", 19.52], ["Con", 19.84], ["los", 20.15], ["audífonos", 20.46], ["puestos.", 20.77], ["Mi", 21.09], ["amiga", 21.4], ["Camila", 21.71], ["me", 22.02], ["jaló", 22.34], ["del", 22.65], ["brazo.", 22.96], ["Oye,", 23.27], ["la", 23.59], ["estás", 23.9], ["poniendo", 24.21], ["incómoda", 24.52], ["a", 24.84], ["propósito.", 25.15], ["Eso", 25.46], ["es", 25.77], ["tóxico.", 26.09], ["Me", 26.4], ["dolió.", 26.71], ["Porque", 27.02], ["tenía", 27.34], ["razón.", 27.65], ["Dejé", 27.96], ["de", 28.27], ["preguntarle", 28.59], ["tonterías.", 28.9]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "chip": ["$", "$12", "GANADO"]}, "planos": [{"v": "biblio;X=riendo@0.5;kw:PLAN MILLONARIO", "f": "Así que armé un plan millonario."}, {"v": "biblio;X=riendo@0.3;S=normal@0.7", "f": "¿Te gusta el brócoli? ¿Te encanta madrugar? ¿Mi peinado se ve bien?"}, {"v": "biblio;S=sonrojado@0.7;X=riendo@0.3;fx:monedas", "f": "Clink, clink, clink. Las monedas caían como lluvia."}, {"v": "biblio;X=riendo@0.5;cu;th:$12 en una hora", "f": "En una hora ya llevaba doce dólares. Me imaginaba comprando una consola, unos tenis, una pizza gigante."}, {"v": "biblio;S=enojado@0.5;cu", "f": "Pero Sofía empezó a mirarme raro. ¿Por qué me haces tantas preguntas tontas?"}, {"v": "biblio;S=preocupado@0.62;X=preocupado@0.3", "f": "Y se fue a otra mesa. Sola. Con los audífonos puestos."}, {"v": "comedor;C=enojado@0.62;X=normal@0.3", "f": "Mi amiga Camila me jaló del brazo."}, {"v": "comedor;C=enojado@0.5;cu;kw:ESO ES TÓXICO", "f": "Oye, la estás poniendo incómoda a propósito. Eso es tóxico."}, {"v": "comedor;X=preocupado@0.5;cu;th:…tiene razón", "f": "Me dolió. Porque tenía razón. Dejé de preguntarle tonterías."}]}, {"tipo": "planos", "titulo": "", "frames": 709, "words": [["Pero", 0.15], ["el", 0.46], ["viernes", 0.78], ["pasó", 1.09], ["algo", 1.4], ["raro.", 1.71], ["Le", 2.02], ["dije", 2.34], ["hola.", 2.65], ["Ella", 2.96], ["dijo:", 3.27], ["no", 3.59], ["estoy", 3.9], ["haciendo", 4.21], ["nada", 4.53], ["raro.", 4.84], ["Clink.", 5.15], ["No", 5.46], ["tengo", 5.78], ["planes", 6.09], ["el", 6.4], ["sábado.", 6.71], ["Clink.", 7.03], ["No", 7.34], ["sé", 7.65], ["ni", 7.96], ["cuándo", 8.28], ["es", 8.59], ["tu", 8.9], ["cumpleaños.", 9.21], ["Clink.", 9.53], ["Para", 9.84], ["la", 10.15], ["salida", 10.46], ["ya", 10.78], ["llevaba", 11.09], ["cuarenta", 11.4], ["y", 11.71], ["siete", 12.03], ["dólares.", 12.34], ["Todos", 12.65], ["de", 12.96], ["ella.", 13.28], ["En", 13.59], ["un", 13.9], ["solo", 14.21], ["día.", 14.53], ["Y", 14.84], ["entonces", 15.15], ["la", 15.46], ["vi.", 15.78], ["Secreteándose", 16.09], ["con", 16.4], ["Mateo.", 16.71], ["Riéndose.", 17.02], ["Escondiendo", 17.34], ["algo", 17.65], ["en", 17.96], ["la", 18.27], ["mochila.", 18.59], ["Sentí", 18.9], ["el", 19.21], ["estómago", 19.52], ["en", 19.84], ["el", 20.15], ["piso.", 20.46], ["Me", 20.77], ["estaba", 21.09], ["mintiendo", 21.4], ["todo", 21.71], ["el", 22.02], ["día…", 22.34], ["¿por", 22.65], ["él?", 22.96]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "chip": ["$", "$59", "GANADO"]}, "planos": [{"v": "pasillo;X=normal@0.3;S=preocupado@0.7;kw:VIERNES", "f": "Pero el viernes pasó algo raro."}, {"v": "pasillo;S=preocupado@0.5;cu;fx:moneda", "f": "Le dije hola. Ella dijo: no estoy haciendo nada raro. Clink."}, {"v": "patio;S=preocupado@0.7;X=pensando@0.3;fx:moneda", "f": "No tengo planes el sábado. Clink."}, {"v": "patio;S=sonrojado@0.5;cu;fx:moneda", "f": "No sé ni cuándo es tu cumpleaños. Clink."}, {"v": "patio;X=sorprendido@0.5;fx:monedas;sh", "f": "Para la salida ya llevaba cuarenta y siete dólares. Todos de ella. En un solo día."}, {"v": "calle;MT=riendo@0.7;S=riendo@0.45;X=preocupado@0.15", "f": "Y entonces la vi. Secreteándose con Mateo. Riéndose. Escondiendo algo en la mochila."}, {"v": "calle;X=llorando@0.5;cu;th:me está mintiendo por él…", "f": "Sentí el estómago en el piso. Me estaba mintiendo todo el día… ¿por él?"}]}, {"tipo": "planos", "titulo": "", "frames": 371, "words": [["Esa", 0.15], ["noche", 0.46], ["puse", 0.78], ["las", 1.09], ["cuarenta", 1.4], ["y", 1.71], ["siete", 2.02], ["monedas", 2.34], ["sobre", 2.65], ["la", 2.96], ["cama.", 3.27], ["Tenía", 3.59], ["más", 3.9], ["dinero", 4.21], ["que", 4.53], ["nunca.", 4.84], ["Y", 5.15], ["nunca", 5.46], ["me", 5.78], ["había", 6.09], ["sentido", 6.4], ["tan", 6.71], ["mal.", 7.03], ["Entendí", 7.34], ["algo:", 7.65], ["no", 7.96], ["quería", 8.28], ["ganar", 8.59], ["dinero", 8.9], ["con", 9.21], ["sus", 9.53], ["mentiras.", 9.84], ["Quería", 10.15], ["que", 10.46], ["me", 10.78], ["dijera", 11.09], ["la", 11.4], ["verdad.", 11.71]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "chip": ["$", "$59", "GANADO"]}, "planos": [{"v": "cuarto;X=llorando@0.5;fx:lluvia", "f": "Esa noche puse las cuarenta y siete monedas sobre la cama."}, {"v": "cuarto;X=preocupado@0.5;cu", "f": "Tenía más dinero que nunca. Y nunca me había sentido tan mal."}, {"v": "cuarto;X=pensando@0.5;cu;th:no quiero ganar así", "f": "Entendí algo: no quería ganar dinero con sus mentiras. Quería que me dijera la verdad."}]}, {"tipo": "planos", "titulo": "", "frames": 587, "words": [["Y", 0.15], ["entonces", 0.46], ["hice", 0.78], ["algo", 1.09], ["de", 1.4], ["lo", 1.71], ["que", 2.02], ["todavía", 2.34], ["me", 2.65], ["arrepiento.", 2.96], ["Le", 3.27], ["escribí:", 3.59], ["ya", 3.9], ["sé", 4.21], ["que", 4.53], ["me", 4.84], ["estás", 5.15], ["mintiendo.", 5.46], ["Ella", 5.78], ["respondió:", 6.09], ["no", 6.4], ["te", 6.71], ["estoy", 7.03], ["mintiendo,", 7.34], ["te", 7.65], ["lo", 7.96], ["juro.", 8.28], ["Clink.", 8.59], ["Me", 8.9], ["dio", 9.21], ["tanta", 9.53], ["rabia", 9.84], ["que", 10.15], ["la", 10.46], ["dejé", 10.78], ["en", 11.09], ["visto.", 11.4], ["Ella", 11.71], ["me", 12.03], ["mandó", 12.34], ["tres", 12.65], ["mensajes", 12.96], ["más.", 13.28], ["No", 13.59], ["abrí", 13.9], ["ninguno.", 14.21], ["Apagué", 14.53], ["el", 14.84], ["celular", 15.15], ["y", 15.46], ["me", 15.78], ["quedé", 16.09], ["mirando", 16.4], ["el", 16.71], ["techo", 17.02], ["hasta", 17.34], ["las", 17.65], ["dos", 17.96], ["de", 18.27], ["la", 18.59], ["mañana.", 18.9]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "chip": ["$", "$60", "GANADO"]}, "planos": [{"v": "cuarto;X=enojado@0.5;fx:chat", "f": "Y entonces hice algo de lo que todavía me arrepiento. Le escribí: ya sé que me estás mintiendo."}, {"v": "cuarto;X=enojado@0.5;cu;fx:moneda", "f": "Ella respondió: no te estoy mintiendo, te lo juro. Clink."}, {"v": "cuarto;X=enojado@0.5;cu;kw:VISTO", "f": "Me dio tanta rabia que la dejé en visto."}, {"v": "cuarto;X=preocupado@0.5;cu;th:¿y si me equivoco?", "f": "Ella me mandó tres mensajes más. No abrí ninguno. Apagué el celular y me quedé mirando el techo hasta las dos de la mañana."}]}, {"tipo": "planos", "titulo": "", "frames": 1159, "words": [["El", 0.15], [