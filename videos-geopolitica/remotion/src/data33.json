7.02], ["de", 37.34], ["las", 37.65], ["monedas.", 37.96]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "chip": ["$", "$60", "GANADO"]}, "planos": [{"v": "cuarto;M=riendo@0.62;X=normal@0.28", "f": "El sábado mi mamá me pidió que la acompañara a casa de una vecina. Raro, pero fui."}, {"v": "entrada;X=normal@0.5", "f": "Toqué el timbre. Las luces estaban apagadas."}, {"v": "fiesta;S=riendo@0.5;MT=riendo@0.78;C=riendo@0.22;fx:confeti;sh;kw:¡SORPRESA!", "f": "Y de pronto: ¡sorpresa!"}, {"v": "fiesta;X=sorprendido@0.5;cu", "f": "Era mi cumpleaños. Se me había olvidado por completo."}, {"v": "fiesta;S=sonrojado@0.62;X=sorprendido@0.3", "f": "Sofía lo había organizado todo. Mateo la ayudó con el pastel. Camila con los globos."}, {"v": "fiesta;X=pensando@0.5;cu;th:47 mentiras = 47 sorpresas", "f": "Las cuarenta y siete mentiras del viernes… eran para que yo no descubriera nada."}, {"v": "fiesta;X=preocupado@0.5;cu;th:soy un idiota", "f": "Y yo la había dejado en visto. Me sentí el peor amigo del mundo."}, {"v": "fiesta;X=preocupado@0.3;S=normal@0.7", "f": "Me acerqué y le dije: perdón por lo de anoche. Pensé que me escondías algo malo."}, {"v": "fiesta;S=riendo@0.5;cu", "f": "Ella se rió: te escondía algo, sí. Pero era bonito."}, {"v": "fiesta;X=riendo@0.3;S=riendo@0.7;fx:confeti", "f": "Cantamos, comimos pastel y por primera vez en toda la semana me olvidé de las monedas."}]}, {"tipo": "planos", "titulo": "", "frames": 615, "words": [["Más", 0.15], ["tarde", 0.46], ["salimos", 0.78], ["al", 1.09], ["balcón.", 1.4], ["Hacía", 1.71], ["frío", 2.02], ["y", 2.34], ["se", 2.65], ["veían", 2.96], ["las", 3.27], ["estrellas.", 3.59], ["Le", 3.9], ["pregunté:", 4.21], ["¿por", 4.53], ["qué", 4.84], ["hiciste", 5.15], ["todo", 5.46], ["esto", 5.78], ["por", 6.09], ["mí?", 6.4], ["Ella", 6.71], ["miró", 7.03], ["al", 7.34], ["suelo", 7.65], ["y", 7.96], ["dijo:", 8.28], ["porque", 8.59], ["te", 8.9], ["quiero…", 9.21], ["como", 9.53], ["amigo.", 9.84], ["Clink.", 10.15], ["Una", 10.46], ["moneda", 10.78], ["rodó", 11.09], ["entre", 11.4], ["los", 11.71], ["dos.", 12.03], ["Y", 12.34], ["yo", 12.65], ["sabía", 12.96], ["exactamente", 13.28], ["lo", 13.59], ["que", 13.9], ["significaba.", 14.21], ["Si", 14.53], ["decir", 14.84], ["te", 15.15], ["quiero", 15.46], ["como", 15.78], ["amigo", 16.09], ["era", 16.4], ["mentira…", 16.71], ["entonces", 17.02], ["ella", 17.34], ["no", 17.65], ["me", 17.96], ["quería", 18.27], ["como", 18.59], ["amigo.", 18.9], ["Me", 19.21], ["quería", 19.52], ["más.", 19.84]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "chip": ["$", "$61", "GANADO"]}, "planos": [{"v": "balcon;X=sonrojado@0.3;S=sonrojado@0.7", "f": "Más tarde salimos al balcón. Hacía frío y se veían las estrellas."}, {"v": "balcon;X=sonrojado@0.5;cu", "f": "Le pregunté: ¿por qué hiciste todo esto por mí?"}, {"v": "balcon;S=sonrojado@0.5;cu", "f": "Ella miró al suelo y dijo: porque te quiero… como amigo."}, {"v": "balcon;X=sorprendido@0.5;cu;fx:moneda;sh;kw:CLINK", "f": "Clink."}, {"v": "balcon;X=riendo@0.5;cu;th:¡¿era MENTIRA?!", "f": "Una moneda rodó entre los dos. Y yo sabía exactamente lo que significaba."}, {"v": "balcon;X=pensando@0.5;cu;th:si es mentira…", "f": "Si decir te quiero como amigo era mentira… entonces ella no me quería como amigo. Me quería más."}]}, {"tipo": "planos", "titulo": "", "frames": 896, "words": [["Ella", 0.15], ["vio", 0.46], ["la", 0.78], ["moneda.", 1.09], ["¿De", 1.4], ["dónde", 1.71], ["salió", 2.02], ["eso?", 2.34], ["Y", 2.65], ["le", 2.96], ["conté", 3.27], ["todo.", 3.59], ["Lo", 3.9], ["de", 4.21], ["las", 4.53], ["monedas,", 4.84], ["lo", 5.15], ["del", 5.46], ["plan", 5.78], ["millonario,", 6.09], ["lo", 6.4], ["del", 6.71], ["viernes.", 7.03], ["Hasta", 7.34], ["lo", 7.65], ["del", 7.96], ["brócoli.", 8.28], ["Ella", 8.59], ["se", 8.9], ["rió", 9.21], ["tanto", 9.53], ["que", 9.84], ["tuvo", 10.15], ["que", 10.46], ["agarrarse", 10.78], ["del", 11.09], ["barandal.", 11.4], ["Así", 11.71], ["que", 12.03], ["por", 12.34], ["eso", 12.65], ["me", 12.96], ["preguntabas", 13.28], ["tantas", 13.59], ["tonterías.", 13.9], ["Junté", 14.21], ["todo", 14.53], ["el", 14.84], ["valor", 15.15], ["que", 15.46], ["tenía", 15.78], ["y", 16.09], ["le", 16.4], ["dije:", 16.71], ["Sofía,", 17.02], ["yo", 17.34], ["no", 17.65], ["te", 17.96], ["quiero", 18.27], ["como", 18.59], ["amigo.", 18.9], ["Ella", 19.21], ["se", 19.52], ["puso", 19.84], ["roja", 20.15], ["como", 20.46], ["un", 20.77], ["tomate.", 21.09], ["Y", 21.4], ["dijo", 21.71], ["bajito:", 22.02], ["yo", 22.34], ["tampoco.", 22.65], ["Esperé", 22.96], ["el", 23.27], ["clink.", 23.59], ["Pero", 23.9], ["no", 24.21], ["cayó", 24.52], ["nada.", 24.84], ["Ninguna", 25.15], ["moneda.", 25.46], ["Era", 25.77], ["verdad.", 26.09], ["Y", 26.4], ["valía", 26.71], ["más", 27.02], ["que", 27.34], ["los", 27.65], ["sesenta", 27.96], ["y", 28.27], ["un", 28.59], ["dólares", 28.9], ["juntos.", 29.21]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "chip": ["$", "$61", "GANADO"]}, "planos": [{"v": "balcon;S=sorprendido@0.7;X=sonrojado@0.3", "f": "Ella vio la moneda. ¿De dónde salió eso?"}, {"v": "balcon;X=riendo@0.5;cu", "f": "Y le conté todo. Lo de las monedas, lo del plan millonario, lo del viernes. Hasta lo del brócoli."}, {"v": "balcon;S=riendo@0.5;cu;kw:JAJAJA", "f": "Ella se rió tanto que tuvo que agarrarse del barandal. Así que por eso me preguntabas tantas tonterías."}, {"v": "balcon;X=sonrojado@0.5;cu", "f": "Junté todo el valor que tenía y le dije: Sofía, yo no te quiero como amigo."}, {"v": "balcon;S=sonrojado@0.5;cu", "f": "Ella se puso roja como un tomate. Y dijo bajito: yo tampoco."}, {"v": "balcon;X=riendo@0.3;S=riendo@0.7;fx:brillo;kw:0 MONEDAS", "f": "Esperé el clink. Pero no cayó nada. Ninguna moneda."}, {"v": "balcon;X=sonrojado@0.3;S=riendo@0.7;fx:brillo", "f": "Era verdad. Y valía más que los sesenta y un dólares juntos."}]}, {"tipo": "planos", "titulo": "", "frames": 484, "words": [["Esa", 0.15], ["noche", 0.46], ["entendí", 0.78], ["que", 1.09], ["no", 1.4], ["todas", 1.71], ["las", 2.02], ["mentiras", 2.34], ["son", 2.65], ["malas.", 2.96], ["Algunas", 3.27], ["esconden", 3.59], ["una", 3.9], ["fiesta.", 4.21], ["Pero", 4.53], ["la", 4.84], ["verdad,", 5.15], ["la", 5.46], ["de", 5.78], ["verdad,", 6.09], ["siempre", 6.4], ["necesita", 6.71], ["un", 7.03], ["poco", 7.34], ["de", 7.65], ["valor.", 7.96], ["Y", 8.28], ["tú,", 8.59], ["si", 8.9], ["ganaras", 9.21], ["un", 9.53], ["dólar", 9.84], ["cada", 10.15], ["vez", 10.46], ["que", 10.78], ["tu", 11.09], ["crush", 11.4], ["te", 11.71], ["miente,", 12.03], ["¿le", 12.34], ["dirías", 12.65], ["o", 12.96], ["te", 13.28], ["harías", 13.59], ["millonario?", 13.9], ["Te", 14.21], ["leo", 14.53], ["en", 14.84], ["los", 15.15], ["comentarios.", 15.46]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "chip": null}, "planos": [{"v": "cuarto;X=normal@0.5;cu", "f": "Esa noche entendí que no todas las mentiras son malas. Algunas esconden una fiesta."}, {"v": "cuarto;X=pensando@0.5;cu;th:la verdad cuesta valor", "f": "Pero la verdad, la de verdad, siempre necesita un poco de valor."}, {"v": "neutro;X=pensando@0.5;ui:¿QUÉ HARÍAS TÚ?", "f": "Y tú, si ganaras un dólar cada vez que tu crush te miente, ¿le dirías o te harías millonario? Te leo en los comentarios."}]}]