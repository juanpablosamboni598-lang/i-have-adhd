, "words": [["Las", 0.05], ["calles", 0.19], ["están", 0.53], ["llenas", 0.8], ["de", 1.21], ["sacos", 1.39], ["de", 1.75], ["arena.", 1.91], ["En", 2.8], ["el", 2.98], ["cielo", 3.12], ["flotan", 3.32], ["globos", 3.82], ["gigantes", 4.16], ["para", 4.62], ["estorbar", 4.96], ["a", 5.41], ["los", 5.53], ["aviones.", 5.66], ["La", 6.85], ["gente", 7.12], ["corre", 7.37], ["hacia", 7.8], ["el", 8.07], ["metro.", 8.28], ["Durante", 9.21], ["el", 9.53], ["Blitz,", 9.66], ["miles", 10.37], ["de", 10.69], ["londinenses", 10.87], ["dormían", 11.41], ["en", 11.98], ["las", 12.12], ["estaciones", 12.28], ["para", 12.71], ["protegerse.", 13.03], ["Tu", 14.3], ["cerebro", 14.46], ["calcula", 14.87], ["en", 15.37], ["un", 15.48], ["segundo", 15.6], ["la", 15.98], ["ruta", 16.19], ["más", 16.44], ["rápida", 16.71], ["al", 17.12], ["refugio.", 17.23], ["Ves", 18.3], ["a", 18.57], ["una", 18.69], ["mamá", 18.82], ["con", 19.16], ["su", 19.37], ["hijo,", 19.57], ["perdidos.", 19.94], ["Los", 21.0], ["tomas", 21.19], ["de", 21.46], ["la", 21.64], ["mano", 21.73], ["y", 22.0], ["los", 22.32], ["guías", 22.46], ["entre", 22.75], ["el", 23.07], ["humo.", 23.23], ["Llegan", 24.05], ["al", 24.3], ["andén", 24.48], ["justo", 24.78], ["a", 25.19], ["tiempo.", 25.46], ["La", 26.37], ["señora", 26.57], ["te", 26.85], ["da", 27.07], ["las", 27.16], ["gracias", 27.32], ["llorando.", 27.64], ["Bajo", 28.19], ["tierra,", 29.0], ["cientos", 29.85], ["de", 30.14], ["personas", 30.32], ["comparten", 30.71], ["mantas,", 31.23], ["té", 32.05], ["y", 32.44], ["canciones", 32.53], ["para", 32.98], ["no", 33.25], ["escuchar", 33.41], ["las", 33.91], ["explosiones", 34.03], ["de", 34.57], ["arriba.", 34.73], ["Nadie", 35.64], ["llora", 36.1], ["en", 36.37], ["voz", 36.48], ["alta.", 36.66], ["Los", 37.64], ["niños", 37.75], ["juegan", 37.98], ["a", 38.41], ["las", 38.5], ["cartas.", 38.62], ["Y", 39.57], ["tú", 39.62], ["piensas", 39.78], ["que", 40.16], ["eso", 40.32], ["también", 40.46], ["es", 40.87], ["una", 40.98], ["forma", 41.14], ["de", 41.44], ["valentía.", 41.57]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "chip": ["IQ", "∞", "NIVEL"]}, "planos": [{"v": "londres;X=preocupado@0.5", "f": "Las calles están llenas de sacos de arena. En el cielo flotan globos gigantes para estorbar a los aviones."}, {"v": "londres;M=preocupado@0.62;H=llorando@0.78;X=normal@0.25", "f": "La gente corre hacia el metro. Durante el Blitz, miles de londinenses dormían en las estaciones para protegerse."}, {"v": "londres;X=pensando@0.5;cu;th:refugio más cercano: 340 m", "f": "Tu cerebro calcula en un segundo la ruta más rápida al refugio."}, {"v": "londres;X=enojado@0.4;M=preocupado@0.7", "f": "Ves a una mamá con su hijo, perdidos. Los tomas de la mano y los guías entre el humo."}, {"v": "refugio;M=llorando@0.62;H=riendo@0.78;X=sonrojado@0.28", "f": "Llegan al andén justo a tiempo. La señora te da las gracias llorando."}, {"v": "refugio;H=riendo@0.5;cu", "f": "Bajo tierra, cientos de personas comparten mantas, té y canciones para no escuchar las explosiones de arriba."}, {"v": "refugio;X=pensando@0.5;cu;th:nadie aquí se rinde…", "f": "Nadie llora en voz alta. Los niños juegan a las cartas. Y tú piensas que eso también es una forma de valentía."}]}, {"tipo": "planos", "titulo": "", "frames": 681, "words": [["Pero", 0.05], ["un", 0.16], ["policía", 0.3], ["te", 0.78], ["mira", 0.91], ["raro.", 1.12], ["Gorra", 2.1], ["rara,", 2.62], ["sudadera", 3.25], ["rara,", 3.71], ["hablas", 4.46], ["raro.", 4.78], ["—Usted", 5.85], ["viene", 6.03], ["conmigo.", 6.28], ["Puede", 7.37], ["ser", 7.5], ["un", 7.69], ["espía.", 7.85], ["En", 8.85], ["la", 8.98], ["comisaría,", 9.07], ["para", 10.03], ["demostrar", 10.12], ["quién", 10.64], ["eres,", 10.82], ["resuelves", 11.66], ["en", 12.19], ["un", 12.32], ["minuto", 12.44], ["un", 12.89], ["problema", 13.12], ["de", 13.48], ["matemáticas", 13.66], ["que", 14.3], ["llevaba", 14.53], ["semanas", 14.87], ["en", 15.25], ["un", 15.6], ["periódico.", 15.71], ["El", 16.82], ["policía", 16.96], ["hace", 17.55], ["una", 17.85], ["llamada.", 18.0], ["Y", 19.03], ["esa", 19.1], ["misma", 19.25], ["noche,", 19.5], ["un", 20.35], ["auto", 20.46], ["negro", 20.66], ["te", 20.98], ["lleva", 21.25], ["fuera", 21.5], ["de", 21.78], ["Londres.", 21.98]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "chip": ["IQ", "∞", "NIVEL"]}, "planos": [{"v": "refugio;K=enojado@0.62;X=preocupado@0.28", "f": "Pero un policía te mira raro. Gorra rara, sudadera rara, hablas raro."}, {"v": "refugio;K=enojado@0.5;cu", "f": "—Usted viene conmigo. Puede ser un espía."}, {"v": "neutro;X=pensando@0.5;fx:ecuaciones", "f": "En la comisaría, para demostrar quién eres, resuelves en un minuto un problema de matemáticas que llevaba semanas en un periódico."}, {"v": "neutro;K=sorprendido@0.5;cu", "f": "El policía hace una llamada. Y esa misma noche, un auto negro te lleva fuera de Londres."}]}, {"tipo": "planos", "titulo": "", "frames": 1029, "words": [["Te", 0.05], ["llevan", 0.14], ["a", 0.37], ["Bletchley", 0.53], ["Park,", 1.0], ["una", 1.73], ["mansión", 1.94], ["rodeada", 2.44], ["de", 2.98], ["barracas", 3.19], ["de", 3.71], ["madera.", 3.82], ["La", 4.69], ["comandante", 4.89], ["te", 5.37], ["explica", 5.57], ["en", 6.05], ["voz", 6.25], ["baja.", 6.39], ["Aquí", 7.41], ["se", 7.66], ["intentan", 7.82], ["leer", 8.3], ["los", 8.55], ["mensajes", 8.82], ["secretos", 9.35], ["del", 9.94], ["enemigo.", 10.1], ["Esos", 11.14], ["mensajes", 11.44], ["se", 11.91], ["cifran", 12.16], ["con", 12.48], ["una", 12.71], ["máquina", 12.91], ["llamada", 13.19], ["Enigma.", 13.78], ["Cada", 14.96], ["letra", 15.3], ["que", 15.64], ["escribes", 15.82], ["se", 16.23], ["convierte", 16.41], ["en", 16.78], ["otra.", 16.98], ["Tiene", 17.96], ["unos", 18.25], ["ciento", 18.48], ["cincuenta", 18.82], ["y", 19.46], ["nueve", 19.57], ["trillones", 19.87], ["de", 20.32], ["trillones", 20.55], ["de", 20.96], ["combinaciones", 21.12], ["posibles.", 21.66], ["Y", 22.75], ["la", 23.03], ["clave", 23.16], ["cambia", 23.46], ["cada", 23.98], ["medianoche.", 24.28], ["Ahí", 25.57], ["conoces", 25.8], ["a", 26.32], ["Alan", 26.53], ["Turing,", 26.85], ["un", 27.8], ["matemático", 27.98], ["que", 28.57], ["en", 28.85], ["mil", 28.96], ["novecientos", 29.16], ["cuarenta", 29.85], ["construyó", 30.32], ["una", 30.85], ["máquina", 31.0], ["enorme", 31.28], ["para", 31.69], ["probar", 31.96], ["combinaciones.", 32.32], ["La", 33.57], ["Bomba.", 33.66]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "chip": ["IQ", "∞", "NIVEL"]}, "planos": [{"v": "bletchley;X=sorprendido@0.5", "f": "Te llevan a Bletchley Park, una mansión rodeada de barracas de madera."}, {"v": "bletchley;D=normal@0.62;X=normal@0.28;ui:ALTO SECRETO", "f": "La comandante te explica en voz baja: aquí se intentan leer los mensajes secretos del enemigo."}, {"v": "neutro;fx:enigma", "f": "Esos mensajes se cifran con una máquina llamada Enigma. Cada letra que escribes se convierte en otra."}, {"v": "neutro;fx:enigma;ui:159 TRILLONES DE TRILLONES", "f": "Tiene unos ciento cincuenta y nueve trillones de trillones de combinaciones posibles. Y la clave cambia cada medianoche."}, {"v": "bletchley;T=pensando@0.62;X=normal@0.28", "f": "Ahí conoces a Alan Turing, un matemático que en mil novecientos cuarenta construyó una máquina enorme para probar combinaciones: la Bomba."}]}, {"tipo": "planos", "titulo": "", "frames": 979, "words": [["Miras", 0.05], ["un", 0.41], ["mensaje", 0.57], ["cifrado", 1.03], ["y", 1.53], ["tu", 1.91], ["cerebro", 2.07], ["empieza", 2.48], ["a", 2.89], ["girar", 3.12], ["como", 3.41], ["mil", 3.64], ["bombas", 3.94], ["al", 4.48], ["mismo", 4.64], ["tiempo.", 4.87], ["Encuentras", 5.82], ["patrones", 6.39], ["que", 6.91], ["nadie", 7.1], ["ve,", 7.46], ["descartas", 8.19], ["millones", 8.71], ["de", 9.0], ["combinaciones", 9.3], ["por", 9.94], ["segundo.", 10.23], ["En", 11.41], ["diez", 11.6], ["minutos", 11.82], ["tienes", 12.23], ["la", 12.69], ["clave", 12.94], ["del", 13.28], ["día.", 13.5], ["Turing", 14.5], ["te", 14.71], ["mira,", 14.89], ["se", 15.39], ["quita", 15.48], ["los", 15.69], ["lentes", 15.87], ["y", 16.14], ["pregunta", 16.39], ["despacio.", 16.73], ["¿Cómo", 17.82], ["lo", 17.98], ["hizo?", 18.16], ["No", 19.1], ["puedes", 19.32], ["decirle", 19.66], ["que", 20.16], ["vienes", 20.28], ["del", 20.6], ["futuro.", 20.71], ["Así", 21.71], ["que", 21.98], ["dices", 22.16], ["lo", 22.44], ["único", 22.64], ["que", 22.89], ["se", 23.1], ["te", 23.21], ["ocurre.", 23.32], ["Intuición.", 24.25], ["Turing", 25.37], ["sonríe.", 25.73], ["Él", 26.87], ["también", 27.03], ["sabe", 27.28], ["lo", 27.62], ["que", 27.8], ["es", 27.89], ["pensar", 28.0], ["distinto", 28.3], ["a", 28.85], ["los", 28.98], ["demás.", 29.12], ["Desde", 29.94], ["ese", 30.28], ["día", 30.62], ["te", 30.91], ["dejas", 31.12], ["sentarte", 31.39], ["a", 31.87], ["su", 31.96], ["lado.", 32.05]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "chip": ["IQ", "∞", "NIVEL"]}, "planos": [{"v": "bletchley;X=pensando@0.5;cu;th:las teclas nunca se cifran a sí mismas…", "f": "Miras un mensaje cifrado y tu cerebro empieza a girar como mil Bombas al mismo tiempo."}, {"v": "neutro;X=pensando@0.5;fx:ecuaciones", "f": "Encuentras patrones que nadie ve. Descartas millones de combinaciones por segundo."}, {"v": "bletchley;X=riendo@0.5;cu", "f": "En diez minutos tienes la clave del día."}, {"v": "bletchley;T=sorprendido@0.62;X=riendo@0.28", "f": "Turing te mira, se quita los lentes y pregunta despacio: —¿Cómo lo hizo?"}, {"v": "bletchley;X=sonrojado@0.5;cu", "f": "No puedes decirle que vienes del futuro. Así que dices lo único que se te ocurre: —Intuición."}, {"v": "bletchley;T=riendo@0.5;cu", "f": "Turing sonríe. Él también sabe lo que es pensar distinto a los demás. Desde ese día te deja sentarte a su lado."}]}, {"tipo": "planos", "titulo": "", "frames": 1214, "words": [["En", 0.05], ["la", 0.16], ["barraca", 0.28], ["hay", 0.66], ["una", 0.85], ["joven", 0.98], ["que", 1.35], ["no", 1.5], ["se", 1.73], ["impresiona.", 1.89], ["Se", 2.69], ["llama", 2.85], ["Sofía.", 3.05], ["Dato", 4.19], ["real,", 4.48], ["cerca", 5.25], ["de", 5.5], ["tres", 5.78], ["de", 6.03], ["cada", 6.19], ["cuatro", 6.37], ["personas", 6.71], ["que", 7.19], ["trabajaban", 7.39], ["en", 7.94], ["Bletchley", 8.12], ["eran", 8.6], ["mujeres.", 8.94], ["Sofía", 10.12], ["lleva", 10.6], ["meses", 10.82], ["descifrando", 11.21], ["mensajes", 11.82], ["a", 12.41], ["mano.", 12.6], ["Y", 13.25], ["no", 13.5], ["le", 13.6], ["gusta", 13.71], ["que", 13.98], ["un", 14.19], ["recién", 14.28], ["llegado", 14.62], ["presuma.", 14.94], ["Te", 15.94], ["reta.", 16.07], ["—Si", 17.0], ["eres", 17.1], ["tan", 17.28], ["listo,", 17.5], ["descifra", 18.23], ["este.", 18.66], ["Es", 19.62], ["de", 19.8], ["un", 19.91], ["barco", 20.03], ["en", 20.32], ["el", 20.46], ["Atlántico.", 20.55], ["Por", 21.66], ["primera", 21.8], ["vez,", 22.1], ["tu", 22.64], ["cerebro", 22.71], ["se", 23.07], ["traba.", 23.23], ["El", 23.98], ["mensaje", 24.12], ["es", 24.5], ["demasiado", 24.64], ["corto.", 24.89], ["Sofía", 25.96], ["sonríe", 26.5], ["y", 27.19], ["te", 27.3], ["pasa", 27.39], ["un", 27.6], ["papel.", 27.73], ["Los", 28.66], ["barcos", 28.82], ["siempre", 29.19], ["mandan", 29.48], ["el", 29.91], ["parte", 30.07], ["del", 30.28], ["clima", 30.53], ["a", 30.85], ["la", 30.98], ["misma", 31.0], ["hora.", 31.23], ["Empieza", 32.07], ["por", 32.41], ["ahí.", 32.64], ["Era", 32.85], ["verdad.", 33.48], ["En", 34.28], ["Bletchley", 34.46], ["usaban", 34.87], ["esas", 35.3], ["frases", 35.46], ["repetidas", 35.82], ["como", 36.39], ["pistas.", 36.62], ["Lo", 37.62], ["que", 37.82], ["tú", 37.94], ["no", 38.12], ["viste,", 38.14], ["ella", 38.75], ["lo", 38.94], ["sabía", 39.1], ["por", 39.41], ["experiencia.", 39.57]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "chip": ["IQ", "∞", "NIVEL"]}, "planos": [{"v": "bletchley;S=enojado@0.62;X=normal@0.28", "f": "En la barraca hay una joven que no se impresiona. Se llama Sofía."}, {"v": "bletchley;S=enojado@0.5;cu;ui:3 DE CADA 4", "f": "Dato real: cerca de tres de cada cuatro personas que trabajaban en Bletchley eran mujeres."}, {"v": "bletchley;S=pensando@0.5;cu", "f": "Sofía lleva meses descifrando mensajes a mano. Y no le gusta que un recién llegado presuma."}, {"v": "bletchley;X=riendo@0.3;S=enojado@0.68", "f": "Te reta: —Si eres tan listo, descifra este. Es de un barco en el Atlántico."}, {"v": "bletchley;X=pensando@0.5;cu;th:no hay patrón…", "f": "Por primera vez, tu cerebro se traba. El mensaje es demasiado corto."}, {"v": "bletchley;S=riendo@0.5;cu", "f": "Sofía sonríe y te pasa un papel: —Los barcos siempre mandan el parte del clima a la misma hora. Empieza por ahí."}, {"v": "bletchley;X=sorprendido@0.5;cu;th:¡el clima! ¡claro!", "f": "Era verdad. En Bletchley usaban esas frases repetidas como pistas. Lo que tú no viste, ella lo sabía por experiencia."}]}, {"tipo": "planos", "titulo": "", "frames": 646, "words": [["Esa", 0.05], ["noche", 0.25], ["no", 0.46], ["duermes.", 0.75], ["Con", 1.87], ["tu", 2.0], ["cerebro", 2.21], ["podrías", 2.6], ["inventar", 3.0], ["armas,", 3.57], ["aviones,", 4.25], ["cosas", 5.16], ["que", 5.35], ["todavía", 5.57], ["no", 5.96], ["existen.", 6.1], ["Pero", 7.21], ["también", 7.48], ["sabes", 7.87], ["cómo", 8.12], ["termina", 8.41], ["la", 8.89], ["guerra.", 9.0], ["Y", 9.94], ["si", 10.1], ["cambias", 10.19], ["demasiado…", 10.6], ["la", 11.69], ["historia", 11.82], ["podría", 12.19], ["salir", 12.62], ["peor.", 12.91], ["Decides", 14.07], ["algo", 14.53], ["difícil.", 14.82], ["No", 15.87], ["vas", 15.98], ["a", 16.16], ["jugar", 16.3], ["a", 16.5], ["ser", 16.69], ["un", 16.91], ["superhéroe.", 17.05], ["Vas", 18.23], ["a", 18.35], ["ayudar", 18.53], ["en", 18.73], ["silencio,", 18.98], ["como", 19.94], ["todos", 20.16], ["los", 20.55], ["demás", 20.66], ["aquí.", 20.87]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "chip": ["IQ", "∞", "NIVEL"]}, "planos": [{"v": "noche;X=pensando@0.5", "f": "Esa noche no duermes. Con tu cerebro podrías inventar armas, aviones, cosas que todavía no existen."}, {"v": "noche;X=preocupado@0.5;cu;th:¿y si lo empeoro todo?", "f": "Pero también sabes cómo termina la guerra. Y si cambias demasiado… la historia podría salir peor."}, {"v": "noche;X=pensando@0.5;cu", "f": "Decides algo difícil: no vas a jugar a ser un superhéroe. Vas a ayudar en silencio, como todos los demás aquí."}]}, {"tipo": "planos", "titulo": "", "frames": 1029, "words": [["Una", 0.05], ["madrugada", 0.23], ["llega", 0.78], ["un", 1.03], ["mensaje", 1.25], ["urgente.", 1.71], ["Lo", 2.89], ["descifran", 3.07], ["juntos.", 3.55], ["tú", 4.62], ["los", 4.87], ["cálculos,", 5.05], ["Sofía", 5.91], ["las", 6.23], ["pistas.", 6.46], ["Submarinos", 7.37], ["esperando", 7.98], ["a", 8.35], ["un", 8.66], ["convoy", 8.82], ["de", 9.16], ["barcos", 9.3], ["con", 9.62], ["comida", 9.87], ["y", 10.23], ["medicinas", 10.46], ["en", 10.98], ["medio", 11.21], ["del", 11.44], ["Atlántico.", 11.64], ["La", 12.87], ["comandante", 13.0], ["pasa", 13.5], ["el", 13.85], ["aviso.", 14.05], ["Los", 15.1], ["barcos", 15.19], ["cambian", 15.53], ["de", 15.98], ["ruta", 16.14], ["en", 16.44], ["plena", 16.6], ["noche.", 16.89], ["Este", 17.78], ["tipo", 17.98], ["de", 18.32], ["información", 18.39], ["secreta,", 18.75], ["llamada", 19.89], ["Ultra,", 20.21], ["ayudó", 21.1], ["de", 21.46], ["verdad", 21.55], ["a", 21.82], ["desviar", 22.0], ["convoyes", 22.35], ["y", 23.0], ["salvar", 23.12], ["miles", 23.41], ["de", 23.91], ["vidas.", 24.14], ["Al", 25.07], ["amanecer", 25.32], ["llega", 25.78], ["la", 26.0], ["noticia.", 26.19], ["El", 27.14], ["convoy", 27.28], ["llegó", 27.71], ["a", 27.96], ["salvo.", 28.14], ["Sofía", 28.53], ["te", 29.44], ["abraza", 29.6], ["sin", 30.03], ["pensarlo.", 30.21], ["Luego", 31.37], ["se", 31.75], ["suelta,", 31.96], ["roja", 32.75], ["como", 33.21], ["un", 33.41], ["tomate.", 33.6]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "chip": ["IQ", "∞", "NIVEL"]}, "planos": [{"v": "bletchley;S=sorprendido@0.62;X=preocupado@0.28", "f": "Una madrugada llega un mensaje urgente. Lo descifran juntos: tú los cálculos, Sofía las pistas."}, {"v": "neutro;fx:mapa", "f": "Submarinos esperando a un convoy de barcos con comida y medicinas en medio del Atlántico."}, {"v": "bletchley;D=preocupado@0.5;cu", "f": "La comandante pasa el aviso. Los barcos cambian de ruta en plena noche."}, {"v": "neutro;fx:convoy", "f": "Este tipo de información secreta, llamada Ultra, ayudó de verdad a desviar convoyes y salvar miles de vidas."}, {"v": "bletchley;X=riendo@0.3;S=riendo@0.68;fx:brillo", "f": "Al amanecer llega la noticia: el convoy llegó a salvo. Sofía te abraza sin pensarlo. Luego se suelta, roja como un tomate."}]}, {"tipo": "planos", "titulo": "", "frames": 640, "words": [["Y", 0.05], ["entiendes", 0.16], ["algo", 0.64], ["que", 0.91], ["ningún", 1.12], ["IQ", 1.48], ["infinito", 1.8], ["te", 2.41], ["había", 2.57], ["enseñado.", 2.78], ["La", 3.89], ["guerra", 4.07], ["no", 4.3], ["la", 4.6], ["ganó", 4.73], ["un", 5.05], ["genio", 5.16], ["solo.", 5.5], ["La", 6.44], ["ganaron", 6.57], ["miles", 6.91], ["de", 7.25], ["personas", 7.48], ["comunes,", 7.8], ["trabajando", 8.6], ["juntas,", 9.21], ["en", 9.94], ["secreto,", 10.0], ["sin", 10.91], ["recibir", 11.03], ["ningún", 11.44], ["aplauso.", 11.87], ["Algunos", 13.19], ["historiadores", 13.66], ["calculan", 14.19], ["que", 14.82], ["descifrar", 14.94], ["Enigma", 15.37], ["acortó", 15.82], ["la", 16.32], ["guerra", 16.41], ["unos", 16.66], ["dos", 16.89], ["años.", 17.14], ["Es", 18.35], ["una", 18.5], ["estimación,", 18.66], ["pero", 19.73], ["son", 19.8], ["millones", 20.05], ["de", 20.41], ["vidas.", 20.64]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "chip": ["IQ", "∞", "NIVEL"]}, "planos": [{"v": "bletchley;X=sonrojado@0.5;cu", "f": "Y entiendes algo que ningún IQ infinito te había enseñado."}, {"v": "bletchley;T=riendo@0.3;S=riendo@0.55;D=riendo@0.8", "f": "La guerra no la ganó un genio solo. La ganaron miles de personas comunes, trabajando juntas, en secreto, sin recibir ningún aplauso."}, {"v": "neutro;ui:~2 AÑOS MENOS", "f": "Algunos historiadores calculan que descifrar Enigma acortó la guerra unos dos años. Es una estimación, pero son millones de vidas."}]}, {"tipo": "planos", "titulo": "", "frames": 925, "words": [["Una", 0.05], ["noche,", 0.19], ["mientras", 1.07], ["miras", 1.35], ["los", 1.78], ["reflectores", 1.91], ["en", 2.5], ["el", 2.71], ["cielo,", 2.85], ["todo", 3.73], ["se", 3.91], ["vuelve", 4.14], ["blanco.", 4.46], ["Despiertas", 5.64], ["en", 6.28], ["tu", 6.44], ["cuarto.", 6.57], ["Año", 7.8], ["dos", 8.12], ["mil", 8.25], ["veintiséis.", 8.48], ["Tu", 9.85], ["cerebro", 9.98], ["vuelve", 10.41], ["a", 10.78], ["ser", 10.85], ["normal.", 10.98], ["Meses", 12.35], ["después", 12.8], ["visitas", 13.12], ["el", 13.8], ["museo", 14.25], ["de", 14.69], ["Bletchley", 14.8], ["Park.", 15.23], ["Hay", 16.3], ["una", 16.46], ["foto", 16.62], ["de", 16.85], ["mil", 17.07], ["novecientos", 17.23], ["cuarenta", 17.91], ["y", 18.35], ["uno", 18.44], ["colgada", 18.6], ["en", 19.03], ["la", 19.16], ["pared.", 19.28], ["Un", 20.39], ["grupo", 20.6], ["de", 20.87], ["descifradores", 21.07], ["sonriendo.", 21.78], ["Una", 23.28], ["chica", 23.46], ["con", 23.8], ["una", 24.03], ["pinza", 24.19], ["de", 24.55], ["estrella.", 24.66], ["Y", 25.69], ["a", 25.91], ["su", 25.98], ["lado,", 26.1], ["un", 26.98], ["chico", 27.14], ["con", 27.46], ["una", 27.66], ["gorra", 27.82], ["muy", 28.16], ["rara.", 28.37], ["Esa", 29.44], ["gorra", 29.75], ["es", 30.03], ["la", 30.12], ["tuya.", 30.25]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "chip": null}, "planos": [{"v": "noche;X=pensando@0.5;fx:reflectores", "f": "Una noche, mientras miras los reflectores en el cielo, todo se vuelve blanco."}, {"v": "cuarto;X=sorprendido@0.5", "f": "Despiertas en tu cuarto. Año dos mil veintiséis. Tu cerebro vuelve a ser normal."}, {"v": "museo;X=normal@0.5", "f": "Meses después visitas el museo de Bletchley Park. Hay una foto de mil novecientos cuarenta y uno colgada en la pared."}, {"v": "museo;fx:foto", "f": "Un grupo de descifradores sonriendo. Una chica con una pinza de estrella. Y a su lado, un chico con una gorra muy rara."}, {"v": "museo;X=sorprendido@0.5;cu", "f": "Esa gorra es la tuya."}]}, {"tipo": "planos", "titulo": "", "frames": 358, "words": [["Ser", 0.05], ["el", 0.28], ["más", 0.46], ["inteligente", 0.69], ["no", 1.5], ["sirve", 1.75], ["de", 2.12], ["mucho", 2.21], ["si", 2.5], ["no", 2.8], ["sabes", 2.89], ["escuchar", 3.16], ["a", 3.66], ["los", 3.71], ["demás.", 3.87], ["Y", 4.89], ["tú,", 5.07], ["si", 5.75], ["tuvieras", 5.82], ["un", 6.25], ["IQ", 6.39], ["infinito,", 6.6], ["¿a", 7.57], ["qué", 7.66], ["época", 7.82], ["de", 8.07], ["la", 8.25], ["historia", 8.35], ["viajarías", 8.64], ["primero?", 9.25], ["Te", 10.35], ["leo", 10.46], ["en", 10.73], ["los", 10.82], ["comentarios.", 10.91]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "chip": null}, "planos": [{"v": "museo;X=sonrojado@0.5;cu", "f": "Ser el más inteligente no sirve de mucho si no sabes escuchar a los demás."}, {"v": "neutro;X=pensando@0.5;ui:¿A QUÉ ÉPOCA IRÍAS?", "f": "Y tú, si tuvieras un IQ infinito, ¿a qué época de la historia viajarías primero? Te leo en los comentarios."}]}]