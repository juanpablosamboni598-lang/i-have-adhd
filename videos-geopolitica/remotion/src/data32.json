 36.4], ["forma", 36.71], ["de", 37.02], ["valentía.", 37.34]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "chip": ["IQ", "∞", "NIVEL"]}, "planos": [{"v": "londres;X=preocupado@0.5", "f": "Las calles están llenas de sacos de arena. En el cielo flotan globos gigantes para estorbar a los aviones."}, {"v": "londres;M=preocupado@0.62;H=llorando@0.78;X=normal@0.25", "f": "La gente corre hacia el metro. Durante el Blitz, miles de londinenses dormían en las estaciones para protegerse."}, {"v": "londres;X=pensando@0.5;cu;th:refugio más cercano: 340 m", "f": "Tu cerebro calcula en un segundo la ruta más rápida al refugio."}, {"v": "londres;X=enojado@0.4;M=preocupado@0.7", "f": "Ves a una mamá con su hijo, perdidos. Los tomas de la mano y los guías entre el humo."}, {"v": "refugio;M=llorando@0.62;H=riendo@0.78;X=sonrojado@0.28", "f": "Llegan al andén justo a tiempo. La señora te da las gracias llorando."}, {"v": "refugio;H=riendo@0.5;cu", "f": "Bajo tierra, cientos de personas comparten mantas, té y canciones para no escuchar las explosiones de arriba."}, {"v": "refugio;X=pensando@0.5;cu;th:nadie aquí se rinde…", "f": "Nadie llora en voz alta. Los niños juegan a las cartas. Y tú piensas que eso también es una forma de valentía."}]}, {"tipo": "planos", "titulo": "", "frames": 549, "words": [["Pero", 0.15], ["un", 0.46], ["policía", 0.78], ["te", 1.09], ["mira", 1.4], ["raro.", 1.71], ["Gorra", 2.02], ["rara,", 2.34], ["sudadera", 2.65], ["rara,", 2.96], ["hablas", 3.27], ["raro.", 3.59], ["—Usted", 3.9], ["viene", 4.21], ["conmigo.", 4.53], ["Puede", 4.84], ["ser", 5.15], ["un", 5.46], ["espía.", 5.78], ["En", 6.09], ["la", 6.4], ["comisaría,", 6.71], ["para", 7.03], ["demostrar", 7.34], ["quién", 7.65], ["eres,", 7.96], ["resuelves", 8.28], ["en", 8.59], ["un", 8.9], ["minuto", 9.21], ["un", 9.53], ["problema", 9.84], ["de", 10.15], ["matemáticas", 10.46], ["que", 10.78], ["llevaba", 11.09], ["semanas", 11.4], ["en", 11.71], ["un", 12.03], ["periódico.", 12.34], ["El", 12.65], ["policía", 12.96], ["hace", 13.28], ["una", 13.59], ["llamada.", 13.9], ["Y", 14.21], ["esa", 14.53], ["misma", 14.84], ["noche,", 15.15], ["un", 15.46], ["auto", 15.78], ["negro", 16.09], ["te", 16.4], ["lleva", 16.71], ["fuera", 17.02], ["de", 17.34], ["Londres.", 17.65]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "chip": ["IQ", "∞", "NIVEL"]}, "planos": [{"v": "refugio;K=enojado@0.62;X=preocupado@0.28", "f": "Pero un policía te mira raro. Gorra rara, sudadera rara, hablas raro."}, {"v": "refugio;K=enojado@0.5;cu", "f": "—Usted viene conmigo. Puede ser un espía."}, {"v": "neutro;X=pensando@0.5;fx:ecuaciones", "f": "En la comisaría, para demostrar quién eres, resuelves en un minuto un problema de matemáticas que llevaba semanas en un periódico."}, {"v": "neutro;K=sorprendido@0.5;cu", "f": "El policía hace una llamada. Y esa misma noche, un auto negro te lleva fuera de Londres."}]}, {"tipo": "planos", "titulo": "", "frames": 802, "words": [["Te", 0.15], ["llevan", 0.46], ["a", 0.78], ["Bletchley", 1.09], ["Park,", 1.4], ["una", 1.71], ["mansión", 2.02], ["rodeada", 2.34], ["de", 2.65], ["barracas", 2.96], ["de", 3.27], ["madera.", 3.59], ["La", 3.9], ["comandante", 4.21], ["te", 4.53], ["explica", 4.84], ["en", 5.15], ["voz", 5.46], ["baja:", 5.78], ["aquí", 6.09], ["se", 6.4], ["intentan", 6.71], ["leer", 7.03], ["los", 7.34], ["mensajes", 7.65], ["secretos", 7.96], ["del", 8.28], ["enemigo.", 8.59], ["Esos", 8.9], ["mensajes", 9.21], ["se", 9.53], ["cifran", 9.84], ["con", 10.15], ["una", 10.46], ["máquina", 10.78], ["llamada", 11.09], ["Enigma.", 11.4], ["Cada", 11.71], ["letra", 12.03], ["que", 12.34], ["escribes", 12.65], ["se", 12.96], ["convierte", 13.28], ["en", 13.59], ["otra.", 13.9], ["Tiene", 14.21], ["unos", 14.53], ["ciento", 14.84], ["cincuenta", 15.15], ["y", 15.46], ["nueve", 15.78], ["trillones", 16.09], ["de", 16.4], ["trillones", 16.71], ["de", 17.02], ["combinaciones", 17.34], ["posibles.", 17.65], ["Y", 17.96], ["la", 18.27], ["clave", 18.59], ["cambia", 18.9], ["cada", 19.21], ["medianoche.", 19.52], ["Ahí", 19.84], ["conoces", 20.15], ["a", 20.46], ["Alan", 20.77], ["Turing,", 21.09], ["un", 21.4], ["matemático", 21.71], ["que", 22.02], ["en", 22.34], ["mil", 22.65], ["novecientos", 22.96], ["cuarenta", 23.27], ["construyó", 23.59], ["una", 23.9], ["máquina", 24.21], ["enorme", 24.52], ["para", 24.84], ["probar", 25.15], ["combinaciones:", 25.46], ["la", 25.77], ["Bomba.", 26.09]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "chip": ["IQ", "∞", "NIVEL"]}, "planos": [{"v": "bletchley;X=sorprendido@0.5", "f": "Te llevan a Bletchley Park, una mansión rodeada de barracas de madera."}, {"v": "bletchley;D=normal@0.62;X=normal@0.28;ui:ALTO SECRETO", "f": "La comandante te explica en voz baja: aquí se intentan leer los mensajes secretos del enemigo."}, {"v": "neutro;fx:enigma", "f": "Esos mensajes se cifran con una máquina llamada Enigma. Cada letra que escribes se convierte en otra."}, {"v": "neutro;fx:enigma;ui:159 TRILLONES DE TRILLONES", "f": "Tiene unos ciento cincuenta y nueve trillones de trillones de combinaciones posibles. Y la clave cambia cada medianoche."}, {"v": "bletchley;T=pensando@0.62;X=normal@0.28", "f": "Ahí conoces a Alan Turing, un matemático que en mil novecientos cuarenta construyó una máquina enorme para probar combinaciones: la Bomba."}]}, {"tipo": "planos", "titulo": "", "frames": 831, "words": [["Miras", 0.15], ["un", 0.46], ["mensaje", 0.78], ["cifrado", 1.09], ["y", 1.4], ["tu", 1.71], ["cerebro", 2.02], ["empieza", 2.34], ["a", 2.65], ["girar", 2.96], ["como", 3.27], ["mil", 3.59], ["Bombas", 3.9], ["al", 4.21], ["mismo", 4.53], ["tiempo.", 4.84], ["Encuentras", 5.15], ["patrones", 5.46], ["que", 5.78], ["nadie", 6.09], ["ve.", 6.4], ["Descartas", 6.71], ["millones", 7.03], ["de", 7.34], ["combinaciones", 7.65], ["por", 7.96], ["segundo.", 8.28], ["En", 8.59], ["diez", 8.9], ["minutos", 9.21], ["tienes", 9.53], ["la", 9.84], ["clave", 10.15], ["del", 10.46], ["día.", 10.78], ["Turing", 11.09], ["te", 11.4], ["mira,", 11.71], ["se", 12.03], ["quita", 12.34], ["los", 12.65], ["lentes", 12.96], ["y", 13.28], ["pregunta", 13.59], ["despacio:", 13.9], ["—¿Cómo", 14.21], ["lo", 14.53], ["hizo?", 14.84], ["No", 15.15], ["puedes", 15.46], ["decirle", 15.78], ["que", 16.09], ["vienes", 16.4], ["del", 16.71], ["futuro.", 17.02], ["Así", 17.34], ["que", 17.65], ["dices", 17.96], ["lo", 18.27], ["único", 18.59], ["que", 18.9], ["se", 19.21], ["te", 19.52], ["ocurre:", 19.84], ["—Intuición.", 20.15], ["Turing", 20.46], ["sonríe.", 20.77], ["Él", 21.09], ["también", 21.4], ["sabe", 21.71], ["lo", 22.02], ["que", 22.34], ["es", 22.65], ["pensar", 22.96], ["distinto", 23.27], ["a", 23.59], ["los", 23.9], ["demás.", 24.21], ["Desde", 24.52], ["ese", 24.84], ["día", 25.15], ["te", 25.46], ["deja", 25.77], ["sentarte", 26.09], ["a", 26.4], ["su", 26.71], ["lado.", 27.02]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "chip": ["IQ", "∞", "NIVEL"]}, "planos": [{"v": "bletchley;X=pensando@0.5;cu;th:las teclas nunca se cifran a sí mismas…", "f": "Miras un mensaje cifrado y tu cerebro empieza a girar como mil Bombas al mismo tiempo."}, {"v": "neutro;X=pensando@0.5;fx:ecuaciones", "f": "Encuentras patrones que nadie ve. Descartas millones de combinaciones por segundo."}, {"v": "bletchley;X=riendo@0.5;cu", "f": "En diez minutos tienes la clave del día."}, {"v": "bletchley;T=sorprendido@0.62;X=riendo@0.28", "f": "Turing te mira, se quita los lentes y pregunta despacio: —¿Cómo lo hizo?"}, {"v": "bletchley;X=sonrojado@0.5;cu", "f": "No puedes decirle que vienes del futuro. Así que dices lo único que se te ocurre: —Intuición."}, {"v": "bletchley;T=riendo@0.5;cu", "f": "Turing sonríe. Él también sabe lo que es pensar distinto a los demás. Desde ese día te deja sentarte a su lado."}]}, {"tipo": "planos", "titulo": "", "frames": 1074, "words": [["En", 0.15], ["la", 0.46], ["barraca", 0.78], ["hay", 1.09], ["una", 1.4], ["joven", 1.71], ["que", 2.02], ["no", 2.34], ["se", 2.65], ["impresiona.", 2.96], ["Se", 3.27], ["llama", 3.59], ["Sofía.", 3.9], ["Dato", 4.21], ["real:", 4.53], ["cerca", 4.84], ["de", 5.15], ["tres", 5.46], ["de", 5.78], ["cada", 6.09], ["cuatro", 6.4], ["personas", 6.71], ["que", 7.03], ["trabajaban", 7.34], ["en", 7.65], ["Bletchley", 7.96], ["eran", 8.28], ["mujeres.", 8.59], ["Sofía", 8.9], ["lleva", 9.21], ["meses", 9.53], ["descifrando", 9.84], ["mensajes", 10.15], ["a", 10.46], ["mano.", 10.78], ["Y", 11.09], ["no", 11.4], ["le", 11.71], ["gusta", 12.03], ["que", 12.34], ["un", 12.65], ["recién", 12.96], ["llegado", 13.28], ["presuma.", 13.59], ["Te", 13.9], ["reta:", 14.21], ["—Si", 14.53], ["eres", 14.84], ["tan", 15.15], ["listo,", 15.46], ["descifra", 15.78], ["este.", 16.09], ["Es", 16.4], ["de", 16.71], ["un", 17.02], ["barco", 17.34], ["en", 17.65], ["el", 17.96], ["Atlántico.", 18.27], ["Por", 18.59], ["primera", 18.9], ["vez,", 19.21], ["tu", 19.52], ["cerebro", 19.84], ["se", 20.15], ["traba.", 20.46], ["El", 20.77], ["mensaje", 21.09], ["es", 21.4], ["demasiado", 21.71], ["corto.", 22.02], ["Sofía", 22.34], ["sonríe", 22.65], ["y", 22.96], ["te", 23.27], ["pasa", 23.59], ["un", 23.9], ["papel:", 24.21], ["—Los", 24.52], ["barcos", 24.84], ["siempre", 25.15], ["mandan", 25.46], ["el", 25.77], ["parte", 26.09], ["del", 26.4], ["clima", 26.71], ["a", 27.02], ["la", 27.34], ["misma", 27.65], ["hora.", 27.96], ["Empieza", 28.27], ["por", 28.59], ["ahí.", 28.9], ["Era", 29.21], ["verdad.", 29.52], ["En", 29.84], ["Bletchley", 30.15], ["usaban", 30.46], ["esas", 30.77], ["frases", 31.09], ["repetidas", 31.4], ["como", 31.71], ["pistas.", 32.02], ["Lo", 32.34], ["que", 32.65], ["tú", 32.96], ["no", 33.27], ["viste,", 33.59], ["ella", 33.9], ["lo", 34.21], ["sabía", 34.52], ["por", 34.84], ["experiencia.", 35.15]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "chip": ["IQ", "∞", "NIVEL"]}, "planos": [{"v": "bletchley;S=enojado@0.62;X=normal@0.28", "f": "En la barraca hay una joven que no se impresiona. Se llama Sofía."}, {"v": "bletchley;S=enojado@0.5;cu;ui:3 DE CADA 4", "f": "Dato real: cerca de tres de cada cuatro personas que trabajaban en Bletchley eran mujeres."}, {"v": "bletchley;S=pensando@0.5;cu", "f": "Sofía lleva meses descifrando mensajes a mano. Y no le gusta que un recién llegado presuma."}, {"v": "bletchley;X=riendo@0.3;S=enojado@0.68", "f": "Te reta: —Si eres tan listo, descifra este. Es de un barco en el Atlántico."}, {"v": "bletchley;X=pensando@0.5;cu;th:no hay patrón…", "f": "Por primera vez, tu cerebro se traba. El mensaje es demasiado corto."}, {"v": "bletchley;S=riendo@0.5;cu", "f": "Sofía sonríe y te pasa un papel: —Los barcos siempre mandan el parte del clima a la misma hora. Empieza por ahí."}, {"v": "bletchley;X=sorprendido@0.5;cu;th:¡el clima! ¡claro!", "f": "Era verdad. En Bletchley usaban esas frases repetidas como pistas. Lo que tú no viste, ella lo sabía por experiencia."}]}, {"tipo": "planos", "titulo": "", "frames": 512, "words": [["Esa", 0.15], ["noche", 0.46], ["no", 0.78], ["duermes.", 1.09], ["Con", 1.4], ["tu", 1.71], ["cerebro", 2.02], ["podrías", 2.34], ["inventar", 2.65], ["armas,", 2.96], ["aviones,", 3.27], ["cosas", 3.59], ["que", 3.9], ["todavía", 4.21], ["no", 4.53], ["existen.", 4.84], ["Pero", 5.15], ["también", 5.46], ["sabes", 5.78], ["cómo", 6.09], ["termina", 6.4], ["la", 6.71], ["guerra.", 7.03], ["Y", 7.34], ["si", 7.65], ["cambias", 7.96], ["demasiado…", 8.28], ["la", 8.59], ["historia", 8.9], ["podría", 9.21], ["salir", 9.53], ["peor.", 9.84], ["Decides", 10.15], ["algo", 10.46], ["difícil:", 10.78], ["no", 11.09], ["vas", 11.4], ["a", 11.71], ["jugar", 12.03], ["a", 12.34], ["ser", 12.65], ["un", 12.96], ["superhéroe.", 13.28], ["Vas", 13.59], ["a", 13.9], ["ayudar", 14.21], ["en", 14.53], ["silencio,", 14.84], ["como", 15.15], ["todos", 15.46], ["los", 15.78], ["demás", 16.09], ["aquí.", 16.4]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "chip": ["IQ", "∞", "NIVEL"]}, "planos": [{"v": "noche;X=pensando@0.5", "f": "Esa noche no duermes. Con tu cerebro podrías inventar armas, aviones, cosas que todavía no existen."}, {"v": "noche;X=preocupado@0.5;cu;th:¿y si lo empeoro todo?", "f": "Pero también sabes cómo termina la guerra. Y si cambias demasiado… la historia podría salir peor."}, {"v": "noche;X=pensando@0.5;cu", "f": "Decides algo difícil: no vas a jugar a ser un superhéroe. Vas a ayudar en silencio, como todos los demás aquí."}]}, {"tipo": "planos", "titulo": "", "frames": 793, "words": [["Una", 0.15], ["madrugada", 0.46], ["llega", 0.78], ["un", 1.09], ["mensaje", 1.4], ["urgente.", 1.71], ["Lo", 2.02], ["descifran", 2.34], ["juntos:", 2.65], ["tú", 2.96], ["los", 3.27], ["cálculos,", 3.59], ["Sofía", 3.9], ["las", 4.21], ["pistas.", 4.53], ["Submarinos", 4.84], ["esperando", 5.15], ["a", 5.46], ["un", 5.78], ["convoy", 6.09], ["de", 6.4], ["barcos", 6.71], ["con", 7.03], ["comida", 7.34], ["y", 7.65], ["medicinas", 7.96], ["en", 8.28], ["medio", 8.59], ["del", 8.9], ["Atlántico.", 9.21], ["La", 9.53], ["comandante", 9.84], ["pasa", 10.15], ["el", 10.46], ["aviso.", 10.78], ["Los", 11.09], ["barcos", 11.4], ["cambian", 11.71], ["de", 12.03], ["ruta", 12.34], ["en", 12.65], ["plena", 12.96], ["noche.", 13.28], ["Este", 13.59], ["tipo", 13.9], ["de", 14.21], ["información", 14.53], ["secreta,", 14.84], ["llamada", 15.15], ["Ultra,", 15.46], ["ayudó", 15.78], ["de", 16.09], ["verdad", 16.4], ["a", 16.71], ["desviar", 17.02], ["convoyes", 17.34], ["y", 17.65], ["salvar", 17.96], ["miles", 18.27], ["de", 18.59], ["vidas.", 18.9], ["Al", 19.21], ["amanecer", 19.52], ["llega", 19.84], ["la", 20.15], ["noticia:", 20.46], ["el", 20.77], ["convoy", 21.09], ["llegó", 21.4], ["a", 21.71], ["salvo.", 22.02], ["Sofía", 22.34], ["te", 22.65], ["abraza", 22.96], ["sin", 23.27], ["pensarlo.", 23.59], ["Luego", 23.9], ["se", 24.21], ["suelta,", 24.52], ["roja", 24.84], ["como", 25.15], ["un", 25.46], ["tomate.", 25.77]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "chip": ["IQ", "∞", "NIVEL"]}, "planos": [{"v": "bletchley;S=sorprendido@0.62;X=preocupado@0.28", "f": "Una madrugada llega un mensaje urgente. Lo descifran juntos: tú los cálculos, Sofía las pistas."}, {"v": "neutro;fx:mapa", "f": "Submarinos esperando a un convoy de barcos con comida y medicinas en medio del Atlántico."}, {"v": "bletchley;D=preocupado@0.5;cu", "f": "La comandante pasa el aviso. Los barcos cambian de ruta en plena noche."}, {"v": "neutro;fx:convoy", "f": "Este tipo de información secreta, llamada Ultra, ayudó de verdad a desviar convoyes y salvar miles de vidas."}, {"v": "bletchley;X=riendo@0.3;S=riendo@0.68;fx:brillo", "f": "Al amanecer llega la noticia: el convoy llegó a salvo. Sofía te abraza sin pensarlo. Luego se suelta, roja como un tomate."}]}, {"tipo": "planos", "titulo": "", "frames": 502, "words": [["Y", 0.15], ["entiendes", 0.46], ["algo", 0.78], ["que", 1.09], ["ningún", 1.4], ["IQ", 1.71], ["infinito", 2.02], ["te", 2.34], ["había", 2.65], ["enseñado.", 2.96], ["La", 3.27], ["guerra", 3.59], ["no", 3.9], ["la", 4.21], ["ganó", 4.53], ["un", 4.84], ["genio", 5.15], ["solo.", 5.46], ["La", 5.78], ["ganaron", 6.09], ["miles", 6.4], ["de", 6.71], ["personas", 7.03], ["comunes,", 7.34], ["trabajando", 7.65], ["juntas,", 7.96], ["en", 8.28], ["secreto,", 8.59], ["sin", 8.9], ["recibir", 9.21], ["ningún", 9.53], ["aplauso.", 9.84], ["Algunos", 10.15], ["historiadores", 10.46], ["calculan", 10.78], ["que", 11.09], ["descifrar", 11.4], ["Enigma", 11.71], ["acortó", 12.03], ["la", 12.34], ["guerra", 12.65], ["unos", 12.96], ["dos", 13.28], ["años.", 13.59], ["Es", 13.9], ["una", 14.21], ["estimación,", 14.53], ["pero", 14.84], ["son", 15.15], ["millones", 15.46], ["de", 15.78], ["vidas.", 16.09]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "chip": ["IQ", "∞", "NIVEL"]}, "planos": [{"v": "bletchley;X=sonrojado@0.5;cu", "f": "Y entiendes algo que ningún IQ infinito te había enseñado."}, {"v": "bletchley;T=riendo@0.3;S=riendo@0.55;D=riendo@0.8", "f": "La guerra no la ganó un genio solo. La ganaron miles de personas comunes, trabajando juntas, en secreto, sin recibir ningún aplauso."}, {"v": "neutro;ui:~2 AÑOS MENOS", "f": "Algunos historiadores calculan que descifrar Enigma acortó la guerra unos dos años. Es una estimación, pero son millones de vidas."}]}, {"tipo": "planos", "titulo": "", "frames": 728, "words": [["Una", 0.15], ["noche,", 0.46], ["mientras", 0.78], ["miras", 1.09], ["los", 1.4], ["reflectores", 1.71], ["en", 2.02], ["el", 2.34], ["cielo,", 2.65], ["todo", 2.96], ["se", 3.27], ["vuelve", 3.59], ["blanco.", 3.9], ["Despiertas", 4.21], ["en", 4.53], ["tu", 4.84], ["cuarto.", 5.15], ["Año", 5.46], ["dos", 5.78], ["mil", 6.09], ["veintiséis.", 6.4], ["Tu", 6.71], ["cerebro", 7.03], ["vuelve", 7.34], ["a", 7.65], ["ser", 7.96], ["normal.", 8.28], ["Meses", 8.59], ["después", 8.9], ["visitas", 9.21], ["el", 9.53], ["museo", 9.84], ["de", 10.15], ["Bletchley", 10.46], ["Park.", 10.78], ["Hay", 11.09], ["una", 11.4], ["foto", 11.71], ["de", 12.03], ["mil", 12.34], ["novecientos", 12.65], ["cuarenta", 12.96], ["y", 13.28], ["uno", 13.59], ["colgada", 13.9], ["en", 14.21], ["la", 14.53], ["pared.", 14.84], ["Un", 15.15], ["grupo", 15.46], ["de", 15.78], ["descifradores", 16.09], ["sonriendo.", 16.4], ["Una", 16.71], ["chica", 17.02], ["con", 17.34], ["una", 17.65], ["pinza", 17.96], ["de", 18.27], ["estrella.", 18.59], ["Y", 18.9], ["a", 19.21], ["su", 19.52], ["lado,", 19.84], ["un", 20.15], ["chico", 20.46], ["con", 20.77], ["una", 21.09], ["gorra", 21.4], ["muy", 21.71], ["rara.", 22.02], ["Esa", 22.34], ["gorra", 22.65], ["es", 22.96], ["la", 23.27], ["tuya.", 23.59]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "chip": null}, "planos": [{"v": "noche;X=pensando@0.5;fx:reflectores", "f": "Una noche, mientras miras los reflectores en el cielo, todo se vuelve blanco."}, {"v": "cuarto;X=sorprendido@0.5", "f": "Despiertas en tu cuarto. Año dos mil veintiséis. Tu cerebro vuelve a ser normal."}, {"v": "museo;X=normal@0.5", "f": "Meses después visitas el museo de Bletchley Park. Hay una foto de mil novecientos cuarenta y uno colgada en la pared."}, {"v": "museo;fx:foto", "f": "Un grupo de descifradores sonriendo. Una chica con una pinza de estrella. Y a su lado, un chico con una gorra muy rara."}, {"v": "museo;X=sorprendido@0.5;cu", "f": "Esa gorra es la tuya."}]}, {"tipo": "planos", "titulo": "", "frames": 343, "words": [["Ser", 0.15], ["el", 0.46], ["más", 0.78], ["inteligente", 1.09], ["no", 1.4], ["sirve", 1.71], ["de", 2.02], ["mucho", 2.34], ["si", 2.65], ["no", 2.96], ["sabes", 3.27], ["escuchar", 3.59], ["a", 3.9], ["los", 4.21], ["demás.", 4.53], ["Y", 4.84], ["tú,", 5.15], ["si", 5.46], ["tuvieras", 5.78], ["un", 6.09], ["IQ", 6.4], ["infinito,", 6.71], ["¿a", 7.03], ["qué", 7.34], ["época", 7.65], ["de", 7.96], ["la", 8.28], ["historia", 8.59], ["viajarías", 8.9], ["primero?", 9.21], ["Te", 9.53], ["leo", 9.84], ["en", 10.15], ["los", 10.46], ["comentarios.", 10.78]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "chip": null}, "planos": [{"v": "museo;X=sonrojado@0.5;cu", "f": "Ser el más inteligente no sirve de mucho si no sabes escuchar a los demás."}, {"v": "neutro;X=pensando@0.5;ui:¿A QUÉ ÉPOCA IRÍAS?", "f": "Y tú, si tuvieras un IQ infinito, ¿a qué época de la historia viajarías primero? Te leo en los comentarios."}]}]