 "f": "Vale. Solo lo ves tú."}]}, {"tipo": "planos", "titulo": "", "frames": 502, "words": [["En", 0.15], ["la", 0.46], ["calle", 0.78], ["es", 1.09], ["todavía", 1.4], ["más", 1.71], ["raro.", 2.02], ["El", 2.34], ["señor", 2.65], ["del", 2.96], ["puesto", 3.27], ["de", 3.59], ["periódicos:", 3.9], ["setenta", 4.21], ["y", 4.53], ["uno.", 4.84], ["La", 5.15], ["vecina", 5.46], ["que", 5.78], ["siempre", 6.09], ["te", 6.4], ["saluda:", 6.71], ["ochenta.", 7.03], ["El", 7.34], ["chico", 7.65], ["que", 7.96], ["te", 8.28], ["empujó", 8.59], ["en", 8.9], ["tercer", 9.21], ["grado:", 9.53], ["tres.", 9.84], ["Te", 10.15], ["das", 10.46], ["cuenta", 10.78], ["de", 11.09], ["que", 11.4], ["este", 11.71], ["poder", 12.03], ["es", 12.34], ["peligroso.", 12.65], ["Porque", 12.96], ["ahora", 13.28], ["vas", 13.59], ["a", 13.9], ["saber", 14.21], ["la", 14.53], ["verdad", 14.84], ["sobre", 15.15], ["todo", 15.46], ["el", 15.78], ["mundo.", 16.09]], "caps": [], "p": {"esc": null, "med": null, "flash": false}, "planos": [{"v": "calle;K=riendo@0.6;X=normal@0.25;n:K=71", "f": "En la calle es todavía más raro. El señor del puesto de periódicos: setenta y uno."}, {"v": "calle;M=riendo@0.55!saluda;n:M=80", "f": "La vecina que siempre te saluda: ochenta."}, {"v": "calle;MT=enojado@0.6;X=preocupado@0.25;n:MT=3", "f": "El chico que te empujó en tercer grado: tres."}, {"v": "calle;X=pensando@0.5;cu", "f": "Te das cuenta de que este poder es peligroso."}, {"v": "calle;X=preocupado@0.5", "f": "Porque ahora vas a saber la verdad sobre todo el mundo."}]}, {"tipo": "planos", "titulo": "", "frames": 746, "words": [["En", 0.15], ["la", 0.46], ["entrada", 0.78], ["del", 1.09], ["colegio", 1.4], ["es", 1.71], ["un", 2.02], ["festival", 2.34], ["de", 2.65], ["números.", 2.96], ["La", 3.27], ["pareja", 3.59], ["que", 3.9], ["se", 4.21], ["besa", 4.53], ["en", 4.84], ["las", 5.15], ["escaleras:", 5.46], ["él,", 5.78], ["noventa", 6.09], ["y", 6.4], ["nueve;", 6.71], ["ella,", 7.03], ["cincuenta", 7.