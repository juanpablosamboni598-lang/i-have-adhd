;cu", "f": "Vale. Solo lo ves tú."}]}, {"tipo": "planos", "titulo": "", "frames": 562, "words": [["En", 0.05], ["la", 0.14], ["calle", 0.25], ["es", 0.48], ["todavía", 0.69], ["más", 1.03], ["raro.", 1.23], ["El", 2.28], ["señor", 2.39], ["del", 2.64], ["puesto", 2.85], ["de", 3.14], ["periódicos,", 3.37], ["setenta", 4.37], ["y", 4.87], ["uno.", 5.0], ["La", 5.91], ["vecina", 6.1], ["que", 6.46], ["siempre", 6.62], ["te", 6.94], ["saluda,", 7.14], ["ochenta.", 8.1], ["El", 9.16], ["chico", 9.32], ["que", 9.6], ["te", 9.73], ["empujó", 9.85], ["en", 10.28], ["tercer", 10.35], ["grado.", 10.69], ["Tres.", 11.91], ["Te", 12.8], ["das", 12.94], ["cuenta", 13.1], ["de", 13.39], ["que", 13.62], ["este", 13.71], ["poder", 13.94], ["es", 14.21], ["peligroso.", 14.41], ["Porque", 15.57], ["ahora", 15.87], ["vas", 16.12], ["a", 16.35], ["saber", 16.48], ["la", 16.75], ["verdad", 16.91], ["sobre", 17.21], ["todo", 17.55], ["el", 17.89], ["mundo.", 18.12]], "caps": [], "p": {"esc": null, "med": null, "flash": false}, "planos": [{"v": "calle;K=riendo@0.6;X=normal@0.25;n:K=71", "f": "En la calle es todavía más raro. El señor del puesto de periódicos: setenta y uno."}, {"v": "calle;M=riendo@0.55!saluda;n:M=80", "f": "La vecina que siempre te saluda: ochenta."}, {"v": "calle;MT=enojado@0.6;X=preocupado@0.25;n:MT=3", "f": "El chico que te empujó en tercer grado: tres."}, {"v": "calle;X=pensando@0.5;cu", "f": "Te das cuenta de que este poder es peligroso."}, {"v": "calle;X=preocupado@0.5", "f": "Porque ahora vas a saber la verdad sobre todo el mundo."}]}, {"tipo": "planos", "titulo": "", "frames": 840, "words": [["En", 0.05], ["la", 0.16], ["entrada", 0.25], ["del", 0.5], ["colegio", 0.73], ["es", 1.16], ["un", 1.28], ["festival", 1.39], ["de", 1.75], ["números.", 1.94], ["La", 2.94], ["pareja", 3.12], ["que", 3.48], ["se", 3.64], ["besa", 3.8], ["en", 4.1], ["las", 4.16], ["escaleras.", 4.28], ["Él,", 5.48], ["noventa", 6.14], ["y", 6.57], ["nueve.", 6.64], ["Ella,", 7.48], ["cincu