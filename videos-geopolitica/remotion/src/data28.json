["un", 12.96], ["segundo,", 13.28], ["juras", 13.59], ["que", 13.9], ["viste", 14.21], ["un", 14.53], ["número", 14.84], ["asomarse", 15.15], ["antes", 15.46], ["de", 15.78], ["esconderse", 16.09], ["otra", 16.4], ["vez.", 16.71]], "caps": [], "p": {"esc": null, "med": null, "flash": false}, "planos": [{"v": "salon;X=sonrojado@0.5;fx:poema;ui:PRUEBA 4", "f": "Prueba cuatro, la desesperada: le escribes un poema en una servilleta."}, {"v": "neutro;fx:poema", "f": "Rimas \"Sofía\" con \"todavía\", \"alegría\" y, sin saber por qué, \"lavandería\"."}, {"v": "salon;S=sonrojado@0.5;cu", "f": "Ella lo lee. Lo dobla con cuidado. Y lo guarda dentro de su cuaderno."}, {"v": "salon;S=sonrojado@0.5;n:S=?!;cu", "f": "Interrogación. Pero esta vez, por un segundo, juras que viste un número asomarse antes de esconderse otra vez."}]}, {"tipo": "planos", "titulo": "", "frames": 456, "words": [["En", 0.15], ["el", 0.46], ["almuerzo", 0.78], ["se", 1.09], ["sienta", 1.4], ["a", 1.71], ["tu", 2.02], ["lado", 2.34], ["Camila,", 2.65], ["tu", 2.96], ["amiga", 3.27], ["desde", 3.59], ["el", 3.9], ["kínder.", 4.21], ["La", 4.53], ["que", 4.84], ["te", 5.15], ["presta", 5.46], ["los", 5.78], ["apuntes.", 6.09], ["La", 6.4], ["que", 6.71], ["se", 7.03], ["acuerda", 7.34], ["de", 7.65], ["tu", 7.96], ["cumpleaños", 8.28], ["antes", 8.59], ["que", 8.9], ["tú.", 9.21], ["Miras", 9.53], ["sobre", 9.84], ["su", 10.15], ["cabeza", 10.46], ["por", 10.78], ["pura", 11.09], ["costumbre.", 11.4], ["Noventa", 11.71], ["y", 12.03], ["cinco", 12.34], ["por", 12.65], ["ciento.", 12.96], ["Te", 13.28], ["atragantas", 13.59], ["con", 13.9], ["el", 14.21], ["jugo.", 14.53]], "caps": [], "p": {"esc": null, "med": null, "flash": false}, "planos": [{"v": "comedor;C=riendo@0.62;X=normal@0.3", "f": "En el almuerzo se sienta a tu lado Camila, tu amiga desde el kínder."}, {"v": "comedor;C=riendo@0.5;cu", "f": "La que te presta los apuntes. La que se acuerda de tu cumpleaños antes que tú."}, {"v": "comedor;C=normal@0.5;n:C=?", "f": "Miras sobre su cabeza por pura costumbre."}, {"v": "comedor;C=normal@0.5;n:C=95;cu", "f": "Noventa y cinco por ciento."}, {"v": "comedor;X=sorprendido@0.5;cu", "f": "Te atragantas con el jugo."}]}, {"tipo": "planos", "titulo": "", "frames": 399, "words": [["¿Noventa", 0.15], ["y", 0.46], ["cinco?", 0.78], ["¿Camila?", 1.09], ["Ella", 1.4], ["sigue", 1.71], ["hablando", 2.02], ["de", 2.34], ["un", 2.65], ["videojuego", 2.96], ["como", 3.27], ["si", 3.59], ["nada.", 3.9], ["Y", 4.21], ["de", 4.53], ["repente", 4.84], ["lo", 5.15], ["entiendes:", 5.46], ["esta", 5.78], ["persona", 6.09], ["lleva", 6.4], ["años", 6.71], ["queriéndote…", 7.03], ["y", 7.34], ["nunca", 7.65], ["te", 7.96], ["diste", 8.28], ["cuenta.", 8.59], ["Ahora", 8.9], ["tienes", 9.21], ["un", 9.53], ["problema", 9.84], ["mucho", 10.15], ["más", 10.46], ["grande", 10.78], ["que", 11.09], ["un", 11.4], ["número", 11.71], ["que", 12.03], ["no", 12.34], ["aparece.", 12.65]], "caps": [], "p": {"esc": null, "med": null, "flash": false}, "planos": [{"v": "comedor;X=sorprendido@0.3;C=riendo@0.68;n:C=95", "f": "¿Noventa y cinco? ¿Camila? Ella sigue hablando de un videojuego como si nada."}, {"v": "comedor;X=pensando@0.5;cu", "f": "Y de repente lo entiendes: esta persona lleva años queriéndote… y nunca te diste cuenta."}, {"v": "comedor;X=preocupado@0.5", "f": "Ahora tienes un problema mucho más grande que un número que no aparece."}]}, {"tipo": "planos", "titulo": "", "frames": 512, "words": [["Esa", 0.15], ["noche", 0.46], ["no", 0.78], ["duermes.", 1.09], ["Miras", 1.4], ["al", 1.71], ["techo.", 2.02], ["Por", 2.34], ["un", 2.65], ["lado", 2.96], ["está", 3.27], ["Sofía,", 3.59], ["con", 3.9], ["su", 4.21], ["misterio.", 4.53], ["Por", 4.84], ["el", 5.15], ["otro", 5.46], ["está", 5.78], ["Camila,", 6.09], ["que", 6.4], ["te", 6.71], ["quiere", 7.03], ["de", 7.34], ["verdad.", 7.65], ["Y", 7.96], ["entiendes", 8.28], ["algo", 8.59], ["incómodo:", 8.9], ["has", 9.21], ["pasado", 9.53], ["todo", 9.84], ["el", 10.15], ["día", 10.46], ["tratando", 10.78], ["de", 11.09], ["cambiar", 11.4], ["lo", 11.71], ["que", 12.03], ["otros", 12.34], ["sienten", 12.65], ["por", 12.96], ["ti…", 13.28], ["en", 13.59], ["vez", 13.9], ["de", 14.21], ["ser", 14.53], ["honesto", 14.84], ["con", 15.15], ["lo", 15.46], ["que", 15.78], ["sientes", 16.09], ["tú.", 16.4]], "caps": [], "p": {"esc": null, "med": null, "flash": false}, "planos": [{"v": "noche;X=pensando@0.5", "f": "Esa noche no duermes. Miras al techo."}, {"v": "neutro;S=normal@0.3;C=riendo@0.7;n:S=?;n:C=95", "f": "Por un lado está Sofía, con su misterio. Por el otro está Camila, que te quiere de verdad."}, {"v": "noche;X=preocupado@0.5;cu", "f": "Y entiendes algo incómodo: has pasado todo el día tratando de cambiar lo que otros sienten por ti…"}, {"v": "noche;X=pensando@0.5;cu", "f": "en vez de ser honesto con lo que sientes tú."}]}, {"tipo": "planos", "titulo": "", "frames": 549, "words": [["Abres", 0.15], ["el", 0.46], ["chat", 0.78], ["de", 1.09], ["Sofía", 1.4], ["y", 1.71], ["escribes", 2.02], ["\"hola\".", 2.34], ["Lo", 2.65], ["borras.", 2.96], ["Escribes", 3.27], ["\"¿estás", 3.59], ["despierta?\".", 3.9], ["Lo", 4.21], ["borras.", 4.53], ["Escribes", 4.84], ["un", 5.15], ["párrafo", 5.46], ["entero.", 5.78], ["Lo", 6.09], ["borras", 6.4], ["también.", 6.71], ["A", 7.03], ["las", 7.34], ["tres", 7.65], ["de", 7.96], ["la", 8.28], ["mañana", 8.59], ["te", 8.9], ["llega", 9.21], ["un", 9.53], ["mensaje.", 9.84], ["Es", 10.15], ["de", 10.46], ["ella:", 10.78], ["\"¿Mañana", 11.09], ["me", 11.4], ["ayudas", 11.71], ["con", 12.03], ["el", 12.34], ["trabajo", 12.65], ["de", 12.96], ["ciencias?", 13.28], ["Tú", 13.59], ["explicas", 13.9], ["bonito\".", 14.21], ["Lees", 14.53], ["\"explicas", 14.84], ["bonito\"", 15.15], ["catorce", 15.46], ["veces.", 15.78], ["Decides", 16.09], ["hacer", 16.4], ["dos", 16.71], ["cosas", 17.02], ["difíciles", 17.34], ["mañana.", 17.65]], "caps": [], "p": {"esc": null, "med": null, "flash": false}, "planos": [{"v": "noche;X=pensando@0.5;fx:chat", "f": "Abres el chat de Sofía y escribes \"hola\". Lo borras."}, {"v": "neutro;fx:chat", "f": "Escribes \"¿estás despierta?\". Lo borras. Escribes un párrafo entero. Lo borras también."}, {"v": "noche;X=sorprendido@0.5;fx:chat", "f": "A las tres de la mañana te llega un mensaje. Es de ella:"}, {"v": "neutro;fx:chat", "f": "\"¿Mañana me ayudas con el trabajo de ciencias? Tú explicas bonito\"."}, {"v": "noche;X=sonrojado@0.5;cu", "f": "Lees \"explicas bonito\" catorce veces."}, {"v": "noche;X=normal@0.5", "f": "Decides hacer dos cosas difíciles mañana."}]}, {"tipo": "planos", "titulo": "", "frames": 709, "words": [["Primero", 0.15], ["hablas", 0.46], ["con", 0.78], ["Camila.", 1.09], ["Le", 1.4], ["dices", 1.71], ["la", 2.02], ["verdad,", 2.34], ["con", 2.65], ["cuidado:", 2.96], ["que", 3.27], ["es", 3.59], ["tu", 3.9], ["mejor", 4.21], ["amiga,", 4.53], ["que", 4.84], ["es", 5.15], ["increíble,", 5.46], ["y", 5.78], ["que", 6.09], ["tu", 6.4], ["corazón", 6.71], ["está", 7.03], ["con", 7.34], ["otra", 7.65], ["persona.", 7.96], ["Ella", 8.28], ["baja", 8.59], ["la", 8.9], ["mirada.", 9.21], ["El", 9.53], ["número", 9.84], ["no", 10.15], ["baja.", 10.46], ["Sigue", 10.78], ["en", 11.09], ["noventa", 11.4], ["y", 11.71], ["cinco.", 12.03], ["—Ya", 12.34], ["lo", 12.65], ["sabía,", 12.96], ["tonto", 13.28], ["—dice", 13.59], ["sonriendo—.", 13.9], ["Se", 14.21], ["te", 14.53], ["nota", 14.84], ["desde", 15.15], ["lejos.", 15.46], ["Ve", 15.78], ["a", 16.09], ["hablarle.", 16.4], ["Y", 16.71], ["ahí", 17.02], ["entiendes", 17.34], ["que", 17.65], ["querer", 17.96], ["a", 18.27], ["alguien", 18.59], ["no", 18.9], ["siempre", 19.21], ["significa", 19.52], ["tenerlo.", 19.84], ["A", 20.15], ["veces", 20.46], ["significa", 20.77], ["empujarlo", 21.09], ["hacia", 21.4], ["lo", 21.71], ["que", 22.02], ["lo", 22.34], ["hace", 22.65], ["feliz.", 22.96]], "caps": [], "p": {"esc": null, "med": null, "flash": false}, "planos": [{"v": "patio;X=normal@0.3;C=normal@0.68", "f": "Primero hablas con Camila."}, {"v": "patio;X=preocupado@0.5;cu", "f": "Le dices la verdad, con cuidado: que es tu mejor amiga, que es increíble,"}, {"v": "patio;X=sonrojado@0.5;cu", "f": "y que tu corazón está con otra persona."}, {"v": "patio;C=llorando@0.5;n:C=95;cu", "f": "Ella baja la mirada. El número no baja. Sigue en noventa y cinco."}, {"v": "patio;C=riendo@0.5;cu", "f": "—Ya lo sabía, tonto —dice sonriendo—. Se te nota desde lejos. Ve a hablarle."}, {"v": "patio;X=pensando@0.3;C=riendo@0.68", "f": "Y ahí entiendes que querer a alguien no siempre significa tenerlo."}, {"v": "patio;C=riendo@0.5!saluda", "f": "A veces significa empujarlo hacia lo que lo hace feliz."}]}, {"tipo": "planos", "titulo": "", "frames": 531, "words": [["Encuentras", 0.15], ["a", 0.46], ["Sofía", 0.78], ["en", 1.09], ["la", 1.4], ["biblioteca.", 1.71], ["Esta", 2.02], ["vez", 2.34], ["no", 2.65], ["haces", 2.96], ["trucos.", 3.27], ["Te", 3.59], ["sientas", 3.9], ["y", 4.21], ["le", 4.53], ["dices:", 4.84], ["—Me", 5.15], ["gustas.", 5.46], ["Desde", 5.78], ["hace", 6.09], ["meses.", 6.4], ["Y", 6.71], ["no", 7.03], ["sé", 7.34], ["si", 7.65], ["yo", 7.96], ["te", 8.28], ["gusto,", 8.59], ["pero", 8.9], ["quería", 9.21], ["que", 9.53], ["lo", 9.84], ["supieras.", 10.15], ["Silencio.", 10.46], ["Ella", 10.78], ["cierra", 11.09], ["el", 11.4], ["cuaderno.", 11.71], ["Te", 12.03], ["lo", 12.34], ["pasa.", 12.65], ["Está", 12.96], ["lleno", 13.28], ["de", 13.59], ["dibujos", 13.9], ["tuyos:", 14.21], ["en", 14.53], ["clase,", 14.84], ["en", 15.15], ["el", 15.46], ["pasillo,", 15.78], ["cayéndote", 16.09], ["por", 16.4], ["la", 16.71], ["puerta.", 17.02]], "caps": [], "p": {"esc": null, "med": null, "flash": false}, "planos": [{"v": "biblio;S=normal@0.65;X=normal@0.28", "f": "Encuentras a Sofía en la biblioteca. Esta vez no haces trucos."}, {"v": "biblio;X=sonrojado@0.5;cu", "f": "Te sientas y le dices: —Me gustas. Desde hace meses."}, {"v": "biblio;X=preocupado@0.5;cu", "f": "Y no sé si yo te gusto, pero quería que lo supieras."}, {"v": "biblio;S=sonrojado@0.5;cu", "f": "Silencio. Ella cierra el cuaderno. Te lo pasa."}, {"v": "neutro;fx:dibujos", "f": "Está lleno de dibujos tuyos: en clase, en el pasillo, cayéndote por la puerta."}]}, {"tipo": "planos", "titulo": "", "frames": 559, "words": [["—Mi", 0.15], ["número", 0.46], ["no", 0.78], ["te", 1.09], ["salía,", 1.4], ["¿verdad?", 1.71], ["—pregunta", 2.02], ["ella.", 2.34], ["Te", 2.65], ["quedas", 2.96], ["helado.", 3.27], ["—Es", 3.59], ["que", 3.9], ["yo", 4.21], ["tampoco", 4.53], ["sabía", 4.84], ["qué", 5.15], ["sentía", 5.46], ["—dice—.", 5.78], ["Hasta", 6.09], ["hoy.", 6.4], ["Miras", 6.71], ["sobre", 7.03], ["su", 7.34], ["cabeza.", 7.65], ["Los", 7.96], ["signos", 8.28], ["de", 8.59], ["interrogación", 8.9], ["tiemblan…", 9.21], ["y", 9.53], ["se", 9.84], ["convierten", 10.15], ["en", 10.46], ["un", 10.78], ["número.", 11.09], ["Pero", 11.4], ["antes", 11.71], ["de", 12.03], ["que", 12.34], ["puedas", 12.65], ["leerlo,", 12.96], ["ella", 13.28], ["te", 13.59], ["tapa", 13.9], ["los", 14.21], ["ojos", 14.53], ["con", 14.84], ["las", 15.15], ["manos.", 15.46], ["—Algunas", 15.78], ["cosas", 16.09], ["—dice—", 16.4], ["es", 16.71], ["mejor", 17.02], ["descubrirlas", 17.34], ["sin", 17.65], ["poderes.", 17.96]], "caps": [], "p": {"esc": null, "med": null, "flash": false}, "planos": [{"v": "biblio;S=pensando@0.5;n:S=?;cu", "f": "—Mi número no te salía, ¿verdad? —pregunta ella."}, {"v": "biblio;X=sorprendido@0.5;cu", "f": "Te quedas helado."}, {"v": "biblio;S=sonrojado@0.5;cu", "f": "—Es que yo tampoco sabía qué sentía —dice—. Hasta hoy."}, {"v": "biblio;S=sonrojado@0.5;n:S=glitch;cu", "f": "Miras sobre su cabeza. Los signos de interrogación tiemblan… y se convierten en un número."}, {"v": "biblio;S=riendo@0.62!saluda;X=sorprendido@0.3", "f": "Pero antes de que puedas leerlo, ella te tapa los ojos con las manos."}, {"v": "biblio;S=riendo@0.5;cu", "f": "—Algunas cosas —dice— es mejor descubrirlas sin poderes."}]}, {"tipo": "planos", "titulo": "", "frames": 549, "words": [["A", 0.15], ["la", 0.46], ["mañana", 0.78], ["siguiente", 1.09], ["te", 1.4], ["despiertas.", 1.71], ["Los", 2.02], ["números", 2.34], ["ya", 2.65], ["no", 2.96], ["están.", 3.27], ["El", 3.59], ["poder", 3.9], ["desapareció.", 4.21], ["Pero", 4.53], ["no", 4.84], ["lo", 5.15], ["necesitas.", 5.46], ["Porque", 5.78], ["ahora", 6.09], ["sabes", 6.4], ["que", 6.71], ["lo", 7.03], ["importante", 7.34], ["no", 7.65], ["es", 7.96], ["cuánto", 8.28], ["te", 8.59], ["quieren", 8.9], ["los", 9.21], ["demás…", 9.53], ["sino", 9.84], ["tener", 10.15], ["el", 10.46], ["valor", 10.78], ["de", 11.09], ["decir", 11.4], ["lo", 11.71], ["que", 12.03], ["sientes.", 12.34], ["Y", 12.65], ["tú,", 12.96], ["si", 13.28], ["pudieras", 13.59], ["ver", 13.9], ["ese", 14.21], ["número,", 14.53], ["¿de", 14.84], ["quién", 15.15], ["lo", 15.46], ["mirarías", 15.78], ["primero?", 16.09], ["Te", 16.4], ["leo", 16.71], ["en", 17.02], ["los", 17.34], ["comentarios.", 17.65]], "caps": [], "p": {"esc": null, "med": null, "flash": false}, "planos": [{"v": "cuarto;X=normal@0.5", "f": "A la mañana siguiente te despiertas. Los números ya no están. El poder desapareció."}, {"v": "calle;X=riendo@0.5", "f": "Pero no lo necesitas."}, {"v": "patio;X=riendo@0.32;S=riendo@0.68;fx:brillo", "f": "Porque ahora sabes que lo importante no es cuánto te quieren los demás…"}, {"v": "patio;X=sonrojado@0.5;cu", "f": "sino tener el valor de decir lo que sientes."}, {"v": "neutro;X=pensando@0.5;ui:¿DE QUIÉN LO MIRARÍAS?", "f": "Y tú, si pudieras ver ese número, ¿de quién lo mirarías primero? Te leo en los comentarios."}]}]