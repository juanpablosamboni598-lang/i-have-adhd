], ["en", 4.64], ["su", 4.78], ["cuaderno.", 4.89], ["Pinza", 6.03], ["de", 6.39], ["estrella.", 6.53], ["Cárdigan", 7.53], ["lila.", 8.03], ["Respiras.", 9.0], ["Miras", 10.0], ["encima", 10.44], ["de", 10.73], ["su", 10.91], ["cabeza.", 11.03], ["Y", 12.05], ["el", 12.16], ["número…", 12.3], ["no", 13.21], ["se", 13.35], ["ve.", 13.5], ["En", 14.37], ["vez", 14.6], ["de", 14.71], ["un", 14.85], ["porcentaje", 14.94], ["hay", 15.66], ["unos", 15.85], ["signos", 16.03], ["de", 16.48], ["interrogación", 16.55], ["que", 17.21], ["parpadean.", 17.37], ["Como", 18.55], ["si", 18.78], ["el", 18.96], ["sistema", 19.07], ["se", 19.46], ["hubiera", 19.64], ["trabado.", 19.87]], "caps": [], "p": {"esc": null, "med": null, "flash": false}, "planos": [{"v": "salon;S=normal@0.6;X=sonrojado@0.22", "f": "Llegas al salón. Ella está junto a la ventana, como siempre, dibujando en su cuaderno."}, {"v": "salon;S=sonrojado@0.5;cu", "f": "Pinza de estrella. Cárdigan lila."}, {"v": "salon;X=normal@0.5;cu", "f": "Respiras. Miras encima de su cabeza."}, {"v": "salon;S=normal@0.5;n:S=?;cu", "f": "Y el número… no se ve."}, {"v": "salon;S=normal@0.5;n:S=?", "f": "En vez de un porcentaje hay unos signos de interrogación que parpadean."}, {"v": "salon;X=sorprendido@0.5;cu", "f": "Como si el sistema se hubiera trabado."}]}, {"tipo": "planos", "titulo": "", "frames": 514, "words": [["Te", 0.05], ["frotas", 0.14], ["los", 0.53], ["ojos.", 0.69], ["Miras", 1.85], ["a", 2.46], ["tu", 2.55], ["profesor.", 2.66], ["Doce", 4.03], ["por", 4.55], ["ciento.", 4.8], ["¿Qué", 5.85], ["novedad?", 5.91], ["Miras", 7.07], ["otra", 7.53], ["vez", 7.69], ["a", 7.91], ["Sofía.", 8.03], ["Interrogación.", 9.12], ["Interrogación.", 10.62], ["¿Qué", 12.28], ["significa", 12.55], ["eso?", 13.05], ["¿Que", 14.1], ["no", 14.21], ["le", 14.35], ["importas?", 14.44], ["¿Que", 15.53], ["el", 15.75], ["poder", 15.87], ["está", 16.16], ["roto?", 16.44]], "caps": [], "p": {"esc": null, "med": null, "flash": false}, "planos": [{"v": "salon;T=enojado@0.6;X=pensando@0.25;n:T=12", "f": "Te frotas los ojos. Miras a tu profesor: doce por ciento, qué novedad."}, {"v": "salon;S=normal@0.5;n:S=?;cu", "f": "Miras otra vez a Sofía. Interrogación. Interrogación. Interrogación."}, {"v": "salon;X=preocupado@0.5;cu", "f": "¿Qué significa eso? ¿Que no le importas?"}, {"v": "salon;X=pensando@0.5", "f": "¿Que el poder está roto?"}]}, {"tipo": "planos", "titulo": "", "frames": 579, "words": [["Decides", 0.05], ["investigar", 0.46], ["como", 1.14], ["un", 1.32], ["científico.", 1.53], ["Si", 2.8], ["el", 3.12], ["número", 3.23], ["cambia", 3.44], ["según", 3.91], ["lo", 4.12], ["que", 4.32], ["hace", 4.44], ["la", 4.62], ["gente,", 4.75], ["tal", 5.53], ["vez", 5.75], ["puedas", 5.96], ["hacerlo", 6.39], ["aparecer.", 6.71], ["Prueba", 7.85], ["uno.", 8.19], ["Le", 8.98], ["prestas", 9.05], ["un", 9.48], ["lápiz.", 9.62], ["Interrogación.", 10.5], ["Prueba", 11.71], ["dos.", 12.03], ["Le", 12.69], ["cuentas", 12.75], ["tu", 13.16], ["mejor", 13.28], ["chiste.", 13.48], ["Ella", 14.6], ["se", 14.78], ["ríe", 14.98], ["un", 15.23], ["poquito.", 15.37], ["El", 16.19], ["símbolo", 16.35], ["parpadea", 16.8], ["más", 17.28], ["rápido…", 17.46], ["pero", 18.3], ["no", 18.5], ["cambia.", 18.66]], "caps": [], "p": {"esc": null, "med": null, "flash": false}, "planos": [{"v": "salon;X=pensando@0.5;ui:EXPERIMENTO", "f": "Decides investigar como un científico."}, {"v": "salon;X=normal@0.5;ui:HIPÓTESIS", "f": "Si el número cambia según lo que hace la gente, tal vez puedas hacerlo aparecer."}, {"v": "salon;X=sonrojado@0.3;S=sorprendido@0.68;n:S=?;ui:PRUEBA 1", "f": "Prueba uno: le prestas un lápiz. Interrogación."}, {"v": "salon;X=riendo@0.3;S=riendo@0.68;n:S=?;ui:PRUEBA 2", "f": "Prueba dos: le cuentas tu mejor chiste. Ella se ríe un poquito."}, {"v": "salon;S=riendo@0.5;n:S=?;cu", "f": "El símbolo parpadea más rápido… pero no cambia."}]}, {"tipo": "planos", "titulo": "", "frames": 505, "words": [["Prueba", 0.05], ["tres.", 0.44], ["Intentas", 1.16], ["hacerte", 1.71], ["el", 2.14], ["interesante", 2.28], ["apoyándote", 2.8], ["en", 3.64], ["la", 3.78], ["pared.", 3.91], ["Y", 4.53], ["la", 4.96], ["pared", 5.07], ["resulta", 5.39], ["ser", 6.05], ["una", 6.23], ["puerta", 6.41], ["que", 6.73], ["alguien", 7.0], ["abre.", 7.32], ["Te", 8.39], ["caes", 8.46], ["al", 8.75], ["pasillo", 8.89], ["delante", 9.3], ["de", 9.73], ["todo", 9.89], ["el", 10.25], ["mundo.", 10.44], ["El", 11.32], ["número", 11.46], ["de", 11.71], ["media", 11.91], ["clase", 12.12], ["sube.", 12.5], ["De", 13.44], ["pura", 13.57], ["risa.", 13.89], ["El", 14.85], ["de", 14.96], ["Sofía", 15.07], ["sigue", 15.5], ["sin", 15.82], ["aparecer.", 16.07]], "caps": [], "p": {"esc": null, "med": null, "flash": false}, "planos": [{"v": "pasillo;X=normal@0.4;ui:PRUEBA 3", "f": "Prueba tres: intentas hacerte el interesante apoyándote en la pared…"}, {"v": "pasillo;X=sorprendido@0.5;fx:caida", "f": "y la pared resulta ser una puerta que alguien abre. Te caes al pasillo delante de todo el mundo."}, {"v": "pasillo;C=riendo@0.25;MT=riendo@0.75;n:C=+;n:MT=+", "f": "El número de media clase sube. De pura risa."}, {"v": "salon;S=normal@0.5;n:S=?;cu", "f": "El de Sofía sigue sin aparecer."}]}, {"tipo": "planos", "titulo": "", "frames": 740, "words": [["Prueba", 0.05], ["cuatro,", 0.53], ["la", 1.35], ["desesperada.", 1.41], ["Le", 2.73], ["escribes", 2.87], ["un", 3.3], ["poema", 3.48], ["en", 3.87], ["una", 4.03], ["servilleta.", 4.16], ["Rimas", 5.48], ["Sofia", 5.85], ["con", 6.3], ["todavía,", 6.6], ["alegría", 7.6], ["y,", 8.16], ["sin", 8.64], ["saber", 8.87], ["por", 9.12], ["qué,", 9.37], ["lavandería.", 10.07], ["Ella", 11.53], ["lo", 11.73], ["lee.", 11.94], ["Lo", 12.82], ["dobla", 12.94], ["con", 13.28], ["cuidado.", 13.46], ["Y", 14.57], ["lo", 14.64], ["guarda", 14.78], ["dentro", 15.23], ["de", 15.48], ["su", 15.73], ["cuaderno.", 15.87], ["Interrogación.", 17.12], ["Pero", 18.44], ["esta", 18.64], ["vez,", 18.91], ["por", 19.69], ["un", 19.78], ["segundo,", 19.89], ["juras", 20.78], ["que", 21.12], ["viste", 21.25], ["un", 21.57], ["número", 21.71], ["asomarse", 22.0], ["antes", 22.62], ["de", 22.98], ["esconderse", 23.21], ["otra", 23.96], ["vez.", 24.16]], "caps": [], "p": {"esc": null, "med": null, "flash": false}, "planos": [{"v": "salon;X=sonrojado@0.5;fx:poema;ui:PRUEBA 4", "f": "Prueba cuatro, la desesperada: le escribes un poema en una servilleta."}, {"v": "neutro;fx:poema", "f": "Rimas \"Sofía\" con \"todavía\", \"alegría\" y, sin saber por qué, \"lavandería\"."}, {"v": "salon;S=sonrojado@0.5;cu", "f": "Ella lo lee. Lo dobla con cuidado. Y lo guarda dentro de su cuaderno."}, {"v": "salon;S=sonrojado@0.5;n:S=?!;cu", "f": "Interrogación. Pero esta vez, por un segundo, juras que viste un número asomarse antes de esconderse otra vez."}]}, {"tipo": "planos", "titulo": "", "frames": 475, "words": [["En", 0.05], ["el", 0.19], ["almuerzo", 0.3], ["se", 0.73], ["sienta", 0.89], ["a", 1.25], ["tu", 1.37], ["lado", 1.5], ["Camila,", 1.62], ["tu", 2.25], ["amiga", 2.85], ["desde", 3.14], ["el", 3.39], ["kínder.", 3.6], ["La", 4.66], ["que", 4.8], ["te", 4.91], ["presta", 5.05], ["los", 5.39], ["apuntes.", 5.5], ["La", 6.75], ["que", 6.91], ["se", 7.05], ["acuerda", 7.16], ["de", 7.5], ["tu", 7.62], ["cumpleaños", 7.75], ["antes", 8.32], ["que", 8.6], ["tú.", 8.8], ["Miras", 9.64], ["sobre", 10.07], ["su", 10.23], ["cabeza", 10.41], ["por", 10.78], ["pura", 11.05], ["costumbre.", 11.39], ["Noventa", 12.35], ["y", 12.78], ["cinco", 12.87], ["por", 13.14], ["ciento.", 13.39], ["Te", 14.21], ["atragantas", 14.35], ["con", 14.85], ["el", 15.1], ["jugo.", 15.23]], "caps": [], "p": {"esc": null, "med": null, "flash": false}, "planos": [{"v": "comedor;C=riendo@0.62;X=normal@0.3", "f": "En el almuerzo se sienta a tu lado Camila, tu amiga desde el kínder."}, {"v": "comedor;C=riendo@0.5;cu", "f": "La que te presta los apuntes. La que se acuerda de tu cumpleaños antes que tú."}, {"v": "comedor;C=normal@0.5;n:C=?", "f": "Miras sobre su cabeza por pura costumbre."}, {"v": "comedor;C=normal@0.5;n:C=95;cu", "f": "Noventa y cinco por ciento."}, {"v": "comedor;X=sorprendido@0.5;cu", "f": "Te atragantas con el jugo."}]}, {"tipo": "planos", "titulo": "", "frames": 502, "words": [["¿Noventa", 0.05], ["y", 0.48], ["cinco?", 0.53], ["¿Camila?", 1.37], ["Ella", 2.71], ["sigue", 2.94], ["hablando", 3.21], ["de", 3.5], ["un", 3.82], ["videojuego", 3.91], ["como", 4.5], ["si", 4.8], ["nada…", 4.96], ["y", 5.71], ["de", 5.91], ["repente", 6.0], ["lo", 6.39], ["entiendes.", 6.64], ["Esta", 7.71], ["persona", 8.07], ["lleva", 8.6], ["años", 8.94], ["queriéndote…", 9.3], ["y", 10.64], ["nunca", 10.85], ["te", 11.05], ["diste", 11.35], ["cuenta.", 11.69], ["Ahora", 12.89], ["tienes", 13.16], ["un", 13.6], ["problema", 13.69], ["mucho", 14.05], ["más", 14.41], ["grande", 14.62], ["que", 14.96], ["un", 15.14], ["número", 15.3], ["que", 15.64], ["no", 15.82], ["aparece.", 15.96]], "caps": [], "p": {"esc": null, "med": null, "flash": false}, "planos": [{"v": "comedor;X=sorprendido@0.3;C=riendo@0.68;n:C=95", "f": "¿Noventa y cinco? ¿Camila? Ella sigue hablando de un videojuego como si nada."}, {"v": "comedor;X=pensando@0.5;cu", "f": "Y de repente lo entiendes: esta persona lleva años queriéndote… y nunca te diste cuenta."}, {"v": "comedor;X=preocupado@0.5", "f": "Ahora tienes un problema mucho más grande que un número que no aparece."}]}, {"tipo": "planos", "titulo": "", "frames": 570, "words": [["Esa", 0.05], ["noche", 0.46], ["no", 0.71], ["duermes.", 1.03], ["Miras", 2.12], ["al", 2.6], ["techo.", 2.78], ["Por", 3.78], ["un", 3.85], ["lado", 3.98], ["está", 4.19], ["Sofía,", 4.41], ["con", 5.39], ["su", 5.48], ["misterio.", 5.66], ["Por", 6.91], ["el", 7.05], ["otro", 7.16], ["está", 7.37], ["Camila,", 7.62], ["que", 8.6], ["te", 8.64], ["quiere", 8.8], ["de", 9.0], ["verdad.", 9.19], ["Y", 10.12], ["entiendes", 10.16], ["algo", 10.71], ["incómodo.", 10.89], ["Has", 12.14], ["pasado", 12.3], ["todo", 12.71], ["el", 13.14], ["día", 13.32], ["tratando", 13.5], ["de", 14.03], ["cambiar", 14.16], ["lo", 14.46], ["que", 14.75], ["otros", 14.89], ["sienten", 15.14], ["por", 15.62], ["ti…", 15.85], ["en", 16.66], ["vez", 16.82], ["de", 16.98], ["ser", 17.12], ["honesto", 17.25], ["con", 17.75], ["lo", 17.89], ["que", 17.98], ["sientes", 18.1], ["tú.", 18.41]], "caps": [], "p": {"esc": null, "med": null, "flash": false}, "planos": [{"v": "noche;X=pensando@0.5", "f": "Esa noche no duermes. Miras al techo."}, {"v": "neutro;S=normal@0.3;C=riendo@0.7;n:S=?;n:C=95", "f": "Por un lado está Sofía, con su misterio. Por el otro está Camila, que te quiere de verdad."}, {"v": "noche;X=preocupado@0.5;cu", "f": "Y entiendes algo incómodo: has pasado todo el día tratando de cambiar lo que otros sienten por ti…"}, {"v": "noche;X=pensando@0.5;cu", "f": "en vez de ser honesto con lo que sientes tú."}]}, {"tipo": "planos", "titulo": "", "frames": 754, "words": [["Abres", 0.05], ["el", 0.35], ["chat", 0.5], ["de", 0.73], ["Sofía", 0.89], ["y", 1.3], ["escribes", 1.46], ["ola.", 1.98], ["Lo", 3.28], ["borras.", 3.32], ["Escribes", 4.23], ["¿estás", 4.8], ["despierta?", 5.16], ["Lo", 6.46], ["borras.", 6.6], ["Escribes", 7.53], ["un", 7.94], ["párrafo", 8.07], ["entero.", 8.5], ["Lo", 9.48], ["borras", 9.57], ["también.", 9.89], ["A", 10.91], ["las", 11.1], ["tres", 11.21], ["de", 11.44], ["la", 11.55], ["mañana", 11.66], ["te", 11.96], ["llega", 12.19], ["un", 12.39], ["mensaje.", 12.6], ["Es", 13.69], ["de", 13.82], ["ella.", 14.0], ["¿Mañana", 14.82], ["me", 15.21], ["ayudas", 15.35], ["con", 15.73], ["el", 15.89], ["trabajo", 16.03], ["de", 16.41], ["ciencias?", 16.55], ["Tú", 17.64], ["explicas", 17.78], ["bonito.", 18.32], ["Lees", 19.44], ["explicas", 19.87], ["bonito", 20.6], ["catorce", 20.98], ["veces.", 21.5], ["Decides", 22.44], ["hacer", 22.85], ["dos", 23.14], ["cosas", 23.41], ["difíciles", 23.8], ["mañana.", 24.44]], "caps": [], "p": {"esc": null, "med": null, "flash": false}, "planos": [{"v": "noche;X=pensando@0.5;fx:chat", "f": "Abres el chat de Sofía y escribes \"hola\". Lo borras."}, {"v": "neutro;fx:chat", "f": "Escribes \"¿estás despierta?\". Lo borras. Escribes un párrafo entero. Lo borras también."}, {"v": "noche;X=sorprendido@0.5;fx:chat", "f": "A las tres de la mañana te llega un mensaje. Es de ella:"}, {"v": "neutro;fx:chat", "f": "\"¿Mañana me ayudas con el trabajo de ciencias? Tú explicas bonito\"."}, {"v": "noche;X=sonrojado@0.5;cu", "f": "Lees \"explicas bonito\" catorce veces."}, {"v": "noche;X=normal@0.5", "f": "Decides hacer dos cosas difíciles mañana."}]}, {"tipo": "planos", "titulo": "", "frames": 826, "words": [["Primero", 0.05], ["hablas", 0.46], ["con", 0.8], ["Camila.", 1.0], ["Le", 2.19], ["dices", 2.32], ["la", 2.6], ["verdad,", 2.75], ["con", 3.53], ["cuidado,", 3.73], ["que", 4.73], ["es", 4.82], ["tu", 4.96], ["mejor", 5.1], ["amiga,", 5.32], ["que", 6.19], ["es", 6.21], ["increíble,", 6.32], ["y", 7.39], ["que", 7.44], ["tu", 7.53], ["corazón", 7.69], ["está", 8.0], ["con", 8.28], ["otra", 8.48], ["persona.", 8.66], ["Ella", 10.03], ["baja", 10.19], ["la", 10.48], ["mirada.", 10.66], ["El", 11.6], ["número", 11.71], ["no", 11.98], ["baja.", 12.19], ["Sigue", 12.98], ["en", 13.3], ["noventa", 13.46], ["y", 13.85], ["cinco.", 13.91], ["—Ya", 15.05], ["lo", 15.25], ["sabía,", 15.39], ["tonto", 15.82], ["—dice", 16.14], ["sonriendo—.", 16.94], ["Se", 18.16], ["te", 18.25], ["nota", 18.37], ["desde", 18.55], ["lejos.", 18.78], ["Ve", 19.82], ["a", 19.91], ["hablarle.", 20.05], ["Y", 21.07], ["ahí", 21.14], ["entiendes", 21.28], ["que", 21.78], ["querer", 21.87], ["a", 22.1], ["alguien", 22.23], ["no", 22.5], ["siempre", 22.69], ["significa", 22.96], ["tenerlo.", 23.53], ["A", 24.53], ["veces", 24.62], ["significa", 24.8], ["empujarlo", 25.3], ["hacia", 26.14], ["lo", 26.35], ["que", 26.55], ["lo", 26.64], ["hace", 26.78], ["feliz.", 26.94]], "caps": [], "p": {"esc": null, "med": null, "flash": false}, "planos": [{"v": "patio;X=normal@0.3;C=normal@0.68", "f": "Primero hablas con Camila."}, {"v": "patio;X=preocupado@0.5;cu", "f": "Le dices la verdad, con cuidado: que es tu mejor amiga, que es increíble,"}, {"v": "patio;X=sonrojado@0.5;cu", "f": "y que tu corazón está con otra persona."}, {"v": "patio;C=llorando@0.5;n:C=95;cu", "f": "Ella baja la mirada. El número no baja. Sigue en noventa y cinco."}, {"v": "patio;C=riendo@0.5;cu", "f": "—Ya lo sabía, tonto —dice sonriendo—. Se te nota desde lejos. Ve a hablarle."}, {"v": "patio;X=pensando@0.3;C=riendo@0.68", "f": "Y ahí entiendes que querer a alguien no siempre significa tenerlo."}, {"v": "patio;C=riendo@0.5!saluda", "f": "A veces significa empujarlo hacia lo que lo hace feliz."}]}, {"tipo": "planos", "titulo": "", "frames": 630, "words": [["Encuentras", 0.05], ["a", 0.5], ["Sofía", 0.6], ["en", 0.91], ["la", 0.98], ["biblioteca.", 1.07], ["Esta", 2.25], ["vez", 2.46], ["no", 2.66], ["haces", 2.96], ["trucos.", 3.25], ["Te", 4.23], ["sientas", 4.35], ["y", 4.87], ["le", 5.05], ["dices", 5.14], ["—Me", 5.57], ["gustas.", 6.16], ["Desde", 7.19], ["hace", 7.39], ["meses.", 7.66], ["Y", 8.46], ["no", 8.62], ["sé", 8.73], ["si", 8.87], ["yo", 8.98], ["te", 9.12], ["gusto,", 9.23], ["pero", 10.03], ["quería", 10.28], ["que", 10.53], ["lo", 10.69], ["supieras.", 10.82], ["Silencio.", 11.85], ["Ella", 12.94], ["cierra", 13.12], ["el", 13.53], ["cuaderno.", 13.69], ["Te", 14.64], ["lo", 14.78], ["pasa.", 14.91], ["Está", 15.71], ["lleno", 15.91], ["de", 16.21], ["dibujos", 16.28], ["tuyos.", 16.78], ["En", 17.6], ["clase,", 17.73], ["en", 18.55], ["el", 18.71], ["pasillo,", 18.82], ["cayéndote", 19.57], ["por", 20.07], ["la", 20.23], ["puerta.", 20.39]], "caps": [], "p": {"esc": null, "med": null, "flash": false}, "planos": [{"v": "biblio;S=normal@0.65;X=normal@0.28", "f": "Encuentras a Sofía en la biblioteca. Esta vez no haces trucos."}, {"v": "biblio;X=sonrojado@0.5;cu", "f": "Te sientas y le dices: —Me gustas. Desde hace meses."}, {"v": "biblio;X=preocupado@0.5;cu", "f": "Y no sé si yo te gusto, pero quería que lo supieras."}, {"v": "biblio;S=sonrojado@0.5;cu", "f": "Silencio. Ella cierra el cuaderno. Te lo pasa."}, {"v": "neutro;fx:dibujos", "f": "Está lleno de dibujos tuyos: en clase, en el pasillo, cayéndote por la puerta."}]}, {"tipo": "planos", "titulo": "", "frames": 707, "words": [["—Mi", 0.05], ["número", 0.32], ["no", 0.6], ["te", 0.82], ["salía,", 0.98], ["¿verdad?", 1.44], ["—pregunta", 2.14], ["ella.", 2.62], ["Te", 3.39], ["quedas", 3.5], ["helado.", 3.87], ["—Es", 4.78], ["que", 4.85], ["yo", 4.96], ["tampoco", 5.07], ["sabía", 5.44], ["qué", 5.78], ["sentía", 5.94], ["—dice.", 6.44], ["—Hasta", 7.46], ["hoy.", 7.71], ["Miras", 8.55], ["sobre", 8.85], ["su", 9.03], ["cabeza.", 9.21], ["Los", 10.3], ["signos", 10.41], ["de", 10.87], ["interrogación", 10.91], ["tiemblan", 11.6], ["y", 12.12], ["se", 12.73], ["convierten", 12.85], ["en", 13.35], ["un", 13.53], ["número.", 13.66], ["Pero", 14.66], ["antes", 14.89], ["de", 15.21], ["que", 15.39], ["puedas", 15.5], ["leerlo,", 15.85], ["ella", 16.57], ["te", 16.71], ["tapa", 16.91], ["los", 17.12], ["ojos", 17.32], ["con", 17.6], ["las", 17.8], ["manos.", 17.96], ["—Algunas", 19.0], ["cosas", 19.48], ["—dice—", 19.69], ["es", 21.23], ["mejor", 21.35], ["descubrirlas", 21.71], ["sin", 22.5], ["poderes.", 22.71]], "caps": [], "p": {"esc": null, "med": null, "flash": false}, "planos": [{"v": "biblio;S=pensando@0.5;n:S=?;cu", "f": "—Mi número no te salía, ¿verdad? —pregunta ella."}, {"v": "biblio;X=sorprendido@0.5;cu", "f": "Te quedas helado."}, {"v": "biblio;S=sonrojado@0.5;cu", "f": "—Es que yo tampoco sabía qué sentía —dice—. Hasta hoy."}, {"v": "biblio;S=sonrojado@0.5;n:S=glitch;cu", "f": "Miras sobre su cabeza. Los signos de interrogación tiemblan… y se convierten en un número."}, {"v": "biblio;S=riendo@0.62!saluda;X=sorprendido@0.3", "f": "Pero antes de que puedas leerlo, ella te tapa los ojos con las manos."}, {"v": "biblio;S=riendo@0.5;cu", "f": "—Algunas cosas —dice— es mejor descubrirlas sin poderes."}]}, {"tipo": "planos", "titulo": "", "frames": 653, "words": [["A", 0.05], ["la", 0.14], ["mañana", 0.21], ["siguiente", 0.46], ["te", 0.78], ["despiertas.", 1.07], ["Los", 2.44], ["números", 2.55], ["ya", 2.82], ["no", 3.0], ["están.", 3.12], ["El", 4.16], ["poder", 4.37], ["desapareció.", 4.66], ["Pero", 6.0], ["no", 6.28], ["lo", 6.5], ["necesitas.", 6.64], ["Porque", 8.03], ["ahora", 8.35], ["sabes", 8.55], ["que", 8.85], ["lo", 9.03], ["importante", 9.14], ["no", 9.62], ["es", 9.96], ["cuánto", 10.1], ["te", 10.62], ["quieren", 10.71], ["los", 10.91], ["demás…", 11.12], ["sino", 11.91], ["tener", 12.37], ["el", 12.66], ["valor", 12.87], ["de", 13.14], ["decir", 13.32], ["lo", 13.66], ["que", 13.89], ["sientes.", 14.03], ["Y", 15.23], ["tú,", 15.39], ["si", 16.23], ["pudieras", 16.32], ["ver", 16.82], ["ese", 16.98], ["número,", 17.19], ["¿de", 18.25], ["quién", 18.35], ["lo", 18.5], ["mirarías", 18.69], ["primero?", 19.1], ["Te", 20.14], ["leo", 20.23], ["en", 20.53], ["los", 20.62], ["comentarios.", 20.73]], "caps": [], "p": {"esc": null, "med": null, "flash": false}, "planos": [{"v": "cuarto;X=normal@0.5", "f": "A la mañana siguiente te despiertas. Los números ya no están. El poder desapareció."}, {"v": "calle;X=riendo@0.5", "f": "Pero no lo necesitas."}, {"v": "patio;X=riendo@0.32;S=riendo@0.68;fx:brillo", "f": "Porque ahora sabes que lo importante no es cuánto te quieren los demás…"}, {"v": "patio;X=sonrojado@0.5;cu", "f": "sino tener el valor de decir lo que sientes."}, {"v": "neutro;X=pensando@0.5;ui:¿DE QUIÉN LO MIRARÍAS?", "f": "Y tú, si pudieras ver ese número, ¿de quién lo mirarías primero? Te leo en los comentarios."}]}]