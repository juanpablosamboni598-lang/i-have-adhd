, ["su", 4.21], ["cuaderno.", 4.53], ["Pinza", 4.84], ["de", 5.15], ["estrella.", 5.46], ["Cárdigan", 5.78], ["lila.", 6.09], ["Respiras.", 6.4], ["Miras", 6.71], ["encima", 7.03], ["de", 7.34], ["su", 7.65], ["cabeza.", 7.96], ["Y", 8.28], ["el", 8.59], ["número…", 8.9], ["no", 9.21], ["se", 9.53], ["ve.", 9.84], ["En", 10.15], ["vez", 10.46], ["de", 10.78], ["un", 11.09], ["porcentaje", 11.4], ["hay", 11.71], ["unos", 12.03], ["signos", 12.34], ["de", 12.65], ["interrogación", 12.96], ["que", 13.28], ["parpadean.", 13.59], ["Como", 13.9], ["si", 14.21], ["el", 14.53], ["sistema", 14.84], ["se", 15.15], ["hubiera", 15.46], ["trabado.", 15.78]], "caps": [], "p": {"esc": null, "med": null, "flash": false}, "planos": [{"v": "salon;S=normal@0.6;X=sonrojado@0.22", "f": "Llegas al salón. Ella está junto a la ventana, como siempre, dibujando en su cuaderno."}, {"v": "salon;S=sonrojado@0.5;cu", "f": "Pinza de estrella. Cárdigan lila."}, {"v": "salon;X=normal@0.5;cu", "f": "Respiras. Miras encima de su cabeza."}, {"v": "salon;S=normal@0.5;n:S=?;cu", "f": "Y el número… no se ve."}, {"v": "salon;S=normal@0.5;n:S=?", "f": "En vez de un porcentaje hay unos signos de interrogación que parpadean."}, {"v": "salon;X=sorprendido@0.5;cu", "f": "Como si el sistema se hubiera trabado."}]}, {"tipo": "planos", "titulo": "", "frames": 324, "words": [["Te", 0.15], ["frotas", 0.46], ["los", 0.78], ["ojos.", 1.09], ["Miras", 1.4], ["a", 1.71], ["tu", 2.02], ["profesor:", 2.34], ["doce", 2.65], ["por", 2.96], ["ciento,", 3.27], ["qué", 3.59], ["novedad.", 3.9], ["Miras", 4.21], ["otra", 4.53], ["vez", 4.84], ["a", 5.15], ["Sofía.", 5.46], ["Interrogación.", 5.78], ["Interrogación.", 6.09], ["Interrogación.", 6.4], ["¿Qué", 6.71], ["significa", 7.03], ["eso?", 7.34], ["¿Que", 7.65], ["no", 7.96], ["le", 8.28], ["importas?", 8.59], ["¿Que", 8.9], ["el", 9.21], ["poder", 9.53], ["está", 9.84], ["roto?", 10.15]], "caps": [], "p": {"esc": null, "med": null, "flash": false}, "planos": [{"v": "salon;T=enojado@0.6;X=pensando@0.25;n:T=12", "f": "Te frotas los ojos. Miras a tu profesor: doce por ciento, qué novedad."}, {"v": "salon;S=normal@0.5;n:S=?;cu", "f": "Miras otra vez a Sofía. Interrogación. Interrogación. Interrogación."}, {"v": "salon;X=preocupado@0.5;cu", "f": "¿Qué significa eso? ¿Que no le importas?"}, {"v": "salon;X=pensando@0.5", "f": "¿Que el poder está roto?"}]}, {"tipo": "planos", "titulo": "", "frames": 456, "words": [["Decides", 0.15], ["investigar", 0.46], ["como", 0.78], ["un", 1.09], ["científico.", 1.4], ["Si", 1.71], ["el", 2.02], ["número", 2.34], ["cambia", 2.65], ["según", 2.96], ["lo", 3.27], ["que", 3.59], ["hace", 3.9], ["la", 4.21], ["gente,", 4.53], ["tal", 4.84], ["vez", 5.15], ["puedas", 5.46], ["hacerlo", 5.78], ["aparecer.", 6.09], ["Prueba", 6.4], ["uno:", 6.71], ["le", 7.03], ["prestas", 7.34], ["un", 7.65], ["lápiz.", 7.96], ["Interrogación.", 8.28], ["Prueba", 8.59], ["dos:", 8.9], ["le", 9.21], ["cuentas", 9.53], ["tu", 9.84], ["mejor", 10.15], ["chiste.", 10.46], ["Ella", 10.78], ["se", 11.09], ["ríe", 11.4], ["un", 11.71], ["poquito.", 12.03], ["El", 12.34], ["símbolo", 12.65], ["parpadea", 12.96], ["más", 13.28], ["rápido…", 13.59], ["pero", 13.9], ["no", 14.21], ["cambia.", 14.53]], "caps": [], "p": {"esc": null, "med": null, "flash": false}, "planos": [{"v": "salon;X=pensando@0.5;ui:EXPERIMENTO", "f": "Decides investigar como un científico."}, {"v": "salon;X=normal@0.5;ui:HIPÓTESIS", "f": "Si el número cambia según lo que hace la gente, tal vez puedas hacerlo aparecer."}, {"v": "salon;X=sonrojado@0.3;S=sorprendido@0.68;n:S=?;ui:PRUEBA 1", "f": "Prueba uno: le prestas un lápiz. Interrogación."}, {"v": "salon;X=riendo@0.3;S=riendo@0.68;n:S=?;ui:PRUEBA 2", "f": "Prueba dos: le cuentas tu mejor chiste. Ella se ríe un poquito."}, {"v": "salon;S=riendo@0.5;n:S=?;cu", "f": "El símbolo parpadea más rápido… pero no cambia."}]}, {"tipo": "planos", "titulo": "", "frames": 428, "words": [["Prueba", 0.15], ["tres:", 0.46], ["inte