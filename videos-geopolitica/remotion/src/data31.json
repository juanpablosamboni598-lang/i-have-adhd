[{"tipo": "planos", "titulo": "", "frames": 343, "words": [["Imagina", 0.15], ["que", 0.46], ["la", 0.78], ["persona", 1.09], ["que", 1.4], ["te", 1.71], ["gusta", 2.02], ["pudiera", 2.34], ["escuchar", 2.65], ["todo", 2.96], ["lo", 3.27], ["que", 3.59], ["piensas.", 3.9], ["Todo.", 4.21], ["Cada", 4.53], ["pensamiento.", 4.84], ["Cada", 5.15], ["uno.", 5.46], ["El", 5.78], ["problema", 6.09], ["es", 6.4], ["que", 6.71], ["tú", 7.03], ["piensas", 7.34], ["en", 7.65], ["ella…", 7.96], ["todo", 8.28], ["el", 8.59], ["tiempo.", 8.9], ["Y", 9.21], ["no", 9.53], ["hay", 9.84], ["forma", 10.15], ["de", 10.46], ["apagarlo.", 10.78]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "chip": null}, "planos": [{"v": "salon;X=normal@0.3;S=normal@0.68", "f": "Imagina que la persona que te gusta pudiera escuchar todo lo que piensas."}, {"v": "salon;X=sorprendido@0.5;cu", "f": "Todo. Cada pensamiento. Cada uno."}, {"v": "salon;X=sonrojado@0.3;S=sorprendido@0.68;fx:rayo", "f": "El problema es que tú piensas en ella… todo el tiempo."}, {"v": "neutro;X=preocupado@0.5;cu;th:no pienses en ella…", "f": "Y no hay forma de apagarlo."}]}, {"tipo": "planos", "titulo": "", "frames": 99, "words": [["¿Qué", 0.15], ["pasaría", 0.46], ["si", 0.78], ["tu", 1.09], ["crush", 1.4], ["pudiera", 1.71], ["escuchar", 2.02], ["tus", 2.34], ["pensamientos?", 2.65]], "caps": [], "p": {"esc": null, "med": null, "flash": true, "chip": null}, "planos": [{"v": "tit", "f": "¿Qué pasaría si tu crush pudiera escuchar tus pensamientos?"}]}, {"tipo": "planos", "titulo": "", "frames": 549, "words": [["Es", 0.15], ["un", 0.46], ["lunes", 0.78], ["normal.", 1.09], ["Llegas", 1.4], ["al", 1.71], ["colegio", 2.02], ["medio", 2.34], ["dormido,", 2.65], ["con", 2.96], ["la", 3.27], ["gorra", 3.59], ["torcida.", 3.9], ["Y", 4.21], ["ahí", 4.53], ["está", 4.84], ["Sofía,", 5.15], ["en", 5.46], ["la", 5.78], ["entrada,", 6.09], ["riéndose", 6.4], ["con", 6.71], ["sus", 7.03], ["amigas.", 7.34], ["Y", 7.65], ["piensas,", 7.96], ["sin", 8.28], ["querer:", 8.59], ["\"Qué", 8.9], ["bonita", 9.21], ["se", 9.53], ["ve", 9.84], ["hoy\".", 10.15], ["Sofía", 10.46], ["se", 10.78], ["da", 11.09], ["la", 11.4], ["vuelta", 11.71], ["de", 12.03], ["golpe.", 12.34], ["Te", 12.65], ["mira.", 12.96], ["Se", 13.28], ["pone", 13.59], ["roja", 13.9], ["como", 14.21], ["un", 14.53], ["tomate.", 14.84], ["—¿Qué", 15.15], ["dijiste?", 15.46], ["Tú", 15.78], ["no", 16.09], ["dijiste", 16.4], ["nada.", 16.71], ["Ni", 17.02], ["una", 17.34], ["palabra.", 17.65]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "chip": ["PENSAMIENTOS", "1", "OÍDOS"]}, "planos": [{"v": "entrada;X=normal@0.5", "f": "Es un lunes normal. Llegas al colegio medio dormido, con la gorra torcida."}, {"v": "entrada;S=riendo@0.62;X=sonrojado@0.28", "f": "Y ahí está Sofía, en la entrada, riéndose con sus amigas."}, {"v": "entrada;X=sonrojado@0.5;cu;th:qué bonita se ve hoy…", "f": "Y piensas, sin querer: \"Qué bonita se ve hoy\"."}, {"v": "entrada;S=sorprendido@0.62;X=sorprendido@0.28;fx:rayo", "f": "Sofía se da la vuelta de golpe. Te mira. Se pone roja como un tomate."}, {"v": "entrada;S=sonrojado@0.5;cu", "f": "—¿Qué dijiste?"}, {"v": "entrada;X=sorprendido@0.5;cu", "f": "Tú no dijiste nada. Ni una palabra."}]}, {"tipo": "planos", "titulo": "", "frames": 390, "words": [["En", 0.15], ["clase", 0.46], ["decides", 0.78], ["hacer", 1.09], ["una", 1.4], ["prueba.", 1.71], ["Te", 2.02], ["sientas", 2.34], ["detrás", 2.65], ["de", 2.96], ["ella", 3.27], ["y", 3.59], ["piensas,", 3.9], ["muy", 4.21], ["fuerte,", 4.53], ["una", 4.84], ["sola", 5.15], ["palabra.", 5.46], ["Pizza.", 5.78], ["Sofía", 6.09], ["se", 6.4], ["da", 6.71], ["la", 7.03], ["vuelta", 7.34], ["y", 7.65], ["susurra:", 7.96], ["—¿Pizza?", 8.28], ["Ay,", 8.59], ["no.", 8.9], ["Ella", 9.21], ["puede", 9.53], ["escuchar", 9.84], ["tus", 10.15], ["pensamientos.", 10.46], ["Solo", 10.78], ["ella.", 11.09], ["Y", 11.4], ["solo", 11.71], ["los", 12.03], ["tuyos.", 12.34]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "chip": ["PENSAMIENTOS", "2", "OÍDOS"]}, "planos": [{"v": "salon;X=pensando@0.5", "f": "En clase decides hacer una prueba. Te sientas detrás de ella y piensas, muy fuerte, una sola palabra."}, {"v": "salon;X=pensando@0.5;cu;th:PIZZA", "f": "Pizza."}, {"v": "salon;S=pensando@0.5;cu", "f": "Sofía se da la vuelta y susurra: —¿Pizza?"}, {"v": "salon;X=sorprendido@0.5;cu", "f": "Ay, no."}, {"v": "salon;X=preocupado@0.3;S=normal@0.68;fx:rayo", "f": "Ella puede escuchar tus pensamientos. Solo ella. Y solo los tuyos."}]}, {"tipo": "planos", "titulo": "", "frames": 465, "words": [["Entras", 0.15], ["en", 0.46], ["pánico.", 0.78], ["Intentas", 1.09], ["no", 1.4], ["pensar", 1.71], ["en", 2.02], ["nada.", 2.34], ["Pero", 2.65], ["cuando", 2.96], ["intentas", 3.27], ["no", 3.59], ["pensar", 3.9], ["en", 4.21], ["algo…", 4.53], ["es", 4.84], ["lo", 5.15], ["único", 5.46], ["en", 5.78], ["lo", 6.09], ["que", 6.4], ["piensas.", 6.71], ["No", 7.03], ["pienses", 7.34], ["en", 7.65], ["su", 7.96], ["pelo.", 8.28], ["No", 8.59], ["pienses", 8.9], ["en", 9.21], ["su", 9.53], ["pinza", 9.84], ["de", 10.15], ["estrella.", 10.46], ["No", 10.78], ["pienses", 11.09], ["en", 11.4], ["cómo", 11.71], ["se", 12.03], ["ríe.", 12.34], ["Sofía", 12.65], ["se", 12.96], ["tapa", 13.28], ["la", 13.59], ["boca", 13.9], ["para", 14.21], ["no", 14.53], ["reírse.", 14.84]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "chip": ["PENSAMIENTOS", "5", "OÍDOS"]}, "planos": [{"v": "salon;X=preocupado@0.5;cu", "f": "Entras en pánico. Intentas no pensar en nada."}, {"v": "salon;X=preocupado@0.5;cu;th:no pienses en su pelo…", "f": "Pero cuando intentas no pensar en algo… es lo único en lo que piensas."}, {"v": "salon;X=llorando@0.5;cu;th:ni en su pinza de estrella…", "f": "No pienses en su pelo. No pienses en su pinza de estrella. No pienses en cómo se ríe."}, {"v": "salon;S=riendo@0.5;cu", "f": "Sofía se tapa la boca para no reírse."}]}, {"tipo": "planos", "titulo": "", "frames": 352, "words": [["El", 0.15], ["profesor", 0.46], ["explica", 0.78], ["fracciones.", 1.09], ["Tú", 1.4], ["intentas", 1.71], ["concentrarte.", 2.02], ["Pero", 2.34], ["tu", 2.65], ["cerebro", 2.96], ["decide", 3.27], ["hacer", 3.59], ["poesía:", 3.9], ["\"Su", 4.21], ["pinza", 4.53], ["de", 4.84], ["estrella", 5.15], ["brilla…", 5.46], ["como", 5.78], ["ella\".", 6.09], ["Sofía", 6.4], ["suelta", 6.71], ["una", 7.03], ["carcajada", 7.34], ["en", 7.65], ["plena", 7.96], ["clase.", 8.28], ["—Señorita,", 8.59], ["¿le", 8.9], ["parecen", 9.21], ["graciosas", 9.53], ["las", 9.84], ["fracciones?", 10.15], ["—No,", 10.46], ["profe…", 10.78], ["perdón.", 11.09]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "chip": ["PENSAMIENTOS", "7", "OÍDOS"]}, "planos": [{"v": "salon;T=normal@0.6;X=pensando@0.25", "f": "El profesor explica fracciones. Tú intentas concentrarte."}, {"v": "salon;X=pensando@0.5;cu;th:su pinza brilla… como ella", "f": "Pero tu cerebro decide hacer poesía: \"Su pinza de estrella brilla… como ella\"."}, {"v": "salon;S=riendo@0.5;cu", "f": "Sofía suelta una carcajada en plena clase."}, {"v": "salon;T=enojado@0.5;cu", "f": "—Señorita, ¿le parecen graciosas las fracciones?"}, {"v": "salon;S=sonrojado@0.62;X=sonrojado@0.28", "f": "—No, profe… perdón."}]}, {"tipo": "planos", "titulo": "", "frames": 437, "words": [["Te", 0.15], ["hundes", 0.46], ["en", 0.78], ["tu", 1.09], ["silla", 1.4], ["y", 1.71], ["piensas,", 2.02], ["triste:", 2.34], ["\"Ojalá", 2.65], ["algún", 2.96], ["día", 3.27], ["me", 3.59], ["hablara\".", 3.9], ["Dos", 4.21], ["segundos", 4.53], ["después,", 4.84], ["un", 5.15], ["papelito", 5.46], ["cae", 5.78], ["sobre", 6.09], ["tu", 6.4], ["pupitre.", 6.71], ["Dice:", 7.03], ["\"Te", 7.34], ["estoy", 7.65], ["hablando,", 7.96], ["tonto\".", 8.28], ["Tu", 8.59], ["cerebro", 8.9], ["se", 9.21], ["apaga", 9.53], ["por", 9.84], ["completo.", 10.15], ["Y", 10.46], ["por", 10.78], ["primera", 11.09], ["vez", 11.4], ["en", 11.71], ["todo", 12.03], ["el", 12.34], ["día,", 12.65], ["no", 12.96], ["piensas", 13.28], ["en", 13.59], ["nada.", 13.9]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "chip": ["PENSAMIENTOS", "9", "OÍDOS"]}, "planos": [{"v": "salon;X=pensando@0.5;cu;th:ojalá me hablara…", "f": "Te hundes en tu silla y piensas, triste: \"Ojalá algún día me hablara\"."}, {"v": "salon;S=normal@0.62;X=normal@0.28;fx:carta", "f": "Dos segundos después, un papelito cae sobre tu pupitre."}, {"v": "neutro;fx:carta", "f": "Dice: \"Te estoy hablando, tonto\"."}, {"v": "salon;X=sorprendido@0.5;cu", "f": "Tu cerebro se apaga por completo. Y por primera vez en todo el día, no piensas en nada."}]}, {"tipo": "planos", "titulo": "", "frames": 699, "words": [["Y", 0.15], ["como", 0.46], ["el", 0.78], ["universo", 1.09], ["tiene", 1.4], ["sentido", 1.71], ["del", 2.02], ["humor,", 2.34], ["el", 2.65], ["profesor", 2.96], ["anuncia:", 3.27], ["—Hoy", 3.59], ["hay", 3.9], ["exposiciones.", 4.21], ["Empieza…", 4.53], ["usted.", 4.84], ["Te", 5.15], ["toca", 5.46], ["a", 5.78], ["ti.", 6.09], ["Delante", 6.4], ["de", 6.71], ["toda", 7.03], ["la", 7.34], ["clase.", 7.65], ["Delante", 7.96], ["de", 8.28], ["ella.", 8.59], ["Te", 8.9], ["paras", 9.21], ["frente", 9.53], ["al", 9.84], ["pizarrón.", 10.15], ["Te", 10.46], ["tiemblan", 10.78], ["las", 11.09], ["piernas.", 11.4], ["Y", 11.71], ["tu", 12.03], ["cabeza", 12.34], ["no", 12.65], ["ayuda:", 12.96], ["\"No", 13.28], ["la", 13.59], ["mires,", 13.9], ["no", 14.21], ["la", 14.53], ["mires,", 14.84], ["no", 15.15], ["la", 15.46], ["mires…\".", 15.78], ["La", 16.09], ["miras.", 16.4], ["Ella", 16.71], ["te", 17.02], ["levanta", 17.34], ["el", 17.65], ["pulgar.", 17.96], ["Y", 18.27], ["de", 18.59], ["repente,", 18.9], ["la", 19.21], ["exposición", 19.52], ["te", 19.84], ["sale", 20.15], ["perfecta.", 20.46], ["Sacas", 20.77], ["la", 21.09], ["mejor", 21.4], ["nota", 21.71], ["de", 22.02], ["la", 22.34], ["clase.", 22.65]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "chip": ["PENSAMIENTOS", "11", "OÍDOS"]}, "planos": [{"v": "salon;T=normal@0.5;cu", "f": "Y como el universo tiene sentido del humor, el profesor anuncia: —Hoy hay exposiciones. Empieza… usted."}, {"v": "salon;X=sorprendido@0.5;cu", "f": "Te toca a ti. Delante de toda la clase. Delante de ella."}, {"v": "salon;X=preocupado@0.5;ui:EXPOSICIÓN", "f": "Te paras frente al pizarrón. Te tiemblan las piernas."}, {"v": "salon;X=preocupado@0.5;cu;th:no la mires, no la mires…", "f": "Y tu cabeza no ayuda: \"No la mires, no la mires, no la mires…\"."}, {"v": "salon;S=riendo@0.5;cu", "f": "La miras. Ella te levanta el pulgar."}, {"v": "salon;X=riendo@0.5;cu;th:¡me levantó el pulgar!", "f": "Y de repente, la exposición te sale perfecta. Sacas la mejor nota de la clase."}]}, {"tipo": "planos", "titulo": "", "frames": 521, "words": [["Tu", 0.15], ["mejor", 0.46], ["amiga,", 0.78], ["Camila,", 1.09], ["te", 1.4], ["mira", 1.71], ["con", 2.02], ["los", 2.34], ["ojos", 2.65], ["entrecerrados.", 2.96], ["—Hoy", 3.27], ["estás", 3.59], ["rarísimo.", 3.9], ["Y", 4.21], ["Sofía", 4.53], ["no", 4.84], ["deja", 5.15], ["de", 5.46], ["mirarte.", 5.78], ["¿Qué", 6.09], ["está", 6.4], ["pasando?", 6.71], ["Piensas:", 7.03], ["\"No", 7.34], ["le", 7.65], ["digas,", 7.96], ["no", 8.28], ["le", 8.59], ["digas\".", 8.9], ["Pero", 9.21], ["Camila", 9.53], ["te", 9.84], ["conoce", 10.15], ["desde", 10.46], ["el", 10.78], ["kínder.", 11.09], ["—Ay,", 11.4], ["por", 11.71], ["fin.", 12.03], ["Ya", 12.34], ["era", 12.65], ["hora", 12.96], ["de", 13.28], ["que", 13.59], ["ella", 13.9], ["se", 14.21], ["diera", 14.53], ["cuenta.", 14.84], ["Llevas", 15.15], ["meses", 15.46], ["suspirando", 15.78], ["como", 16.09], ["una", 16.4], ["novela.", 16.71]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "chip": ["PENSAMIENTOS", "12", "OÍDOS"]}, "planos": [{"v": "comedor;C=pensando@0.62;X=normal@0.28", "f": "Tu mejor amiga, Camila, te mira con los ojos entrecerrados."}, {"v": "comedor;C=pensando@0.5;cu", "f": "—Hoy estás rarísimo. Y Sofía no deja de mirarte. ¿Qué está pasando?"}, {"v": "comedor;X=sonrojado@0.5;cu;th:no le digas, no le digas…", "f": "Piensas: \"No le digas, no le digas\". Pero Camila te conoce desde el kínder."}, {"v": "comedor;C=riendo@0.5;cu", "f": "—Ay, por fin. Ya era hora de que ella se diera cuenta. Llevas meses suspirando como una novela."}]}, {"tipo": "planos", "titulo": "", "frames": 690, "words": [["En", 0.15], ["el", 0.46], ["recreo,", 0.78], ["Mateo,", 1.09], ["el", 1.4], ["capitán", 1.71], ["del", 2.02], ["equipo,", 2.34], ["se", 2.65], ["acerca", 2.96], ["a", 3.27], ["Sofía.", 3.59], ["—Oye,", 3.9], ["el", 4.21], ["sábado", 4.53], ["hay", 4.84], ["una", 5.15], ["fiesta", 5.46], ["en", 5.78], ["mi", 6.09], ["casa.", 6.4], ["¿Quieres", 6.71], ["venir?", 7.03], ["Y", 7.34], ["tú,", 7.65], ["desde", 7.96], ["lejos,", 8.28], ["piensas", 8.59], ["sin", 8.9], ["poder", 9.21], ["evitarlo:", 9.53], ["\"Dile", 9.84], ["que", 10.15], ["no,", 10.46], ["dile", 10.78], ["que", 11.09], ["no,", 11.4], ["dile", 11.71], ["que", 12.03], ["no\".", 12.34], ["Y", 12.65], ["luego,", 12.96], ["más", 13.28], ["bajito:", 13.59], ["\"No…", 13.9], ["mejor", 14.21], ["que", 14.53], ["haga", 14.84], ["lo", 15.15], ["que", 15.46], ["la", 15.78], ["haga", 16.09], ["feliz\".", 16.4], ["Sofía", 16.71], ["escuchó", 17.02], ["las", 17.34], ["dos", 17.65], ["cosas.", 17.96], ["Le", 18.27], ["sonríe", 18.59], ["a", 18.9], ["Mateo", 19.21], ["y", 19.52], ["le", 19.84], ["dice:", 20.15], ["—Gracias,", 20.46], ["pero", 20.77], ["el", 21.09], ["sábado", 21.4], ["ya", 21.71], ["tengo", 22.02], ["planes.", 22.34]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "chip": ["PENSAMIENTOS", "13", "OÍDOS"]}, "planos": [{"v": "patio;MT=riendo@0.3;S=normal@0.68", "f": "En el recreo, Mateo, el capitán del equipo, se acerca a Sofía."}, {"v": "patio;MT=sonrojado@0.5;cu", "f": "—Oye, el sábado hay una fiesta en mi casa. ¿Quieres venir?"}, {"v": "patio;X=enojado@0.5;cu;th:dile que no…", "f": "Y tú, desde lejos, piensas sin poder evitarlo: \"Dile que no, dile que no, dile que no\"."}, {"v": "patio;X=preocupado@0.5;cu;th:…o mejor que sea feliz", "f": "Y luego, más bajito: \"No… mejor que haga lo que la haga feliz\"."}, {"v": "patio;S=pensando@0.62;X=preocupado@0.28;fx:rayo", "f": "Sofía escuchó las dos cosas."}, {"v": "patio;S=riendo@0.5;cu", "f": "Le sonríe a Mateo y le dice: —Gracias, pero el sábado ya tengo planes."}]}, {"tipo": "planos", "titulo": "", "frames": 456, "words": [["En", 0.15], ["la", 0.46], ["cafetería", 0.78], ["se", 1.09], ["te", 1.4], ["ocurre", 1.71], ["un", 2.02], ["plan", 2.34], ["genial", 2.65], ["para", 2.96], ["esconder", 3.27], ["tus", 3.59], ["pensamientos.", 3.9], ["Cantas", 4.21], ["el", 4.53], ["abecedario", 4.84], ["en", 5.15], ["tu", 5.46], ["cabeza.", 5.78], ["Una", 6.09], ["y", 6.4], ["otra", 6.71], ["vez.", 7.03], ["Sofía", 7.34], ["pasa", 7.65], ["junto", 7.96], ["a", 8.28], ["tu", 8.59], ["mesa", 8.9], ["y", 9.21], ["te", 9.53], ["susurra:", 9.84], ["—Te", 10.15], ["saltaste", 10.46], ["la", 10.78], ["eme.", 11.09], ["Ya", 11.4], ["está.", 11.71], ["Lo", 12.03], ["sabe.", 12.34], ["Sabe", 12.65], ["que", 12.96], ["puedes", 13.28], ["saber", 13.59], ["que", 13.9], ["ella", 14.21], ["sabe.", 14.53]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "chip": ["PENSAMIENTOS", "15", "OÍDOS"]}, "planos": [{"v": "comedor;X=normal@0.5", "f": "En la cafetería se te ocurre un plan genial para esconder tus pensamientos."}, {"v": "comedor;X=riendo@0.5;cu;th:A, B, C, D, E…", "f": "Cantas el abecedario en tu cabeza. Una y otra vez."}, {"v": "comedor;S=riendo@0.62;X=riendo@0.28", "f": "Sofía pasa junto a tu mesa y te susurra: —Te saltaste la eme."}, {"v": "comedor;X=llorando@0.5;cu", "f": "Ya está. Lo sabe. Sabe que puedes saber que ella sabe."}]}, {"tipo": "planos", "titulo": "", "frames": 943, "words": [["Sales", 0.15], ["corriendo", 0.46], ["del", 0.78], ["colegio.", 1.09], ["Caminas", 1.4], ["a", 1.71], ["casa", 2.02], ["repasando", 2.34], ["todo", 2.65], ["lo", 2.96], ["que", 3.27], ["pensaste", 3.59], ["hoy.", 3.9], ["Lo", 4.21], ["bonita", 4.53], ["que", 4.84], ["se", 5.15], ["ve.", 5.46], ["Lo", 5.78], ["de", 6.09], ["la", 6.4], ["pizza.", 6.71], ["Lo", 7.03], ["de", 7.34], ["Mateo.", 7.65], ["Cada", 7.96], ["pensamiento", 8.28], ["te", 8.59], ["da", 8.9], ["más", 9.21], ["vergüenza", 9.53], ["que", 9.84], ["el", 10.15], ["anterior.", 10.46], ["Si", 10.78], ["pudieras,", 11.09], ["te", 11.4], ["mudarías", 11.71], ["a", 12.03], ["otro", 12.34], ["país.", 12.65], ["A", 12.96], ["otro", 13.28], ["planeta.", 13.59], ["Tu", 13.9], ["mamá", 14.21], ["te", 14.53], ["ve", 14.84], ["entrar", 15.15], ["empapado", 15.46], ["y", 15.78], ["te", 16.09], ["pregunta", 16.4], ["qué", 16.71], ["te", 17.02], ["pasó.", 17.34], ["Le", 17.65], ["dices", 17.96], ["que", 18.27], ["nada.", 18.59], ["Ella", 18.9], ["no", 19.21], ["te", 19.52], ["cree,", 19.84], ["pero", 20.15], ["te", 20.46], ["prepara", 20.77], ["chocolate", 21.09], ["caliente", 21.4], ["igual.", 21.71], ["Te", 22.02], ["tiras", 22.34], ["en", 22.65], ["la", 22.96], ["cama", 23.27], ["y", 23.59], ["piensas:", 23.9], ["\"Ya", 24.21], ["arruiné", 24.52], ["todo\".", 24.84], ["Pero", 25.15], ["entonces", 25.46], ["se", 25.77], ["te", 26.09], ["ocurre", 26.4], ["algo.", 26.71], ["Si", 27.02], ["ella", 27.34], ["puede", 27.65], ["escuchar", 27.96], ["lo", 28.27], ["que", 28.59], ["piensas…", 28.9], ["también", 29.21], ["puede", 29.52], ["escuchar", 29.84], ["la", 30.15], ["verdad", 30.46], ["completa.", 30.77]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "chip": ["PENSAMIENTOS", "16", "OÍDOS"]}, "planos": [{"v": "pasillo;X=llorando@0.5", "f": "Sales corriendo del colegio."}, {"v": "calle;X=preocupado@0.5;fx:lluvia", "f": "Caminas a casa repasando todo lo que pensaste hoy. Lo bonita que se ve. Lo de la pizza. Lo de Mateo."}, {"v": "calle;X=llorando@0.5;cu;fx:lluvia", "f": "Cada pensamiento te da más vergüenza que el anterior. Si pudieras, te mudarías a otro país. A otro planeta."}, {"v": "cocina;M=preocupado@0.62;X=llorando@0.28", "f": "Tu mamá te ve entrar empapado y te pregunta qué te pasó. Le dices que nada. Ella no te cree, pero te prepara chocolate caliente igual."}, {"v": "noche;X=llorando@0.5;cu;th:ya arruiné todo…", "f": "Te tiras en la cama y piensas: \"Ya arruiné todo\"."}, {"v": "noche;X=pensando@0.5;cu", "f": "Pero entonces se te ocurre algo. Si ella puede escuchar lo que piensas… también puede escuchar la verdad completa."}]}, {"tipo": "planos", "titulo": "", "frames": 690, "words": [["Al", 0.15], ["día", 0.46], ["siguiente", 0.78], ["la", 1.09], ["encuentras", 1.4], ["en", 1.71], ["la", 2.02], ["biblioteca.", 2.34], ["Te", 2.65], ["sientas", 2.96], ["frente", 3.27], ["a", 3.59], ["ella.", 3.9], ["No", 4.21], ["dices", 4.53], ["ni", 4.84], ["una", 5.15], ["palabra.", 5.46], ["Solo", 5.78], ["la", 6.09], ["miras…", 6.4], ["y", 6.71], ["piensas.", 7.03], ["Piensas", 7.34], ["en", 7.65], ["la", 7.96], ["primera", 8.28], ["vez", 8.59], ["que", 8.9], ["la", 9.21], ["viste", 9.53], ["dibujando", 9.84], ["junto", 10.15], ["a", 10.46], ["la", 10.78], ["ventana.", 11.09], ["En", 11.4], ["los", 11.71], ["seis", 12.03], ["meses", 12.34], ["que", 12.65], ["pasaste", 12.96], ["ensayando", 13.28], ["un", 13.59], ["\"hola\".", 13.9], ["En", 14.21], ["lo", 14.53], ["mucho", 14.84], ["que", 15.15], ["te", 15.46], ["gusta", 15.78], ["cómo", 16.09], ["se", 16.4], ["ríe.", 16.71], ["Sofía", 17.02], ["baja", 17.34], ["la", 17.65], ["mirada.", 17.96], ["Tiene", 18.27], ["los", 18.59], ["ojos", 18.9], ["brillantes.", 19.21], ["Y", 19.52], ["entonces", 19.84], ["te", 20.15], ["pregunta:", 20.46], ["—¿Quieres", 20.77], ["saber", 21.09], ["qué", 21.4], ["estoy", 21.71], ["pensando", 22.02], ["yo?", 22.34]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "chip": ["PENSAMIENTOS", "17", "OÍDOS"]}, "planos": [{"v": "biblio;S=normal@0.65;X=normal@0.28", "f": "Al día siguiente la encuentras en la biblioteca. Te sientas frente a ella."}, {"v": "biblio;X=sonrojado@0.5;cu", "f": "No dices ni una palabra. Solo la miras… y piensas."}, {"v": "biblio;X=sonrojado@0.5;cu;th:desde la primera vez que te vi…", "f": "Piensas en la primera vez que la viste dibujando junto a la ventana."}, {"v": "biblio;X=sonrojado@0.3;S=sonrojado@0.68;fx:rayo", "f": "En los seis meses que pasaste ensayando un \"hola\". En lo mucho que te gusta cómo se ríe."}, {"v": "biblio;S=llorando@0.5;cu", "f": "Sofía baja la mirada. Tiene los ojos brillantes."}, {"v": "biblio;S=sonrojado@0.5;cu", "f": "Y entonces te pregunta: —¿Quieres saber qué estoy pensando yo?"}]}, {"tipo": "planos", "titulo": "", "frames": 362, "words": [["Por", 0.15], ["un", 0.46], ["segundo,", 0.78], ["todo", 1.09], ["se", 1.4], ["queda", 1.71], ["en", 2.02], ["silencio.", 2.34], ["Y", 2.65], ["por", 2.96], ["primera", 3.27], ["vez,", 3.59], ["eres", 3.9], ["tú", 4.21], ["quien", 4.53], ["escucha", 4.84], ["un", 5.15], ["pensamiento", 5.46], ["que", 5.78], ["no", 6.09], ["es", 6.4], ["tuyo:", 6.71], ["\"Por", 7.03], ["fin\".", 7.34], ["Los", 7.65], ["dos", 7.96], ["se", 8.28], ["ríen", 8.59], ["tan", 8.9], ["fuerte", 9.21], ["que", 9.53], ["la", 9.84], ["bibliotecaria", 10.15], ["los", 10.46], ["manda", 10.78], ["a", 11.09], ["callar.", 11.4]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "chip": ["PENSAMIENTOS", "18", "OÍDOS"]}, "planos": [{"v": "biblio;X=sorprendido@0.5;cu", "f": "Por un segundo, todo se queda en silencio."}, {"v": "biblio;S=sonrojado@0.5;cu;th:por fin…", "f": "Y por primera vez, eres tú quien escucha un pensamiento que no es tuyo: \"Por fin\"."}, {"v": "biblio;X=riendo@0.3;S=riendo@0.68;fx:brillo", "f": "Los dos se ríen tan fuerte que la bibliotecaria los manda a callar."}]}, {"tipo": "planos", "titulo": "", "frames": 793, "words": [["A", 0.15], ["la", 0.46], ["mañana", 0.78], ["siguiente,", 1.09], ["el", 1.4], ["poder", 1.71], ["desaparece.", 2.02], ["Sofía", 2.34], ["ya", 2.65], ["no", 2.96], ["escucha", 3.27], ["lo", 3.59], ["que", 3.9], ["piensas.", 4.21], ["Pero", 4.53], ["ya", 4.84], ["no", 5.15], ["hace", 5.46], ["falta.", 5.78], ["Porque", 6.09], ["ahora", 6.4], ["se", 6.71], ["lo", 7.03], ["dices", 7.34], ["en", 7.65], ["voz", 7.96], ["alta.", 8.28], ["Ella", 8.59], ["te", 8.9], ["cuenta", 9.21], ["que", 9.53], ["también", 9.84], ["ensayaba", 10.15], ["\"holas\"", 10.46], ["en", 10.78], ["el", 11.09], ["espejo.", 11.4], ["Que", 11.71], ["también", 12.03], ["dibujaba", 12.34], ["pensando", 12.65], ["en", 12.96], ["ti.", 13.28], ["Que", 13.59], ["también", 13.9], ["tenía", 14.21], ["miedo.", 14.53], ["A", 14.84], ["veces", 15.15], ["lo", 15.46], ["que", 15.78], ["más", 16.09], ["miedo", 16.4], ["nos", 16.71], ["da", 17.02], ["decir…", 17.34], ["es", 17.65], ["justo", 17.96], ["lo", 18.27], ["que", 18.59], ["la", 18.9], ["otra", 19.21], ["persona", 19.52], ["necesita", 19.84], ["escuchar.", 20.15], ["Y", 20.46], ["tú,", 20.77], ["si", 21.09], ["tu", 21.4], ["crush", 21.71], ["pudiera", 22.02], ["escuchar", 22.34], ["un", 22.65], ["solo", 22.96], ["pensamiento", 23.27], ["tuyo,", 23.59], ["¿cuál", 23.9], ["sería?", 24.21], ["Te", 24.52], ["leo", 24.84], ["en", 25.15], ["los", 25.46], ["comentarios.", 25.77]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "chip": ["PENSAMIENTOS", "0", "OÍDOS"]}, "planos": [{"v": "cuarto;X=normal@0.5", "f": "A la mañana siguiente, el poder desaparece. Sofía ya no escucha lo que piensas."}, {"v": "patio;X=riendo@0.32;S=riendo@0.68;fx:brillo", "f": "Pero ya no hace falta. Porque ahora se lo dices en voz alta."}, {"v": "patio;S=riendo@0.5;cu", "f": "Ella te cuenta que también ensayaba \"holas\" en el espejo. Que también dibujaba pensando en ti. Que también tenía miedo."}, {"v": "patio;X=sonrojado@0.5;cu", "f": "A veces lo que más miedo nos da decir… es justo lo que la otra persona necesita escuchar."}, {"v": "neutro;X=pensando@0.5;ui:¿QUÉ PENSARÍAS?", "f": "Y tú, si tu crush pudiera escuchar un solo pensamiento tuyo, ¿cuál sería? Te leo en los comentarios."}]}]