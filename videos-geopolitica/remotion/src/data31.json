["piensas,", 10.14], ["sin", 10.71], ["querer.", 10.82], ["—¿Qué", 11.78], ["bonita", 11.91], ["se", 12.35], ["ve", 12.53], ["hoy?", 12.66], ["Sofía", 13.6], ["se", 14.1], ["da", 14.25], ["la", 14.39], ["vuelta", 14.5], ["de", 14.75], ["golpe.", 14.96], ["Te", 15.91], ["mira.", 16.05], ["Se", 16.98], ["pone", 17.19], ["roja", 17.46], ["como", 17.87], ["un", 18.07], ["tomate.", 18.23], ["—¿Qué", 19.19], ["dijiste?", 19.32], ["Tú", 20.25], ["no", 20.48], ["dijiste", 20.62], ["nada.", 21.03], ["Ni", 21.87], ["una", 22.03], ["palabra.", 22.21]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "chip": ["PENSAMIENTOS", "1", "OÍDOS"]}, "planos": [{"v": "entrada;X=normal@0.5", "f": "Es un lunes normal. Llegas al colegio medio dormido, con la gorra torcida."}, {"v": "entrada;S=riendo@0.62;X=sonrojado@0.28", "f": "Y ahí está Sofía, en la entrada, riéndose con sus amigas."}, {"v": "entrada;X=sonrojado@0.5;cu;th:qué bonita se ve hoy…", "f": "Y piensas, sin querer: \"Qué bonita se ve hoy\"."}, {"v": "entrada;S=sorprendido@0.62;X=sorprendido@0.28;fx:rayo", "f": "Sofía se da la vuelta de golpe. Te mira. Se pone roja como un tomate."}, {"v": "entrada;S=sonrojado@0.5;cu", "f": "—¿Qué dijiste?"}, {"v": "entrada;X=sorprendido@0.5;cu", "f": "Tú no dijiste nada. Ni una palabra."}]}, {"tipo": "planos", "titulo": "", "frames": 569, "words": [["En", 0.05], ["clase", 0.16], ["decides", 0.39], ["hacer", 0.8], ["una", 1.21], ["prueba.", 1.44], ["Te", 2.44], ["sientas", 2.53], ["detrás", 2.94], ["de", 3.28], ["ella", 3.44], ["y", 3.69], ["piensas,", 3.98], ["muy", 4.78], ["fuerte,", 5.07], ["una", 6.03], ["sola", 6.25], ["palabra.", 6.64], ["Pizza.", 7.87], ["Sofía", 8.73], ["se", 9.21], ["da", 9.35], ["la", 9.46], ["vuelta", 9.57], ["y", 9.91], ["susurra.", 10.25], ["—¿Pizza?", 11.35], ["Ay,", 12.44], ["no.", 12.96], ["Ella", 13.66], ["puede", 13.89], ["escuchar", 14.14], ["tus", 14.71], ["pensamientos.", 14.87], ["Solo", 16.3], ["ella.", 16.5], ["Y", 17.57], ["solo", 17.64], ["los", 17.91], ["tuyos.", 18.14]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "chip": ["PENSAMIENTOS", "2", "OÍDOS"]}, "planos": [{"v": "salon;X=pensando@0.5", "f": "En clase decides hacer una prueba. Te sientas detrás de ella y piensas, muy fuerte, una sola palabra."}, {"v": "salon;X=pensando@0.5;cu;th:PIZZA", "f": "Pizza."}, {"v": "salon;S=pensando@0.5;cu", "f": "Sofía se da la vuelta y susurra: —¿Pizza?"}, {"v": "salon;X=sorprendido@0.5;cu", "f": "Ay, no."}, {"v": "salon;X=preocupado@0.3;S=normal@0.68;fx:rayo", "f": "Ella puede escuchar tus pensamientos. Solo ella. Y solo los tuyos."}]}, {"tipo": "planos", "titulo": "", "frames": 556, "words": [["Entras", 0.05], ["en", 0.46], ["pánico.", 0.78], ["Intentas", 1.91], ["no", 2.46], ["pensar", 2.62], ["en", 2.94], ["nada.", 3.16], ["Pero", 3.85], ["cuando", 4.07], ["intentas", 4.28], ["no", 4.96], ["pensar", 5.1], ["en", 5.44], ["algo…", 5.69], ["es", 6.53], ["lo", 6.78], ["único", 6.98], ["en", 7.35], ["lo", 7.5], ["que", 7.62], ["piensas.", 7.75], ["No", 9.21], ["pienses", 9.48], ["en", 9.89], ["su", 10.1], ["pelo.", 10.23], ["No", 11.3], ["pienses", 11.46], ["en", 11.89], ["su", 12.1], ["pinza", 12.25], ["de", 12.62], ["estrella.", 12.75], ["No", 13.85], ["pienses", 13.98], ["en", 14.39], ["cómo", 14.62], ["se", 14.85], ["ríe.", 15.05], ["Sofía", 15.91], ["se", 16.44], ["tapa", 16.6], ["la", 16.89], ["boca", 17.0], ["para", 17.28], ["no", 17.55], ["reírse.", 17.73]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "chip": ["PENSAMIENTOS", "5", "OÍDOS"]}, "planos": [{"v": "salon;X=preocupado@0.5;cu", "f": "Entras en pánico. Intentas no pensar en nada."}, {"v": "salon;X=preocupado@0.5;cu;th:no pienses en su pelo…", "f": "Pero cuando intentas no pensar en algo… es lo único en lo que piensas."}, {"v": "salon;X=llorando@0.5;cu;th:ni en su pinza de estrella…", "f": "No pienses en su pelo. No pienses en su pinza de estrella. No pienses en cómo se ríe."}, {"v": "salon;S=riendo@0.5;cu", "f": "Sofía se tapa la boca para no reírse."}]}, {"tipo": "planos", "titulo": "", "frames": 565, "words": [["El", 0.05], ["profesor", 0.14], ["explica", 0.64], ["fracciones.", 1.07], ["Tú", 2.35], ["intentas", 2.44], ["concentrarte.", 3.0], ["Pero", 4.35], ["tu", 4.55], ["cerebro", 4.71], ["decide", 5.14], ["hacer", 5.44], ["poesía.", 5.78], ["Su", 6.75], ["pinza", 6.94], ["de", 7.39], ["estrella", 7.53], ["brilla…", 7.89], ["como", 8.66], ["ella.", 8.89], ["Sofía", 9.91], ["suelta", 10.46], ["una", 10.87], ["carcajada", 11.05], ["en", 11.71], ["plena", 11.87], ["clase.", 12.21], ["—Señorita,", 13.3], ["¿le", 14.44], ["parecen", 14.55], ["graciosas", 14.96], ["las", 15.55], ["fracciones?", 15.71], ["—No,", 16.89], ["profe…", 17.35], ["perdón.", 18.0]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "chip": ["PENSAMIENTOS", "7", "OÍDOS"]}, "planos": [{"v": "salon;T=normal@0.6;X=pensando@0.25", "f": "El profesor explica fracciones. Tú intentas concentrarte."}, {"v": "salon;X=pensando@0.5;cu;th:su pinza brilla… como ella", "f": "Pero tu cerebro decide hacer poesía: \"Su pinza de estrella brilla… como ella\"."}, {"v": "salon;S=riendo@0.5;cu", "f": "Sofía suelta una carcajada en plena clase."}, {"v": "salon;T=enojado@0.5;cu", "f": "—Señorita, ¿le parecen graciosas las fracciones?"}, {"v": "salon;S=sonrojado@0.62;X=sonrojado@0.28", "f": "—No, profe… perdón."}]}, {"tipo": "planos", "titulo": "", "frames": 567, "words": [["Te", 0.05], ["hundes", 0.14], ["en", 0.53], ["tu", 0.69], ["silla", 0.85], ["y", 1.21], ["piensas,", 1.55], ["triste.", 2.41], ["Ojalá", 3.5], ["algún", 4.03], ["día", 4.28], ["me", 4.48], ["hablara.", 4.69], ["Dos", 5.73], ["segundos", 6.03], ["después,", 6.41], ["un", 7.16], ["papelito", 7.32], ["cae", 7.87], ["sobre", 8.25], ["tu", 8.46], ["pupitre.", 8.71], ["Dice,", 9.57], ["te", 10.55], ["estoy", 10.73], ["hablando,", 11.0], ["tonto.", 11.66], ["Tu", 12.8], ["cerebro", 13.03], ["se", 13.46], ["apaga", 13.66], ["por", 14.0], ["completo.", 14.23], ["Y", 15.21], ["por", 15.46], ["primera", 15.64], ["vez", 15.98], ["en", 16.3], ["todo", 16.48], ["el", 16.73], ["día,", 16.89], ["no", 17.44], ["piensas", 17.6], ["en", 18.19], ["nada.", 18.32]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "chip": ["PENSAMIENTOS", "9", "OÍDOS"]}, "planos": [{"v": "salon;X=pensando@0.5;cu;th:ojalá me hablara…", "f": "Te hundes en tu silla y piensas, triste: \"Ojalá algún día me hablara\"."}, {"v": "salon;S=normal@0.62;X=normal@0.28;fx:carta", "f": "Dos segundos después, un papelito cae sobre tu pupitre."}, {"v": "neutro;fx:carta", "f": "Dice: \"Te estoy hablando, tonto\"."}, {"v": "salon;X=sorprendido@0.5;cu", "f": "Tu cerebro se apaga por completo. Y por primera vez en todo el día, no piensas en nada."}]}, {"tipo": "planos", "titulo": "", "frames": 939, "words": [["Y", 0.05], ["como", 0.14], ["el", 0.37], ["universo", 0.5], ["tiene", 0.66], ["sentido", 1.23], ["del", 1.66], ["humor,", 1.91], ["el", 2.6], ["profesor", 2.69], ["anuncia.", 3.23], ["Hoy", 4.46], ["hay", 4.66], ["exposiciones.", 4.85], ["Empieza…", 7.23], ["usted.", 7.82], ["Te", 8.96], ["toca", 9.23], ["a", 9.55], ["ti.", 9.73], ["Delante", 10.32], ["de", 10.73], ["toda", 10.91], ["la", 11.25], ["clase.", 11.44], ["Delante", 12.25], ["de", 12.71], ["ella.", 12.94], ["Te", 13.64], ["paras", 13.78], ["frente", 14.05], ["al", 14.41], ["pizarrón.", 14.66], ["Te", 15.8], ["iemblan", 15.91], ["las", 16.39], ["piernas.", 16.62], ["Y", 17.69], ["tu", 17.73], ["cabeza", 17.87], ["no", 18.14], ["ayuda.", 18.44], ["No", 19.3], ["la", 19.5], ["mires,", 19.64], ["no", 20.32], ["la", 20.5], ["mires,", 20.64], ["no", 21.39], ["la", 21.55], ["mires.", 21.69], ["La", 22.62], ["miras.", 22.78], ["Ella", 23.71], ["te", 23.94], ["levanta", 24.12], ["el", 24.53], ["pulgar.", 24.6], ["Y", 25.6], ["de", 25.69], ["repente,", 25.8], ["la", 26.6], ["exposición", 26.64], ["te", 27.37], ["sale", 27.55], ["perfecta.", 27.8], ["Sacas", 28.98], ["la", 29.5], ["mejor", 29.66], ["nota", 29.98], ["de", 30.3], ["la", 30.48], ["clase.", 30.6]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "chip": ["PENSAMIENTOS", "11", "OÍDOS"]}, "planos": [{"v": "salon;T=normal@0.5;cu", "f": "Y como el universo tiene sentido del humor, el profesor anuncia: —Hoy hay exposiciones. Empieza… usted."}, {"v": "salon;X=sorprendido@0.5;cu", "f": "Te toca a ti. Delante de toda la clase. Delante de ella."}, {"v": "salon;X=preocupado@0.5;ui:EXPOSICIÓN", "f": "Te paras frente al pizarrón. Te tiemblan las piernas."}, {"v": "salon;X=preocupado@0.5;cu;th:no la mires, no la mires…", "f": "Y tu cabeza no ayuda: \"No la mires, no la mires, no la mires…\"."}, {"v": "salon;S=riendo@0.5;cu", "f": "La miras. Ella te levanta el pulgar."}, {"v": "salon;X=riendo@0.5;cu;th:¡me levantó el pulgar!", "f": "Y de repente, la exposición te sale perfecta. Sacas la mejor nota de la clase."}]}, {"tipo": "planos", "titulo": "", "frames": 669, "words": [["Tu", 0.05], ["mejor", 0.14], ["amiga,", 0.37], ["Camila,", 0.85], ["te", 1.57], ["mira", 1.69], ["con", 1.85], ["los", 2.03], ["ojos", 2.16], ["entrecerrados.", 2.41], ["—Hoy", 4.05], ["estás", 4.23], ["rarísimo.", 4.46], ["Y", 5.78], ["Sofía", 5.87], ["no", 6.35], ["deja", 6.71], ["de", 6.98], ["mirarte.", 7.12], ["—¿Qué", 8.07], ["está", 8.16], ["pasando?", 8.35], ["Piensas.", 9.57], ["—No", 10.73], ["le", 10.85], ["digas,", 10.96], ["no", 11.82], ["le", 12.03], ["digas.", 12.14], ["Pero", 12.98], ["Camila", 13.25], ["te", 13.69], ["conoce", 13.85], ["desde", 14.3], ["el", 14.5], ["kínder.", 14.73], ["—Ay,", 15.94], ["por", 16.32], ["fin.", 16.41], ["Ya", 17.23], ["era", 17.39], ["hora", 17.53], ["de", 17.75], ["que", 17.94], ["ella", 18.05], ["se", 18.23], ["diera", 18.44], ["cuenta.", 18.66], ["Llevas", 19.66], ["meses", 19.89], ["suspirando", 20.25], ["como", 21.21], ["una", 21.44], ["novela.", 21.64]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "chip": ["PENSAMIENTOS", "12", "OÍDOS"]}, "planos": [{"v": "comedor;C=pensando@0.62;X=normal@0.28", "f": "Tu mejor amiga, Camila, te mira con los ojos entrecerrados."}, {"v": "comedor;C=pensando@0.5;cu", "f": "—Hoy estás rarísimo. Y Sofía no deja de mirarte. ¿Qué está pasando?"}, {"v": "comedor;X=sonrojado@0.5;cu;th:no le digas, no le digas…", "f": "Piensas: \"No le digas, no le digas\". Pero Camila te conoce desde el kínder."}, {"v": "comedor;C=riendo@0.5;cu", "f": "—Ay, por fin. Ya era hora de que ella se diera cuenta. Llevas meses suspirando como una novela."}]}, {"tipo": "planos", "titulo": "", "frames": 825, "words": [["En", 0.05], ["el", 0.19], ["recreo,", 0.32], ["Mateo,", 1.1], ["el", 1.69], ["capitán", 1.8], ["del", 2.28], ["equipo,", 2.44], ["se", 3.3], ["acerca", 3.37], ["a", 3.78], ["Sofía.", 3.96], ["—Oye,", 5.19], ["el", 5.62], ["sábado", 5.73], ["hay", 6.12], ["una", 6.32], ["fiesta", 6.48], ["en", 6.85], ["mi", 6.96], ["casa.", 7.07], ["¿Quieres", 7.94], ["venir?", 8.19], ["Y", 9.07], ["tú,", 9.19], ["desde", 9.69], ["lejos,", 9.78], ["piensas", 10.62], ["sin", 11.03], ["poder", 11.19], ["evitarlo.", 11.46], ["Dile", 12.6], ["que", 12.82], ["no,", 13.03], ["dile", 13.5], ["que", 13.71], ["no,", 13.98], ["dile", 14.41], ["que", 14.55], ["no.", 14.8], ["Y", 15.32], ["luego,", 15.53], ["más", 15.98], ["bajito.", 16.28], ["—No,", 17.35], ["mejor", 18.0], ["que", 18.3], ["haga", 18.48], ["lo", 18.64], ["que", 18.8], ["la", 18.91], ["haga", 19.05], ["feliz.", 19.21], ["Sofía", 20.25], ["escuchó", 20.71], ["las", 21.12], ["dos", 21.28], ["cosas.", 21.44], ["Le", 22.39], ["sonrí", 22.48], ["a", 22.87], ["Mateo", 23.0], ["y", 23.55], ["le", 23.73], ["dice", 23.85], ["—Gracias,", 24.12], ["pero", 25.62], ["el", 25.71], ["sábado", 25.89], ["ya", 26.25], ["tengo", 26.41], ["planes.", 26.71]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "chip": ["PENSAMIENTOS", "13", "OÍDOS"]}, "planos": [{"v": "patio;MT=riendo@0.3;S=normal@0.68", "f": "En el recreo, Mateo, el capitán del equipo, se acerca a Sofía."}, {"v": "patio;MT=sonrojado@0.5;cu", "f": "—Oye, el sábado hay una fiesta en mi casa. ¿Quieres venir?"}, {"v": "patio;X=enojado@0.5;cu;th:dile que no…", "f": "Y tú, desde lejos, piensas sin poder evitarlo: \"Dile que no, dile que no, dile que no\"."}, {"v": "patio;X=preocupado@0.5;cu;th:…o mejor que sea feliz", "f": "Y luego, más bajito: \"No… mejor que haga lo que la haga feliz\"."}, {"v": "patio;S=pensando@0.62;X=preocupado@0.28;fx:rayo", "f": "Sofía escuchó las dos cosas."}, {"v": "patio;S=riendo@0.5;cu", "f": "Le sonríe a Mateo y le dice: —Gracias, pero el sábado ya tengo planes."}]}, {"tipo": "planos", "titulo": "", "frames": 565, "words": [["En", 0.05], ["la", 0.19], ["cafetería", 0.3], ["se", 1.05], ["te", 1.37], ["ocurre", 1.53], ["un", 1.91], ["plan", 2.03], ["genial", 2.35], ["para", 2.91], ["esconder", 3.28], ["tus", 3.71], ["pensamientos.", 3.91], ["Cantas", 5.3], ["el", 5.94], ["abecedario", 6.05], ["en", 6.64], ["tu", 6.75], ["cabeza.", 6.87], ["Una", 7.91], ["y", 8.19], ["otra", 8.6], ["vez.", 8.75], ["Sofía", 9.8], ["pasa", 10.3], ["junto", 10.57], ["a", 10.89], ["tu", 11.1], ["mesa", 11.21], ["y", 11.5], ["te", 11.75], ["susurra.", 11.87], ["Te", 13.03], ["saltaste", 13.14], ["la", 13.64], ["eme.", 13.8], ["Ya", 14.62], ["está.", 14.75], ["Lo", 15.66], ["sabe.", 15.8], ["Sabe", 16.62], ["que", 16.96], ["puedes", 17.1], ["saber", 17.41], ["que", 17.73], ["ella", 17.96], ["sabe.", 18.16]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "chip": ["PENSAMIENTOS", "15", "OÍDOS"]}, "planos": [{"v": "comedor;X=normal@0.5", "f": "En la cafetería se te ocurre un plan genial para esconder tus pensamientos."}, {"v": "comedor;X=riendo@0.5;cu;th:A, B, C, D, E…", "f": "Cantas el abecedario en tu cabeza. Una y otra vez."}, {"v": "comedor;S=riendo@0.62;X=riendo@0.28", "f": "Sofía pasa junto a tu mesa y te susurra: —Te saltaste la eme."}, {"v": "comedor;X=llorando@0.5;cu", "f": "Ya está. Lo sabe. Sabe que puedes saber que ella sabe."}]}, {"tipo": "planos", "titulo": "", "frames": 1102, "words": [["Salas", 0.05], ["corriendo", 0.44], ["del", 0.96], ["colegio.", 1.16], ["Caminas", 2.23], ["a", 2.69], ["casa", 2.91], ["repasando", 3.14], ["todo", 3.85], ["lo", 4.21], ["que", 4.37], ["pensaste", 4.48], ["hoy.", 4.98], ["Lo", 5.94], ["bonita", 6.12], ["que", 6.5], ["se", 6.66], ["ve.", 6.82], ["Lo", 7.6], ["de", 7.82], ["la", 7.94], ["pizza.", 8.05], ["Lo", 8.82], ["de", 9.1], ["Mateo.", 9.21], ["Cada", 10.19], ["pensamiento", 10.37], ["te", 10.96], ["da", 11.25], ["más", 11.39], ["vergüenza", 11.6], ["que", 12.14], ["el", 12.3], ["anterior.", 12.41], ["Si", 13.62], ["pudieras,", 13.87], ["te", 14.75], ["mudarías", 14.94], ["a", 15.44], ["otro", 15.62], ["país.", 15.85], ["A", 16.73], ["otro", 16.89], ["planeta.", 17.14], ["Tu", 18.21], ["mamá", 18.35], ["te", 18.62], ["ve", 18.78], ["entrar", 18.87], ["empapado", 19.19], ["y", 19.75], ["te", 19.89], ["pregunta", 19.98], ["qué", 20.37], ["te", 20.64], ["pasó.", 20.78], ["Le", 21.71], ["dices", 21.85], ["que", 22.14], ["nada.", 22.32], ["Ella", 23.12], ["no", 23.32], ["te", 23.55], ["cree,", 23.66], ["pero", 24.28], ["te", 24.53], ["prepara", 24.66], ["chocolate", 25.05], ["caliente", 25.3], ["igual.", 25.94], ["Te", 26.87], ["tiras", 27.03], ["en", 27.23], ["la", 27.41], ["cama", 27.53], ["y", 27.75], ["piensas.", 27.89], ["Ya", 28.85], ["arruiné", 29.07], ["todo.", 29.5], ["Pero", 30.16], ["entonces", 30.37], ["se", 30.75], ["te", 31.05], ["ocurre", 31.12], ["algo.", 31.44], ["Si", 32.07], ["ella", 32.37], ["puede", 32.57], ["escuchar", 32.78], ["lo", 33.32], ["que", 33.41], ["piensas…", 33.53], ["también", 34.12], ["puede", 34.91], ["escuchar", 35.12], ["la", 35.62], ["verdad", 35.69], ["completa.", 35.89]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "chip": ["PENSAMIENTOS", "16", "OÍDOS"]}, "planos": [{"v": "pasillo;X=llorando@0.5", "f": "Sales corriendo del colegio."}, {"v": "calle;X=preocupado@0.5;fx:lluvia", "f": "Caminas a casa repasando todo lo que pensaste hoy. Lo bonita que se ve. Lo de la pizza. Lo de Mateo."}, {"v": "calle;X=llorando@0.5;cu;fx:lluvia", "f": "Cada pensamiento te da más vergüenza que el anterior. Si pudieras, te mudarías a otro país. A otro planeta."}, {"v": "cocina;M=preocupado@0.62;X=llorando@0.28", "f": "Tu mamá te ve entrar empapado y te pregunta qué te pasó. Le dices que nada. Ella no te cree, pero te prepara chocolate caliente igual."}, {"v": "noche;X=llorando@0.5;cu;th:ya arruiné todo…", "f": "Te tiras en la cama y piensas: \"Ya arruiné todo\"."}, {"v": "noche;X=pensando@0.5;cu", "f": "Pero entonces se te ocurre algo. Si ella puede escuchar lo que piensas… también puede escuchar la verdad completa."}]}, {"tipo": "planos", "titulo": "", "frames": 804, "words": [["Al", 0.05], ["día", 0.19], ["siguiente", 0.35], ["la", 0.62], ["encuentras", 0.91], ["en", 1.41], ["la", 1.55], ["biblioteca.", 1.66], ["Te", 2.73], ["sientas", 2.82], ["frente", 3.23], ["a", 3.5], ["ella.", 3.73], ["No", 4.6], ["dices", 4.8], ["ni", 5.16], ["una", 5.41], ["palabra.", 5.6], ["Solo", 6.69], ["la", 7.1], ["miras…", 7.3], ["y", 8.07], ["piensas.", 8.3], ["Piensas", 9.48], ["en", 10.0], ["la", 10.12], ["primera", 10.21], ["vez", 10.46], ["que", 10.78], ["la", 10.94], ["viste", 11.05], ["dibujando", 11.28], ["junto", 11.87], ["a", 12.1], ["la", 12.28], ["ventana.", 12.35], ["En", 13.28], ["los", 13.37], ["seis", 13.5], ["meses", 13.75], ["que", 14.05], ["pasaste", 14.3], ["ensayando", 14.73], ["un", 15.3], ["—hola.", 15.55], ["En", 16.8], ["lo", 16.91], ["mucho", 17.03], ["que", 17.28], ["te", 17.44], ["gusta", 17.57], ["cómo", 17.82], ["se", 18.23], ["ríe.", 18.46], ["Sofía", 19.32], ["baja", 19.8], ["la", 20.07], ["mirada.", 20.25], ["Tiene", 21.21], ["los", 21.44], ["ojos", 21.62], ["brillantes.", 21.85], ["Y", 22.94], ["entonces", 23.03], ["te", 23.32], ["pregunta", 23.6], ["¿Quieres", 23.96], ["saber", 25.0], ["qué", 25.23], ["estoy", 25.48], ["pensando", 25.75], ["yo?", 26.12]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "chip": ["PENSAMIENTOS", "17", "OÍDOS"]}, "planos": [{"v": "biblio;S=normal@0.65;X=normal@0.28", "f": "Al día siguiente la encuentras en la biblioteca. Te sientas frente a ella."}, {"v": "biblio;X=sonrojado@0.5;cu", "f": "No dices ni una palabra. Solo la miras… y piensas."}, {"v": "biblio;X=sonrojado@0.5;cu;th:desde la primera vez que te vi…", "f": "Piensas en la primera vez que la viste dibujando junto a la ventana."}, {"v": "biblio;X=sonrojado@0.3;S=sonrojado@0.68;fx:rayo", "f": "En los seis meses que pasaste ensayando un \"hola\". En lo mucho que te gusta cómo se ríe."}, {"v": "biblio;S=llorando@0.5;cu", "f": "Sofía baja la mirada. Tiene los ojos brillantes."}, {"v": "biblio;S=sonrojado@0.5;cu", "f": "Y entonces te pregunta: —¿Quieres saber qué estoy pensando yo?"}]}, {"tipo": "planos", "titulo": "", "frames": 391, "words": [["Por", 0.05], ["un", 0.16], ["segundo,", 0.3], ["todo", 1.32], ["se", 1.55], ["queda", 1.78], ["en", 2.0], ["silencio.", 2.16], ["Y", 3.21], ["por", 3.41], ["primera", 3.57], ["vez,", 3.85], ["eres", 4.48], ["tú", 4.71], ["quien", 5.05], ["escucha", 5.21], ["un", 5.75], ["pensamiento", 5.85], ["que", 6.5], ["no", 6.71], ["es", 6.89], ["tuyo.", 7.05], ["Por", 7.8], ["fin.", 8.03], ["Los", 9.14], ["dos", 9.37], ["se", 9.57], ["ríen", 9.75], ["tan", 10.07], ["fuerte", 10.28], ["que", 10.6], ["la", 10.87], ["bibliotecaria", 11.0], ["los", 11.78], ["manda", 11.91], ["a", 12.35], ["callar.", 12.46]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "chip": ["PENSAMIENTOS", "18", "OÍDOS"]}, "planos": [{"v": "biblio;X=sorprendido@0.5;cu", "f": "Por un segundo, todo se queda en silencio."}, {"v": "biblio;S=sonrojado@0.5;cu;th:por fin…", "f": "Y por primera vez, eres tú quien escucha un pensamiento que no es tuyo: \"Por fin\"."}, {"v": "biblio;X=riendo@0.3;S=riendo@0.68;fx:brillo", "f": "Los dos se ríen tan fuerte que la bibliotecaria los manda a callar."}]}, {"tipo": "planos", "titulo": "", "frames": 859, "words": [["A", 0.05], ["la", 0.12], ["mañana", 0.21], ["siguiente,", 0.44], ["el", 1.23], ["poder", 1.28], ["desaparece.", 1.57], ["Sofía", 2.98], ["ya", 3.48], ["no", 3.78], ["escucha", 3.89], ["lo", 4.28], ["que", 4.37], ["piensas.", 4.46], ["Pero", 5.32], ["ya", 5.55], ["no", 5.73], ["hace", 5.82], ["falta.", 6.0], ["Porque", 6.87], ["ahora", 7.16], ["se", 7.46], ["lo", 7.71], ["dices", 7.85], ["en", 8.12], ["voz", 8.3], ["alta.", 8.44], ["Ella", 9.28], ["te", 9.46], ["cuenta", 9.94], ["que", 9.94], ["también", 10.1], ["ensayaba", 10.37], ["olas", 10.89], ["en", 11.53], ["el", 11.69], ["espejo.", 11.78], ["Que", 12.87], ["también", 12.94], ["dibujaba", 13.3], ["pensando", 13.73], ["en", 14.05], ["ti.", 14.39], ["Que", 15.1], ["también", 15.21], ["tenía", 15.55], ["miedo.", 15.78], ["A", 16.82], ["veces", 16.98], ["lo", 17.19], ["que", 17.41], ["más", 17.55], ["miedo", 17.78], ["nos", 18.07], ["da", 18.25], ["decir…", 18.39], ["es", 19.32], ["justo", 19.5], ["lo", 19.8], ["que", 20.03], ["la", 20.12], ["otra", 20.23], ["persona", 20.39], ["necesita", 20.82], ["escuchar.", 21.12], ["Y", 22.39], ["tú,", 22.55], ["si", 22.94], ["tu", 23.03], ["crush", 23.16], ["pudiera", 23.46], ["escuchar", 23.89], ["un", 24.32], ["solo", 24.46], ["pensamiento", 24.71], ["tuyo,", 25.3], ["¿cuál", 26.05], ["sería?", 26.16], ["Te", 27.05], ["leo", 27.21], ["en", 27.48], ["los", 27.55], ["comentarios.", 27.66]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "chip": ["PENSAMIENTOS", "0", "OÍDOS"]}, "planos": [{"v": "cuarto;X=normal@0.5", "f": "A la mañana siguiente, el poder desaparece. Sofía ya no escucha lo que piensas."}, {"v": "patio;X=riendo@0.32;S=riendo@0.68;fx:brillo", "f": "Pero ya no hace falta. Porque ahora se lo dices en voz alta."}, {"v": "patio;S=riendo@0.5;cu", "f": "Ella te cuenta que también ensayaba \"holas\" en el espejo. Que también dibujaba pensando en ti. Que también tenía miedo."}, {"v": "patio;X=sonrojado@0.5;cu", "f": "A veces lo que más miedo nos da decir… es justo lo que la otra persona necesita escuchar."}, {"v": "neutro;X=pensando@0.5;ui:¿QUÉ PENSARÍAS?", "f": "Y tú, si tu crush pudiera escuchar un solo pensamiento tuyo, ¿cuál sería? Te leo en los comentarios."}]}]