ada", 6.4], ["en", 6.71], ["la", 7.03], ["boca,", 7.34], ["chocando", 7.65], ["con", 7.96], ["una", 8.28], ["chica", 8.59], ["con", 8.9], ["pinza", 9.21], ["de", 9.53], ["estrella.", 9.84], ["Abajo", 10.15], ["dice:", 10.46], ["\"La", 10.78], ["carta", 11.09], ["de", 11.4], ["Mateo", 11.71], ["era", 12.03], ["para", 12.34], ["mi", 12.65], ["amiga.", 12.96], ["Él", 13.28], ["es", 13.59], ["muy", 13.9], ["tímido.", 14.21], ["Como", 14.53], ["tú.\"", 14.84], ["\"Posdata:", 15.15], ["los", 15.46], ["pulpos", 15.78], ["sí", 16.09], ["tienen", 16.4], ["tres", 16.71], ["corazones.", 17.02], ["Lo", 17.34], ["busqué.\"", 17.65]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "chip": ["VERGÜENZA", "30%"]}, "planos": [{"v": "pasillo;X=preocupado@0.5", "f": "Al día siguiente encuentras algo dentro de tu casillero. Una hoja doblada."}, {"v": "neutro;fx:dibujos", "f": "Un dibujo. Un chico con gorra, con una tostada en la boca, chocando con una chica con pinza de estrella."}, {"v": "pasillo;X=sorprendido@0.5;fx:carta;cu", "f": "Abajo dice: \"La carta de Mateo era para mi amiga. Él es muy tímido. Como tú.\""}, {"v": "pasillo;X=riendo@0.5;cu", "f": "\"Posdata: los pulpos sí tienen tres corazones. Lo busqué.\""}]}, {"tipo": "planos", "titulo": "", "frames": 502, "words": [["Esta", 0.15], ["vez", 0.46], ["no", 0.78], ["ensayas", 1.09], ["nada.", 1.4], ["La", 1.71], ["buscas", 2.02], ["en", 2.34], ["la", 2.65], ["biblioteca,", 2.96], ["en", 3.27], ["la", 3.59], ["mesa", 3.9], ["de", 4.21], ["siempre.", 4.53], ["Te", 4.84], ["sientas", 5.15], ["frente", 5.46], ["a", 5.78], ["ella.", 6.09], ["Respiras.", 6.4], ["Y", 6.71], ["dices,", 7.03], ["por", 7.34], ["fin,", 7.65], ["bien", 7.96], ["clarito:", 8.28], ["—Hola,", 8.59], ["Sofía.", 8.9], ["Ella", 9.21], ["levanta", 9.53], ["la", 9.84], ["vista,", 10.15], ["sonríe", 10.46], ["y", 10.78], ["responde:", 11.09], ["—Hola…", 11.4], ["tostada.", 11.71], ["Los", 12.03], ["dos", 12.34], ["se", 12.65], ["ríen", 12.96], ["tan", 13.