, {"tipo": "planos", "titulo": "", "frames": 624, "words": [["—¿Ese…", 0.15], ["soy", 0.46], ["yo?", 0.78], ["—preguntas.", 1.09], ["Ella", 1.4], ["cierra", 1.71], ["el", 2.02], ["cuaderno", 2.34], ["de", 2.65], ["golpe:", 2.96], ["—Es…", 3.27], ["un", 3.59], ["personaje.", 3.9], ["Inventado.", 4.21], ["Muy", 4.53], ["feo.", 4.84], ["—Ah.", 5.15], ["Bueno.", 5.46], ["Tiene", 5.78], ["buena", 6.09], ["gorra.", 6.4], ["Por", 6.71], ["primera", 7.03], ["vez", 7.34], ["se", 7.65], ["ríen", 7.96], ["los", 8.28], ["dos", 8.59], ["al", 8.9], ["mismo", 9.21], ["tiempo.", 9.53], ["Y", 9.84], ["descubres", 10.15], ["que", 10.46], ["a", 10.78], ["ella", 11.09], ["también", 11.4], ["le", 11.71], ["gustan", 12.03], ["los", 12.34], ["documentales", 12.65], ["de", 12.96], ["animales", 13.28], ["raros,", 13.59], ["que", 13.9], ["odia", 14.21], ["las", 14.53], ["aceitunas", 14.84], ["y", 15.15], ["que", 15.46], ["también", 15.78], ["ensaya", 16.09], ["conversaciones", 16.4], ["en", 16.71], ["el", 17.02], ["espejo.", 17.34], ["Por", 17.65], ["un", 17.96], ["rato", 18.27], ["se", 18.59], ["te", 18.9], ["olvida", 19.21], ["que", 19.52], ["estás", 19.84], ["nervioso.", 20.15]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "chip": ["VERGÜENZA", "40%"]}, "planos": [{"v": "comedor;X=sorprendido@0.5;cu", "f": "—¿Ese… soy yo? —preguntas."}, {"v": "comedor;S=sonrojado@0.5;cu", "f": "Ella cierra el cuaderno de golpe: —Es… un personaje. Inventado. Muy feo."}, {"v": "comedor;X=riendo@0.5;cu", "f": "—Ah. Bueno. Tiene buena gorra."}, {"v": "comedor;X=riendo@0.3;S=riendo@0.68;fx:brillo", "f": "Por primera vez se ríen los dos al mismo tiempo."}, {"v": "comedor;S=riendo@0.5;cu", "f": "Y descubres que a ella también le gustan los documentales de animales raros, que odia las aceitunas y que también ensaya conversaciones en el espejo."}, {"v": "comedor;X=sonrojado@0.5", "f": "Por un rato se te olvida que estás nervioso."}]}, {"tipo": "planos", "titulo": "", "frames": 549, "words": [["A", 