, ["con", 1.64], ["tu", 1.82], ["crush", 2.05], ["en", 2.39], ["el", 2.69], ["peor", 2.82], ["momento?", 3.32]], "caps": [], "p": {"esc": null, "med": null, "flash": true, "chip": null}, "planos": [{"v": "tit", "f": "¿Qué pasaría si te encontraras con tu crush en el peor momento?"}]}, {"tipo": "planos", "titulo": "", "frames": 774, "words": [["Suena", 0.05], ["la", 0.41], ["alarma.", 0.6], ["Son", 1.78], ["las", 1.94], ["siete", 2.14], ["y", 2.5], ["cuarenta.", 2.71], ["Tu", 4.03], ["clase", 4.16], ["empieza", 4.5], ["a", 5.12], ["las", 5.41], ["ocho.", 5.57], ["Saltas", 6.55], ["de", 6.91], ["la", 7.05], ["cama", 7.19], ["como", 7.46], ["si", 7.73], ["el", 7.94], ["piso", 8.07], ["quemara.", 8.37], ["Te", 9.41], ["pones", 9.57], ["lo", 9.87], ["primero", 10.03], ["que", 10.32], ["encuentras.", 10.53], ["La", 11.75], ["gorra", 11.91], ["de", 12.21], ["siempre,", 12.35], ["la", 13.32], ["sudadera", 13.46], ["verde", 13.94], ["y", 14.28], ["un", 15.03], ["calcetín", 15.16], ["de", 15.85], ["cada", 16.05], ["color.", 16.37], ["Sales", 17.41], ["corriendo", 17.75], ["con", 18.37], ["una", 18.6], ["tostada", 18.75], ["en", 19.19], ["la", 19.28], ["boca,", 19.39], ["como", 20.12], ["en", 20.41], ["las", 20.53], ["películas.", 20.66], ["Solo", 21.91], ["que", 22.14], ["en", 22.35], ["las", 22.46], ["películas", 22.62], ["no", 23.39], ["te", 23.75], ["muerde", 23.96], ["un", 24.39], ["perro", 24.55], ["la", 24.89], ["mochila.", 25.03]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "chip": ["VERGÜENZA", "10%"]}, "planos": [{"v": "cuarto;X=normal@0.5;fx:alarma", "f": "Suena la alarma. Son las siete y cuarenta. Tu clase empieza a las ocho."}, {"v": "cuarto;X=sorprendido@0.5;cu", "f": "Saltas de la cama como si el piso quemara."}, {"v": "cuarto;X=normal@0.5", "f": "Te pones lo primero que encuentras: la gorra de siempre, la sudadera verde…"}, {"v": "neutro;fx:calcetines", "f": "y un calcetín de cada color."}, {"v": "cocina;X=normal@0.4;fx:tostada", "f": "Sales corriendo con una tostada en la boca, como en las películas."}, {"v": "cocina;P=enojado@0.6;X=sorprendido@0.25", "f": "Solo que en las películas no te muerde un perro la mochila."}]}, {"tipo": "planos", "titulo": "", "frames": 650, "words": [["Doblas", 0.05], ["la", 0.48], ["esquina", 0.66], ["a", 1.16], ["toda", 1.37], ["velocidad", 1.66], ["y…", 2.1], ["¡pum!", 3.35], ["Chocas", 4.12], ["con", 4.48], ["alguien.", 4.69], ["Libros", 5.6], ["por", 6.05], ["el", 6.3], ["suelo.", 6.44], ["Tu", 7.48], ["tostada", 7.6], ["vuela", 8.07], ["en", 8.44], ["cámara", 8.62], ["lenta", 8.87], ["y", 9.37], ["aterriza,", 9.98], ["con", 11.03], ["la", 11.12], ["mantequilla", 11.25], ["hacia", 11.87], ["abajo,", 12.12], ["sobre", 13.03], ["un", 13.21], ["zapato", 13.41], ["blanco.", 13.82], ["Levantas", 14.82], ["la", 15.37], ["mirada.", 15.5], ["Pinza", 16.5], ["de", 16.91], ["estrella.", 17.05], ["Pelo", 18.19], ["largo.", 18.44], ["Cárdigan", 19.3], ["lila.", 19.75], ["Es", 20.78], ["Sofía.", 20.94]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "chip": ["VERGÜENZA", "35%"]}, "planos": [{"v": "calle;X=sorprendido@0.4", "f": "Doblas la esquina a toda velocidad y…"}, {"v": "calle;fx:choque", "f": "¡pum! Chocas con alguien. Libros por el suelo."}, {"v": "calle;fx:tostada", "f": "Tu tostada vuela en cámara lenta… y aterriza, con la mantequilla hacia abajo, sobre un zapato blanco."}, {"v": "calle;S=sorprendido@0.5;cu", "f": "Levantas la mirada. Pinza de estrella. Pelo largo. Cárdigan lila."}, {"v": "calle;S=sorprendido@0.5", "f": "Es Sofía."}]}, {"tipo": "planos", "titulo": "", "frames": 419, "words": [["Tu", 0.05], ["cerebro,", 0.14], ["que", 0.75], ["ensayó", 0.87], ["este", 1.23], ["momento", 1.37], ["quinientas", 1.75], ["veces,", 2.62], ["decide", 3.16], ["apagarse.", 3.39], ["Lo", 4.73], ["único", 4.85], ["que", 5.07], ["sale", 5.28], ["de", 5.48], ["tu", 5.66], ["boca", 5.85], ["es…", 6.05], ["—Hola…", 7.14], ["tostada.", 7.96], ["Ella", 9.21], ["te", 9.35], ["mira.", 9.55], ["Tú", 10.39], ["miras", 10.66], ["la", 10.98], ["tostada.", 11.07], ["La", 12.1], ["tostada", 12.28], ["no", 12.8], ["dice", 13.0], ["nada.", 13.28]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "chip": ["VERGÜENZA", "55%"]}, "planos": [{"v": "calle;X=sorprendido@0.5;cu", "f": "Tu cerebro, que ensayó este momento quinientas veces, decide apagarse."}, {"v": "calle;X=sonrojado@0.5;cu", "f": "Lo único que sale de tu boca es: —Hola… tostada."}, {"v": "calle;S=pensando@0.62;X=sonrojado@0.28", "f": "Ella te mira. Tú miras la tostada."}, {"v": "neutro;fx:tostada", "f": "La tostada no dice nada."}]}, {"tipo": "planos", "titulo": "", "frames": 995, "words": [["Te", 0.05], ["agachas", 0.14], ["para", 0.57], ["recoger", 0.78], ["sus", 1.23], ["libros.", 1.44], ["Ella", 2.5], ["también.", 2.71], ["Sus", 3.8], ["cabezas", 3.89], ["chocan.", 4.41], ["—¡Perdón!", 5.53], ["—¡No,", 6.32], ["perdón", 6.66], ["tú!", 6.96], ["—No,", 7.64], ["yo", 8.12], ["dije", 8.21], ["perdón", 8.41], ["primero.", 8.75], ["Y", 9.62], ["ahí,", 9.8], ["entre", 10.28], ["los", 10.57], ["libros,", 10.78], ["ves", 11.3], ["algo.", 11.39], ["Un", 12.21], ["cuaderno", 12.37], ["con", 12.89], ["dibujos.", 13.03], ["Muy", 14.14], ["buenos.", 14.32], ["De", 15.25], ["un", 15.44], ["chico", 15.55], ["con", 15.8], ["gorra.", 16.0], ["No", 16.94], ["le", 17.1], ["ves", 17.23], ["la", 17.39], ["cara", 17.6], ["al", 17.78], ["dibujo.", 17.94], ["Pero", 18.87], ["la", 19.14], ["gorra…", 19.28], ["se", 19.98], ["parece", 20.19], ["mucho", 20.46], ["a", 20.85], ["la", 21.0], ["tuya.", 21.05], ["Antes", 21.94], ["de", 22.25], ["que", 22.41], ["puedas", 22.5], ["preguntar,", 22.8], ["ella", 23.75], ["lo", 23.91], ["guarda", 24.07], ["rapidísimo,", 24.41], ["roja", 25.48], ["como", 25.91], ["un", 26.12], ["tomate,", 26.28], ["y", 27.03], ["se", 27.23], ["va.", 27.35], ["Tú", 28.19], ["te", 28.46], ["quedas", 28.69], ["en", 29.0], ["la", 29.16], ["acera", 29.3], ["con", 29.55], ["media", 29.8], ["tostada", 30.07], ["y", 30.64], ["una", 30.87], ["sola", 31.05], ["pregunta.", 31.25], ["¿Era", 32.44], ["yo?", 32.64]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "chip": ["VERGÜENZA", "60%"]}, "planos": [{"v": "calle;X=preocupado@0.3;S=sorprendido@0.68", "f": "Te agachas para recoger sus libros. Ella también. Sus cabezas chocan."}, {"v": "calle;S=sonrojado@0.5;cu", "f": "—¡Perdón! —¡No, perdón tú! —No, yo dije perdón primero…"}, {"v": "neutro;fx:dibujos", "f": "Y ahí, entre los libros, ves algo: un cuaderno con dibujos. Muy buenos. De un chico con gorra."}, {"v": "calle;X=pensando@0.5;cu", "f": "No le ves la cara al dibujo. Pero la gorra… se parece mucho a la tuya."}, {"v": "calle;S=sonrojado@0.5;cu", "f": "Antes de que puedas preguntar, ella lo guarda rapidísimo, roja como un tomate, y se va."}, {"v": "calle;X=pensando@0.5;fx:tostada", "f": "Tú te quedas en la acera con media tostada y una sola pregunta: ¿era yo?"}]}, {"tipo": "planos", "titulo": "", "frames": 837, "words": [["Llegas", 0.05], ["tarde", 0.35], ["a", 0.62], ["clase.", 0.73], ["Todos", 1.69], ["te", 1.87], ["miran.", 2.12], ["El", 3.16], ["profesor", 3.35], ["dice,", 3.82], ["—Hoy", 4.73], ["hacemos", 4.94], ["el", 5.23], ["trabajo", 5.48], ["en", 5.82], ["parejas.", 5.94], ["Y", 6.87], ["como", 6.96], ["llegaste", 7.14], ["tarde,", 7.5], ["te", 8.21], ["toca", 8.32], ["con", 8.66], ["la", 8.87], ["única", 9.03], ["que", 9.37], ["queda", 9.62], ["libre.", 9.85], ["Te", 10.73], ["das", 10.85], ["la", 11.05], ["vuelta.", 11.25], ["Es", 12.23], ["Sofía.", 12.41], ["Te", 13.55], ["sientas", 13.69], ["a", 14.16], ["su", 14.32], ["lado.", 14.39], ["Tu", 15.28], ["pierna", 15.39], ["empieza", 15.82], ["a", 16.05], ["temblar", 16.37], ["sola.", 16.69], ["Tu", 17.62], ["mano", 17.73], ["suda", 17.91], ["tanto", 18.25], ["que", 18.62], ["el", 18.75], ["lápiz", 18.89], ["se", 19.19], ["te", 19.46], ["resbala", 19.55], ["tres", 20.03], ["veces.", 20.28], ["Ella", 21.19], ["te", 21.35], ["pasa", 21.53], ["un", 21.71], ["pañuelo", 21.91], ["sin", 22.35], ["decir", 22.5], ["nada.", 22.8], ["Y", 23.94], ["sonríe", 24.03], ["un", 24.5], ["poquito.", 24.62], ["Ese", 25.62], ["poquito", 25.89], ["te", 26.37], ["dura", 26.48], ["toda", 26.71], ["la", 27.1], ["semana.", 27.21]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "chip": ["VERGÜENZA", "65%"]}, "planos": [{"v": "salon;T=enojado@0.6;X=preocupado@0.25", "f": "Llegas tarde a clase. Todos te miran."}, {"v": "salon;T=normal@0.5;cu", "f": "El profesor dice: —Hoy hacemos el trabajo en parejas. Y como llegaste tarde, te toca con la única que queda libre."}, {"v": "salon;S=normal@0.5;cu", "f": "Te das la vuelta. Es Sofía."}, {"v": "salon;X=preocupado@0.3;S=normal@0.68", "f": "Te sientas a su lado. Tu pierna empieza a temblar sola."}, {"v": "salon;X=preocupado@0.5;cu", "f": "Tu mano suda tanto que el lápiz se te resbala tres veces."}, {"v": "salon;S=riendo@0.5;cu", "f": "Ella te pasa un pañuelo sin decir nada. Y sonríe un poquito."}, {"v": "salon;X=sonrojado@0.5;fx:brillo", "f": "Ese \"poquito\" te dura toda la semana."}]}, {"tipo": "planos", "titulo": "", "frames": 935, "words": [["Para", 0.05], ["impresionarla", 0.19], ["decides", 1.05], ["hablar", 1.55], ["de", 1.98], ["algo", 2.23], ["interesante.", 2.5], ["Te", 3.75], ["acuerdas", 3.96], ["de", 4.35], ["un", 4.53], ["video", 4.64], ["de", 4.89], ["ciencia", 5.05], ["y", 5.55], ["empiezas", 5.71], ["a", 6.19], ["explicar,", 6.28], ["muy", 6.96], ["seguro,", 7.1], ["cómo", 8.0], ["los", 8.16], ["pulpos", 8.35], ["tienen", 8.78], ["tres", 9.07], ["corazones.", 9.37], ["Hablas", 10.64], ["tan", 10.98], ["rápido", 11.23], ["y", 11.55], ["tan", 11.82], ["emocionado", 11.96], ["que", 12.55], ["no", 12.73], ["te", 12.85], ["das", 12.98], ["cuenta", 13.16], ["de", 13.48], ["que", 13.69], ["estás", 13.78], ["gritando.", 14.0], ["Toda", 15.16], ["la", 15.44], ["clase", 15.53], ["se", 15.85], ["queda", 16.03], ["en", 16.25], ["silencio.", 16.41], ["El", 17.53], ["profesor", 17.64], ["te", 18.1], ["mira", 18.21], ["—¿Terminaste?", 18.41], ["Y", 19.91], ["desde", 20.12], ["el", 20.28], ["fondo", 20.46], ["alguien", 20.66], ["grita", 20.98], ["—se", 21.41], ["le", 22.03], ["nota", 22.14], ["que", 22.37], ["le", 22.53], ["gusta.", 22.64], ["Quieres", 23.48], ["que", 23.78], ["la", 23.89], ["Tierra", 24.03], ["te", 24.28], ["trague.", 24.48], ["Pero", 25.37], ["miras", 25.57], ["a", 25.89], ["Sofía…", 25.98], ["y", 26.85], ["no", 26.94], ["se", 27.05], ["está", 27.16], ["riendo", 27.35], ["de", 27.64], ["ti.", 27.85], ["Está", 28.5], ["tapándose", 28.69], ["la", 29.23], ["boca", 29.37], ["para", 29.57], ["no", 29.85], ["reírse", 30.0], ["contigo.", 30.44]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "chip": ["VERGÜENZA", "90%"]}, "planos": [{"v": "salon;X=riendo@0.4", "f": "Para impresionarla, decides hablar de algo interesante."}, {"v": "salon;X=riendo@0.5;cu;ui:3 CORAZONES", "f": "Te acuerdas de un video de ciencia y empiezas a explicar, muy seguro, cómo los pulpos tienen tres corazones."}, {"v": "salon;X=riendo@0.5;cu", "f": "Hablas tan rápido y tan emocionado que no te das cuenta de que estás gritando."}, {"v": "salon;T=enojado@0.6;X=sorprendido@0.25", "f": "Toda la clase se queda en silencio. El profesor te mira: —¿Terminaste?"}, {"v": "salon;MT=riendo@0.5;cu", "f": "Y desde el fondo alguien grita: —¡Se le nota que le gusta!"}, {"v": "salon;X=llorando@0.5;cu", "f": "Quieres que la Tierra te trague."}, {"v": "salon;S=riendo@0.5;cu", "f": "Pero miras a Sofía… y no se está riendo de ti. Está tapándose la boca para no reírse contigo."}]}, {"tipo": "planos", "titulo": "", "frames": 1044, "words": [["Para", 0.05], ["terminar", 0.16], ["el", 0.53], ["trabajo,", 0.78], ["quedan", 1.71], ["en", 2.05], ["la", 2.16], ["cafetería", 2.28], ["de", 2.82], ["la", 2.96], ["esquina.", 3.1], ["Llegas", 4.05], ["veinte", 4.39], ["minutos", 4.73], ["antes.", 5.07], ["Practicas", 6.23], ["cómo", 6.71], ["sentarte.", 7.0], ["Cómo", 8.32], ["sostener", 8.46], ["la", 8.89], ["taza.", 9.14], ["Cómo", 10.19], ["parecer", 10.37], ["normal.", 10.71], ["Ella", 12.03], ["llega,", 12.23], ["se", 12.82], ["sienta,", 12.91], ["y", 14.0], ["lo", 14.1], ["primero", 14.19], ["que", 14.46], ["haces", 14.69], ["es", 15.0], ["tirar", 15.32], ["tu", 15.64], ["chocolate", 15.75], ["caliente", 16.12], ["encima", 16.69], ["de", 17.19], ["la", 17.35], ["mesa.", 17.46], ["Encima", 18.28], ["de", 18.73], ["tus", 18.89], ["apuntes.", 19.03], ["Encima", 20.14], ["de", 20.57], ["tu", 20.75], ["dignidad.", 20.87], ["Pero", 22.07], ["en", 22.28], ["vez", 22.44], ["de", 22.55], ["enojarse,", 22.69], ["Sofía", 23.73], ["saca", 24.05], ["su", 24.37], ["cuaderno", 24.48], ["para", 24.98], ["salvar", 25.16], ["la", 25.44], ["hoja.", 25.69], ["Y", 26.5], ["sin", 26.69], ["querer", 26.82], ["lo", 27.1], ["deja", 27.35], ["abierto.", 27.57], ["Ahí", 28.69], ["están", 28.91], ["otra", 29.25], ["vez.", 29.44], ["La", 29.78], ["biblioteca,", 30.3], ["el", 31.41], ["parque,", 31.53], ["el", 32.3], ["chico", 32.41], ["de", 32.75], ["la", 32.87], ["gorra", 32.98], ["comiendo", 33.35], ["una", 33.82], ["tostada.", 34.03]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "chip": ["VERGÜENZA", "95%"]}, "planos": [{"v": "comedor;X=normal@0.5", "f": "Para terminar el trabajo, quedan en la cafetería de la esquina."}, {"v": "comedor;X=pensando@0.5;cu", "f": "Llegas veinte minutos antes. Practicas cómo sentarte. Cómo sostener la taza. Cómo parecer normal."}, {"v": "comedor;S=normal@0.62;X=sorprendido@0.3;fx:chocolate", "f": "Ella llega, se sienta, y lo primero que haces es tirar tu chocolate caliente encima de la mesa."}, {"v": "comedor;X=llorando@0.5;cu", "f": "Encima de tus apuntes. Encima de tu dignidad."}, {"v": "comedor;S=sorprendido@0.5;cu", "f": "Pero en vez de enojarse, Sofía saca su cuaderno para salvar la hoja… y sin querer lo deja abierto."}, {"v": "neutro;fx:dibujos", "f": "Ahí están otra vez: la biblioteca, el parque, el chico de la gorra comiendo una tostada."}]}, {"tipo": "planos", "titulo": "", "frames": 804, "words": [["—¿Ese…", 0.05], ["soy", 0.66], ["yo?", 0.98], ["—preguntas.", 1.66], ["Ella", 2.73], ["cierra", 2.89], ["el", 3.23], ["cuaderno", 3.37], ["de", 3.78], ["golpe.", 3.87], ["—Es…", 5.37], ["un", 5.91], ["personaje.", 6.14], ["Inventado.", 7.46], ["Muy", 8.62], ["feo.", 8.73], ["—Ah.", 9.73], ["Bueno.", 10.53], ["Tiene", 11.21], ["buena", 11.39], ["gorra.", 11.62], ["Por", 12.62], ["primera", 12.78], ["vez", 13.07], ["se", 13.35], ["ríen", 13.6], ["los", 13.85], ["dos", 14.0], ["al", 14.19], ["mismo", 14.35], ["tiempo.", 14.55], ["Y", 15.71], ["descubres", 15.87], ["que", 16.41], ["a", 16.64], ["ella", 16.69], ["también", 16.82], ["le", 17.1], ["gustan", 17.3], ["los", 17.69], ["documentales", 17.8], ["de", 18.5], ["animales", 18.66], ["raros,", 18.94], ["que", 20.0], ["odia", 20.1], ["las", 20.35], ["aceitunas", 20.5], ["y", 21.21], ["que", 21.37], ["también", 21.44], ["ensaya", 21.78], ["conversaciones", 22.19], ["en", 22.87], ["el", 23.1], ["espejo.", 23.21], ["Por", 24.32], ["un", 24.5], ["rato", 24.62], ["se", 24.94], ["te", 25.07], ["olvida", 25.19], ["que", 25.53], ["estás", 25.71], ["nervioso.", 25.91]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "chip": ["VERGÜENZA", "40%"]}, "planos": [{"v": "comedor;X=sorprendido@0.5;cu", "f": "—¿Ese… soy yo? —preguntas."}, {"v": "comedor;S=sonrojado@0.5;cu", "f": "Ella cierra el cuaderno de golpe: —Es… un personaje. Inventado. Muy feo."}, {"v": "comedor;X=riendo@0.5;cu", "f": "—Ah. Bueno. Tiene buena gorra."}, {"v": "comedor;X=riendo@0.3;S=riendo@0.68;fx:brillo", "f": "Por primera vez se ríen los dos al mismo tiempo."}, {"v": "comedor;S=riendo@0.5;cu", "f": "Y descubres que a ella también le gustan los documentales de animales raros, que odia las aceitunas y que también ensaya conversaciones en el espejo."}, {"v": "comedor;X=sonrojado@0.5", "f": "Por un rato se te olvida que estás nervioso."}]}, {"tipo": "planos", "titulo": "", "frames": 611, "words": [["A", 0.05], ["la", 0.14], ["salida", 0.23], ["la", 0.69], ["ves", 1.14], ["hablando", 1.3], ["con", 1.64], ["Mateo,", 1.94], ["el", 2.82], ["capitán", 2.87], ["del", 3.37], ["equipo", 3.53], ["de", 3.8], ["fútbol.", 4.0], ["Él", 5.07], ["le", 5.37], ["da", 5.75], ["una", 5.91], ["carta.", 6.07], ["Tu", 7.07], ["corazón", 7.21], ["se", 7.57], ["cae", 7.82], ["al", 8.05], ["piso.", 8.14], ["Decides", 9.03], ["que", 9.41], ["ya", 9.62], ["está.", 9.78], ["Que", 10.57], ["no", 10.66], ["tienes", 10.82], ["oportunidad.", 11.07], ["Te", 12.23], ["pones", 12.37], ["los", 12.64], ["audífonos", 12.8], ["y", 13.44], ["caminas", 13.55], ["a", 13.91], ["casa", 14.07], ["bajo", 14.3], ["una", 14.55], ["lluvia", 14.8], ["que", 15.21], ["empezó", 15.35], ["justo", 15.78], ["en", 16.1], ["ese", 16.28], ["momento,", 16.41], ["porque", 17.41], ["claro,", 17.69], ["el", 18.5], ["universo", 18.57], ["también", 18.94], ["quiere", 19.35], ["drama.", 19.73]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "chip": ["VERGÜENZA", "70%"]}, "planos": [{"v": "patio;S=normal@0.62;MT=sonrojado@0.3", "f": "A la salida, la ves hablando con Mateo, el capitán del equipo de fútbol."}, {"v": "patio;MT=sonrojado@0.5;fx:carta;cu", "f": "Él le da una carta."}, {"v": "patio;X=llorando@0.5;cu", "f": "Tu corazón se cae al piso."}, {"v": "calle;X=llorando@0.5;fx:lluvia", "f": "Decides que ya está. Que no tienes oportunidad."}, {"v": "calle;X=preocupado@0.5;fx:lluvia", "f": "Te pones los audífonos y caminas a casa bajo una lluvia que empezó justo en ese momento, porque claro, el universo también quiere drama."}]}, {"tipo": "planos", "titulo": "", "frames": 693, "words": [["Al", 0.05], ["día", 0.23], ["siguiente", 0.41], ["encuentras", 0.8], ["algo", 1.71], ["dentro", 2.03], ["de", 2.46], ["tu", 2.73], ["casillero.", 2.85], ["Una", 3.82], ["hoja", 4.14], ["doblada.", 4.44], ["Un", 5.37], ["dibujo.", 5.53], ["Un", 6.44], ["chico", 6.6]