, ["Los", 18.21], ["dos", 18.35], ["se", 18.53], ["ríen", 18.66], ["tan", 18.96], ["fuerte", 19.12], ["que", 19.37], ["la", 19.62], ["bibliotecaria", 19.73], ["los", 20.5], ["manda", 20.64], ["a", 21.03], ["callar.", 21.07]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "chip": ["VERGÜENZA", "5%"]}, "planos": [{"v": "biblio;S=normal@0.65;X=normal@0.28", "f": "Esta vez no ensayas nada. La buscas en la biblioteca, en la mesa de siempre."}, {"v": "biblio;X=sonrojado@0.5;cu", "f": "Te sientas frente a ella. Respiras. Y dices, por fin, bien clarito: —Hola, Sofía."}, {"v": "biblio;S=riendo@0.5;cu", "f": "Ella levanta la vista, sonríe y responde: —Hola… tostada."}, {"v": "biblio;X=riendo@0.3;S=riendo@0.68;fx:brillo", "f": "Los dos se ríen tan fuerte que la bibliotecaria los manda a callar."}, {"v": "biblio;D=enojado@0.5;cu", "f": "—¡Shhh!"}]}, {"tipo": "planos", "titulo": "", "frames": 649, "words": [["Y", 0.05], ["así,", 0.16], ["el", 0.75], ["peor", 0.89], ["día", 1.19], ["de", 1.37], ["tu", 1.55], ["vida", 1.69], ["se", 1.94], ["convirtió", 2.14], ["en", 2.75], ["el", 2.87], ["mejor.", 2.96], ["Porque", 3.82], ["a", 4.19], ["veces", 4.35], ["la", 4.64], ["persona", 4.89], ["que", 5.28], ["te", 5.48], ["gusta", 5.96], ["no", 5.96], ["necesita", 6.62], ["que", 7.05], ["seas", 7.32], ["perfecto.", 7.55], ["Solo", 8.87], ["necesita", 9.12], ["que", 9.5], ["seas", 9.87], ["tú…", 10.1], ["aunque", 10.98], ["llegues", 11.14], ["tarde,", 11.62], ["con", 12.46], ["un", 12.6], ["calcetín", 12.75], ["de", 13.32], ["cada", 13.44], ["color", 13.69], ["y", 14.1], ["sin", 14.39], ["tostada.", 14.55], ["¿Y", 15.8], ["tú?", 15.91], ["¿Qué", 16.73], ["es", 16.87], ["lo", 16.96], ["más", 17.05], ["vergonzoso", 17.21], ["que", 17.8], ["te", 18.0], ["ha", 18.14], ["pasado", 18.21], ["frente", 18.55], ["a", 18.82], ["tu", 19.03], ["crush?", 19.14], ["Te", 20.03], ["leo", 20.14], ["en", 20.44], ["los", 20.5], ["comentarios.", 20.62]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "chip": ["VERGÜENZA", "0%"]}, "planos": [{"v": "patio;X=riendo@0.32;S=riendo@0.68;fx:brillo", "f": "Y así, el peor día de tu vida se convirtió en el mejor."}, {"v": "patio;X=sonrojado@0.5;cu", "f": "Porque a veces la persona que te gusta no necesita que seas perfecto. Solo necesita que seas tú…"}, {"v": "neutro;fx:calcetines", "f": "aunque llegues tarde, con un calcetín de cada color y sin tostada."}, {"v": "neutro;X=pensando@0.5;ui:¿TU PEOR MOMENTO?", "f": "¿Y tú? ¿Qué es lo más vergonzoso que te ha pasado frente a tu crush? Te leo en los comentarios."}]}]