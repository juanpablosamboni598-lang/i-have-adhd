[{"tipo": "planos", "titulo": "", "frames": 212, "words": [["Imagina", 0.15], ["que", 0.46], ["te", 0.78], ["despiertas,", 1.09], ["te", 1.4], ["miras", 1.71], ["al", 2.02], ["espejo…", 2.34], ["y", 2.65], ["no", 2.96], ["hay", 3.27], ["nadie.", 3.59], ["Eres", 3.9], ["invisible.", 4.21], ["Solo", 4.53], ["por", 4.84], ["veinticuatro", 5.15], ["horas.", 5.46], ["¿Qué", 5.78], ["harías", 6.09], ["primero?", 6.4]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "reloj": null}, "planos": [{"v": "cuarto;X=normal@0.5;cu", "f": "Imagina que te despiertas, te miras al espejo…"}, {"v": "cuarto;fx:espejo", "f": "y no hay nadie."}, {"v": "cuarto;X=sorprendido@0.5~inv;cu", "f": "Eres invisible."}, {"v": "neutro;ui:24 HORAS", "f": "Solo por veinticuatro horas."}, {"v": "neutro;X=pensando@0.5~inv", "f": "¿Qué harías primero?"}]}, {"tipo": "planos", "titulo": "", "frames": 90, "words": [["¿Qué", 0.15], ["pasaría", 0.46], ["si", 0.78], ["fueras", 1.09], ["invisible", 1.4], ["por", 1.71], ["24", 2.02], ["horas?", 2.34]], "caps": [], "p": {"esc": null, "med": null, "flash": true, "reloj": null}, "planos": [{"v": "tit", "f": "¿Qué pasaría si fueras invisible por 24 horas?"}]}, {"tipo": "planos", "titulo": "", "frames": 390, "words": [["Suena", 0.15], ["la", 0.46], ["alarma.", 0.78], ["Te", 1.09], ["estiras.", 1.4], ["Vas", 1.71], ["al", 2.02], ["baño", 2.34], ["medio", 2.65], ["dormido.", 2.96], ["Y", 3.27], ["en", 3.59], ["el", 3.9], ["espejo…", 4.21], ["solo", 4.53], ["está", 4.84], ["la", 5.15], ["pared.", 5.46], ["Te", 5.78], ["tocas", 6.09], ["la", 6.4], ["cara.", 6.71], ["Sí,", 7.03], ["ahí", 7.34], ["está.", 7.65], ["Pero", 7.96], ["no", 8.28], ["se", 8.59], ["ve.", 8.9], ["Por", 9.21], ["suerte,", 9.53], ["la", 9.84], ["ropa", 10.15], ["también", 10.46], ["desapareció.", 10.78], ["Eso", 11.09], ["hubiera", 11.4], ["sido", 11.71], ["un", 12.03], ["problema.", 12.34]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "reloj": "23:59"}, "planos": [{"v": "cuarto;X=normal@0.5", "f": "Suena la alarma. Te estiras. Vas al baño medio dormido."}, {"v": "cuarto;fx:espejo", "f": "Y en el espejo… solo está la pared."}, {"v": "cuarto;X=sorprendido@0.5~inv;cu", "f": "Te tocas la cara. Sí, ahí está. Pero no se ve."}, {"v": "cuarto;X=pensando@0.5~inv", "f": "Por suerte, la ropa también desapareció. Eso hubiera sido un problema."}]}, {"tipo": "planos", "titulo": "", "frames": 334, "words": [["Tu", 0.15], ["mamá", 0.46], ["abre", 0.78], ["la", 1.09], ["puerta:", 1.4], ["—¡Arriba,", 1.71], ["que", 2.02], ["llegas", 2.34], ["tarde!", 2.65], ["Mira", 2.96], ["la", 3.27], ["cama", 3.59], ["vacía.", 3.9], ["Mira", 4.21], ["debajo", 4.53], ["de", 4.84], ["la", 5.15], ["cama.", 5.46], ["—¿Ya", 5.78], ["se", 6.09], ["fue", 6.4], ["este", 6.71], ["niño", 7.03], ["sin", 7.34], ["desayunar?", 7.65], ["Estás", 7.96], ["a", 8.28], ["medio", 8.59], ["metro", 8.9], ["de", 9.21], ["ella.", 9.53], ["Aguantas", 9.84], ["la", 10.15], ["risa.", 10.46]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "reloj": "23:40"}, "planos": [{"v": "cuarto;M=normal@0.62!saluda;X=normal@0.28~inv", "f": "Tu mamá abre la puerta: —¡Arriba, que llegas tarde!"}, {"v": "cuarto;M=sorprendido@0.5;cu", "f": "Mira la cama vacía. Mira debajo de la cama."}, {"v": "cuarto;M=enojado@0.5;cu", "f": "—¿Ya se fue este niño sin desayunar?"}, {"v": "cuarto;X=riendo@0.5~inv;cu", "f": "Estás a medio metro de ella. Aguantas la risa."}]}, {"tipo": "planos", "titulo": "", "frames": 268, "words": [["Pero", 0.15], ["tu", 0.46], ["perro", 0.78], ["no", 1.09], ["se", 1.4], ["deja", 1.71], ["engañar.", 2.02], ["Te", 2.34], ["huele.", 2.65], ["Le", 2.96], ["ladra", 3.27], ["al", 3.59], ["aire", 3.9], ["durante", 4.21], ["cinco", 4.53], ["minutos", 4.84], ["seguidos.", 5.15], ["—¿Y", 5.46], ["a", 5.78], ["este", 6.09], ["perro", 6.4], ["qué", 6.71], ["le", 7.03], ["pasa?", 7.34], ["—dice", 7.65], ["tu", 7.96], ["mamá.", 8.28]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "reloj": "23:20"}, "planos": [{"v": "cocina;P=sorprendido@0.6;X=normal@0.25~inv", "f": "Pero tu perro no se deja engañar. Te huele."}, {"v": "cocina;P=enojado@0.5", "f": "Le ladra al aire durante cinco minutos seguidos."}, {"v": "cocina;M=pensando@0.6;P=enojado@0.3", "f": "—¿Y a este perro qué le pasa? —dice tu mamá."}]}, {"tipo": "planos", "titulo": "", "frames": 371, "words": [["Tienes", 0.15], ["hambre.", 0.46], ["Agarras", 0.78], ["una", 1.09], ["tostada.", 1.4], ["Tu", 1.71], ["hermano", 2.02], ["levanta", 2.34], ["la", 2.65], ["vista", 2.96], ["y", 3.27], ["ve", 3.59], ["una", 3.9], ["tostada", 4.21], ["flotando", 4.53], ["en", 4.84], ["el", 5.15], ["aire.", 5.46], ["Una", 5.78], ["tostada.", 6.09], ["Flotando.", 6.4], ["Mordiéndose", 6.71], ["sola.", 7.03], ["—¡Mamá!", 7.34], ["¡La", 7.65], ["tostada", 7.96], ["está", 8.28], ["embrujada!", 8.59], ["—Deja", 8.9], ["de", 9.21], ["inventar", 9.53], ["y", 9.84], ["come.", 10.15], ["Primer", 10.46], ["punto", 10.78], ["para", 11.09], ["el", 11.4], ["poder.", 11.71]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "reloj": "23:05"}, "planos": [{"v": "cocina;X=normal@0.35~inv;fx:tostada", "f": "Tienes hambre. Agarras una tostada."}, {"v": "cocina;H=sorprendido@0.62;X=normal@0.3~inv;fx:tostada", "f": "Tu hermano levanta la vista y ve una tostada flotando en el aire."}, {"v": "cocina;H=sorprendido@0.5;cu", "f": "Una tostada. Flotando. Mordiéndose sola."}, {"v": "cocina;H=llorando@0.4;M=enojado@0.7", "f": "—¡Mamá! ¡La tostada está embrujada! —Deja de inventar y come."}, {"v": "cocina;X=riendo@0.5~inv;cu", "f": "Primer punto para el poder."}]}, {"tipo": "planos", "titulo": "", "frames": 802, "words": [["En", 0.15], ["la", 0.46], ["calle", 0.78], ["te", 1.09], ["das", 1.4], ["cuenta", 1.71], ["de", 2.02], ["algo:", 2.34], ["nadie", 2.65], ["te", 2.96], ["ve,", 3.27], ["así", 3.59], ["que", 3.9], ["nadie", 4.21], ["te", 4.53], ["juzga.", 4.84], ["Bailas", 5.15], ["en", 5.46], ["la", 5.78], ["acera.", 6.09], ["Haces", 6.4], ["caras.", 6.71], ["Cantas", 7.03], ["en", 7.34], ["voz", 7.65], ["alta.", 7.96], ["El", 8.28], ["señor", 8.59], ["del", 8.9], ["kiosco", 9.21], ["escucha", 9.53], ["una", 9.84], ["canción", 10.15], ["que", 10.46], ["sale", 10.78], ["de", 11.09], ["la", 11.4], ["nada", 11.71], ["y", 12.03], ["se", 12.34], ["persigna.", 12.65], ["Una", 12.96], ["paloma", 13.28], ["camina", 13.59], ["directo", 13.9], ["hacia", 14.21], ["ti,", 14.53], ["choca", 14.84], ["con", 15.15], ["tu", 15.46], ["zapato", 15.78], ["y", 16.09], ["se", 16.4], ["queda", 16.71], ["mirándote", 17.02], ["como", 17.34], ["si", 17.65], ["hubiera", 17.96], ["visto", 18.27], ["un", 18.59], ["fantasma.", 18.9], ["Llegas", 19.21], ["al", 19.52], ["colegio.", 19.84], ["La", 20.15], ["directora", 20.46], ["vigila", 20.77], ["la", 21.09], ["puerta", 21.4], ["como", 21.71], ["siempre.", 22.02], ["Pasas", 22.34], ["a", 22.65], ["su", 22.96], ["lado", 23.27], ["tarde,", 23.59], ["sin", 23.9], ["uniforme", 24.21], ["completo,", 24.52], ["y", 24.84], ["no", 25.15], ["pasa", 25.46], ["nada.", 25.77], ["Nada.", 26.09]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "reloj": "22:30"}, "planos": [{"v": "calle;X=riendo@0.5~inv", "f": "En la calle te das cuenta de algo: nadie te ve, así que nadie te juzga."}, {"v": "calle;X=riendo@0.5~inv;cu", "f": "Bailas en la acera. Haces caras. Cantas en voz alta."}, {"v": "calle;K=sorprendido@0.6;X=riendo@0.25~inv", "f": "El señor del kiosco escucha una canción que sale de la nada y se persigna."}, {"v": "calle;X=riendo@0.5~inv", "f": "Una paloma camina directo hacia ti, choca con tu zapato y se queda mirándote como si hubiera visto un fantasma."}, {"v": "entrada;D=enojado@0.6;X=normal@0.25~inv", "f": "Llegas al colegio. La directora vigila la puerta como siempre."}, {"v": "entrada;X=riendo@0.5~inv;cu", "f": "Pasas a su lado tarde, sin uniforme completo, y no pasa nada. Nada."}]}, {"tipo": "planos", "titulo": "", "frames": 596, "words": [["En", 0.15], ["clase", 0.46], ["el", 0.78], ["profesor", 1.09], ["pasa", 1.4], ["lista.", 1.71], ["Dice", 2.02], ["tu", 2.34], ["nombre.", 2.65], ["Nadie", 2.96], ["responde.", 3.27], ["—Ausente.", 3.59], ["Otra", 3.9], ["vez.", 4.21], ["Y", 4.53], ["entonces", 4.84], ["lo", 5.15], ["ves:", 5.46], ["sobre", 5.78], ["su", 6.09], ["escritorio,", 6.4], ["las", 6.71], ["respuestas", 7.03], ["del", 7.34], ["examen", 7.65], ["de", 7.96], ["mañana.", 8.28], ["Nadie", 8.59], ["te", 8.9], ["vería.", 9.21], ["Nadie", 9.53], ["lo", 9.84], ["sabría", 10.15], ["nunca.", 10.46], ["Lo", 10.78], ["piensas", 11.09], ["un", 11.4], ["segundo…", 11.71], ["y", 12.03], ["te", 12.34], ["alejas", 12.65], ["del", 12.96], ["escritorio.", 13.28], ["Ser", 13.59], ["invisible", 13.9], ["no", 14.21], ["te", 14.53], ["convierte", 14.84], ["en", 15.15], ["otra", 15.46], ["persona.", 15.78], ["Solo", 16.09], ["hace", 16.4], ["más", 16.71], ["fácil", 17.02], ["que", 17.34], ["se", 17.65], ["note", 17.96], ["quién", 18.27], ["eres", 18.59], ["de", 18.9], ["verdad.", 19.21]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "reloj": "20:15"}, "planos": [{"v": "salon;T=normal@0.6;X=normal@0.25~inv", "f": "En clase el profesor pasa lista. Dice tu nombre. Nadie responde."}, {"v": "salon;T=enojado@0.5;cu;ui:AUSENTE", "f": "—Ausente. Otra vez."}, {"v": "salon;X=pensando@0.5~inv;fx:examen", "f": "Y entonces lo ves: sobre su escritorio, las respuestas del examen de mañana."}, {"v": "salon;X=pensando@0.5~inv;cu", "f": "Nadie te vería. Nadie lo sabría nunca."}, {"v": "salon;X=normal@0.5~inv", "f": "Lo piensas un segundo… y te alejas del escritorio."}, {"v": "salon;X=riendo@0.5~inv;cu", "f": "Ser invisible no te convierte en otra persona. Solo hace más fácil que se note quién eres de verdad."}]}, {"tipo": "planos", "titulo": "", "frames": 784, "words": [["Claro", 0.15], ["que", 0.46], ["no", 0.78], ["todo", 1.09], ["es", 1.4], ["tan", 1.71], ["noble.", 2.02], ["Hay", 2.34], ["que", 2.65], ["aprovechar", 2.96], ["un", 3.27], ["poco.", 3.59], ["Le", 3.9], ["escondes", 4.21], ["la", 4.53], ["tiza", 4.84], ["al", 5.15], ["profesor.", 5.46], ["Él", 5.78], ["busca", 6.09], ["en", 6.4], ["su", 6.71], ["bolsillo,", 7.03], ["en", 7.34], ["el", 7.65], ["escritorio,", 7.96], ["debajo", 8.28], ["de", 8.59], ["la", 8.9], ["silla.", 9.21], ["Se", 9.53], ["la", 9.84], ["devuelves", 10.15], ["justo", 10.46], ["delante", 10.78], ["de", 11.09], ["él,", 11.4], ["sobre", 11.71], ["el", 12.03], ["libro.", 12.34], ["El", 12.65], ["profesor", 12.96], ["la", 13.28], ["mira,", 13.59], ["se", 13.9], ["quita", 14.21], ["las", 14.53], ["gafas,", 14.84], ["se", 15.15], ["las", 15.46], ["vuelve", 15.78], ["a", 16.09], ["poner…", 16.4], ["y", 16.71], ["decide", 17.02], ["que", 17.34], ["mejor", 17.65], ["hoy", 17.96], ["da", 18.27], ["clase", 18.59], ["sin", 18.9], ["tiza.", 19.21], ["Media", 19.52], ["clase", 19.84], ["se", 20.15], ["ríe", 20.46], ["sin", 20.77], ["saber", 21.09], ["de", 21.4], ["qué.", 21.71], ["Y", 22.02], ["tú", 22.34], ["te", 22.65], ["ríes", 22.96], ["más", 23.27], ["fuerte", 23.59], ["que", 23.9], ["todos,", 24.21], ["porque", 24.52], ["nadie", 24.84], ["te", 25.15], ["escucha.", 25.46]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "reloj": "19:30"}, "planos": [{"v": "salon;T=normal@0.6;X=riendo@0.25~inv", "f": "Claro que no todo es tan noble. Hay que aprovechar un poco."}, {"v": "salon;T=sorprendido@0.5;cu", "f": "Le escondes la tiza al profesor. Él busca en su bolsillo, en el escritorio, debajo de la silla."}, {"v": "salon;X=riendo@0.5~inv;cu", "f": "Se la devuelves justo delante de él, sobre el libro."}, {"v": "salon;T=sorprendido@0.6;X=riendo@0.25~inv", "f": "El profesor la mira, se quita las gafas, se las vuelve a poner… y decide que mejor hoy da clase sin tiza."}, {"v": "salon;C=riendo@0.4;MT=riendo@0.72", "f": "Media clase se ríe sin saber de qué. Y tú te ríes más fuerte que todos, porque nadie te escucha."}]}, {"tipo": "planos", "titulo": "", "frames": 690, "words": [["En", 0.15], ["el", 0.46], ["almuerzo", 0.78], ["descubres", 1.09], ["el", 1.4], ["lado", 1.71], ["malo:", 2.02], ["no", 2.34], ["puedes", 2.65], ["comprar", 2.96], ["comida.", 3.27], ["Intentas", 3.59], ["pedir", 3.9], ["una", 4.21], ["pizza.", 4.53], ["La", 4.84], ["señora", 5.15], ["de", 5.46], ["la", 5.78], ["cafetería", 6.09], ["escucha", 6.4], ["una", 6.71], ["voz,", 7.03], ["grita", 7.34], ["y", 7.65], ["cierra", 7.96], ["la", 8.28], ["ventanilla.", 8.59], ["Te", 8.9], ["sientas", 9.21], ["junto", 9.53], ["a", 9.84], ["Camila,", 10.15], ["como", 10.46], ["siempre.", 10.78], ["Ella", 11.09], ["deja", 11.4], ["un", 11.71], ["pedazo", 12.03], ["de", 12.34], ["pan", 12.65], ["en", 12.96], ["tu", 13.28], ["lugar", 13.59], ["vacío,", 13.9], ["por", 14.21], ["costumbre.", 14.53], ["Te", 14.84], ["lo", 15.15], ["comes.", 15.46], ["Ella", 15.78], ["mira", 16.09], ["el", 16.4], ["plato", 16.71], ["vacío,", 17.02], ["frunce", 17.34], ["el", 17.65], ["ceño…", 17.96], ["y", 18.27], ["sonríe", 18.59], ["como", 18.9], ["si", 19.21], ["supiera", 19.52], ["algo.", 19.84], ["—Qué", 20.15], ["raro", 20.46], ["—dice—.", 20.77], ["Juraría", 21.09], ["que", 21.4], ["hoy", 21.71], ["estás", 22.02], ["aquí.", 22.34]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "reloj": "18:50"}, "planos": [{"v": "comedor;X=normal@0.5~inv", "f": "En el almuerzo descubres el lado malo: no puedes comprar comida."}, {"v": "comedor;X=preocupado@0.5~inv;cu", "f": "Intentas pedir una pizza. La señora de la cafetería escucha una voz, grita y cierra la ventanilla."}, {"v": "comedor;C=normal@0.62;X=normal@0.28~inv", "f": "Te sientas junto a Camila, como siempre. Ella deja un pedazo de pan en tu lugar vacío, por costumbre."}, {"v": "comedor;X=sonrojado@0.5~inv;cu", "f": "Te lo comes. Ella mira el plato vacío, frunce el ceño… y sonríe como si supiera algo."}, {"v": "comedor;C=pensando@0.5;cu", "f": "—Qué raro —dice—. Juraría que hoy estás aquí."}]}, {"tipo": "planos", "titulo": "", "frames": 624, "words": [["En", 0.15], ["el", 0.46], ["pasillo", 0.78], ["pasa", 1.09], ["algo", 1.4], ["que", 1.71], ["no", 2.02], ["esperabas:", 2.34], ["escuchas", 2.65], ["lo", 2.96], ["que", 3.27], ["dicen", 3.59], ["de", 3.9], ["ti", 4.21], ["cuando", 4.53], ["no", 4.84], ["estás.", 5.15], ["Mateo,", 5.46], ["el", 5.78], ["popular,", 6.09], ["dice:", 6.4], ["—El", 6.71], ["de", 7.03], ["la", 7.34], ["gorra", 7.65], ["es", 7.96], ["buena", 8.28], ["gente.", 8.59], ["El", 8.9], ["otro", 9.21], ["día", 9.53], ["me", 9.84], ["ayudó", 10.15], ["con", 10.46], ["mates.", 10.78], ["Mateo.", 11.09], ["Sabe", 11.4], ["que", 11.71], ["existes.", 12.03], ["Camila", 12.34], ["mira", 12.65], ["tu", 12.96], ["silla", 13.28], ["vacía", 13.59], ["y", 13.9], ["dice:", 14.21], ["—Qué", 14.53], ["raro", 14.84], ["que", 15.15], ["no", 15.46], ["vino.", 15.78], ["Le", 16.09], ["voy", 16.4], ["a", 16.71], ["escribir.", 17.02], ["Tu", 17.34], ["celular", 17.65], ["vibra", 17.96], ["en", 18.27], ["tu", 18.59], ["bolsillo.", 18.9], ["\"¿Estás", 19.21], ["bien?\".", 19.52], ["Es", 19.84], ["ella.", 20.15]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "reloj": "17:40"}, "planos": [{"v": "pasillo;MT=normal@0.3;C=normal@0.68;X=normal@0.5~inv", "f": "En el pasillo pasa algo que no esperabas: escuchas lo que dicen de ti cuando no estás."}, {"v": "pasillo;MT=riendo@0.5;cu", "f": "Mateo, el popular, dice: —El de la gorra es buena gente. El otro día me ayudó con mates."}, {"v": "pasillo;X=sorprendido@0.5~inv;cu", "f": "Mateo. Sabe que existes."}, {"v": "pasillo;C=preocupado@0.5;cu", "f": "Camila mira tu silla vacía y dice: —Qué raro que no vino. Le voy a escribir."}, {"v": "pasillo;X=sonrojado@0.5~inv", "f": "Tu celular vibra en tu bolsillo. \"¿Estás bien?\". Es ella."}]}, {"tipo": "planos", "titulo": "", "frames": 652, "words": [["En", 0.15], ["la", 0.46], ["biblioteca", 0.78], ["está", 1.09], ["Sofía,", 1.4], ["en", 1.71], ["la", 2.02], ["mesa", 2.34], ["de", 2.65], ["siempre,", 2.96], ["dibujando.", 3.27], ["Te", 3.59], ["acercas", 3.9], ["despacio.", 4.21], ["Por", 4.53], ["primera", 4.84], ["vez", 5.15], ["puedes", 5.46], ["mirar", 5.78], ["su", 6.09], ["cuaderno", 6.4], ["sin", 6.71], ["que", 7.03], ["lo", 7.34], ["cierre", 7.65], ["de", 7.96], ["golpe.", 8.28], ["Es", 8.59], ["un", 8.9], ["dibujo", 9.21], ["tuyo.", 9.53], ["Con", 9.84], ["la", 10.15], ["gorra.", 10.46], ["Sonriendo.", 10.78], ["Ella", 11.09], ["suspira", 11.4], ["y", 11.71], ["dice", 12.03], ["bajito:", 12.34], ["—Ojalá", 12.65], ["hubiera", 12.96], ["venido", 13.28], ["hoy.", 13.59], ["Sin", 13.9], ["pensarlo,", 14.21], ["respondes:", 14.53], ["—Aquí", 14.84], ["estoy.", 15.15], ["Sofía", 15.46], ["da", 15.78], ["un", 16.09], ["salto,", 16.4], ["mira", 16.71], ["a", 17.02], ["todos", 17.34], ["lados…", 17.65], ["y", 17.96], ["no", 18.27], ["ve", 18.59], ["a", 18.9], ["nadie.", 19.21], ["Sales", 19.52], ["corriendo", 19.84], ["antes", 20.15], ["de", 20.46], ["arruinarlo", 20.77], ["más.", 21.09]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "reloj": "14:20"}, "planos": [{"v": "biblio;S=normal@0.62;X=normal@0.28~inv", "f": "En la biblioteca está Sofía, en la mesa de siempre, dibujando."}, {"v": "biblio;X=sonrojado@0.5~inv", "f": "Te acercas despacio. Por primera vez puedes mirar su cuaderno sin que lo cierre de golpe."}, {"v": "neutro;fx:dibujos", "f": "Es un dibujo tuyo. Con la gorra. Sonriendo."}, {"v": "biblio;S=sonrojado@0.5;cu", "f": "Ella suspira y dice bajito: —Ojalá hubiera venido hoy."}, {"v": "biblio;X=sonrojado@0.5~inv;cu", "f": "Sin pensarlo, respondes: —Aquí estoy."}, {"v": "biblio;S=sorprendido@0.5;cu", "f": "Sofía da un salto, mira a todos lados… y no ve a nadie."}, {"v": "biblio;X=preocupado@0.5~inv", "f": "Sales corriendo antes de arruinarlo más."}]}, {"tipo": "planos", "titulo": "", "frames": 831, "words": [["Por", 0.15], ["la", 0.46], ["tarde,", 0.78], ["la", 1.09], ["gracia", 1.4], ["se", 1.71], ["acaba.", 2.02], ["Nadie", 2.34], ["te", 2.65], ["habla.", 2.96], ["Nadie", 3.27], ["te", 3.59], ["mira.", 3.9], ["Comes", 4.21], ["solo.", 4.53], ["Caminas", 4.84], ["solo.", 5.15], ["Y", 5.46], ["empiezas", 5.78], ["a", 6.09], ["pensar:", 6.4], ["¿y", 6.71], ["si", 7.03], ["no", 7.34], ["vuelvo?", 7.65], ["¿Y", 7.96], ["si", 8.28], ["me", 8.59], ["quedo", 8.9], ["así", 9.21], ["para", 9.53], ["siempre?", 9.84], ["Escuchas", 10.15], ["a", 10.46], ["tu", 10.78], ["mamá", 11.09], ["llamando", 11.4], ["a", 11.71], ["tus", 12.03], ["amigos,", 12.34], ["preguntando", 12.65], ["por", 12.96], ["ti,", 13.28], ["con", 13.59], ["la", 13.9], ["voz", 14.21], ["cada", 14.53], ["vez", 14.84], ["más", 15.15], ["nerviosa.", 15.46], ["Le", 15.78], ["gritas", 16.09], ["que", 16.4], ["estás", 16.71], ["ahí.", 17.02], ["Que", 17.34], ["estás", 17.65], ["bien.", 17.96], ["Pero", 18.27], ["ella", 18.59], ["no", 18.9], ["te", 19.21], ["escucha.", 19.52], ["O", 19.84], ["no", 20.15], ["quiere", 20.46], ["creer", 20.77], ["lo", 21.09], ["que", 21.4], ["escucha.", 21.71], ["Ser", 22.02], ["invisible", 22.34], ["sonaba", 22.65], ["increíble.", 22.96], ["Hasta", 23.27], ["que", 23.59], ["entiendes", 23.9], ["que", 24.21], ["lo", 24.52], ["mejor", 24.84], ["de", 25.15], ["existir", 25.46], ["es", 25.77], ["que", 26.09], ["alguien", 26.4], ["te", 26.71], ["vea.", 27.02]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "reloj": "08:00"}, "planos": [{"v": "noche;X=preocupado@0.5~inv", "f": "Por la tarde, la gracia se acaba."}, {"v": "noche;X=pensando@0.5~inv;cu", "f": "Nadie te habla. Nadie te mira. Comes solo. Caminas solo."}, {"v": "noche;X=preocupado@0.5~inv;cu", "f": "Y empiezas a pensar: ¿y si no vuelvo? ¿Y si me quedo así para siempre?"}, {"v": "cuarto;M=preocupado@0.5;cu", "f": "Escuchas a tu mamá llamando a tus amigos, preguntando por ti, con la voz cada vez más nerviosa."}, {"v": "cuarto;X=llorando@0.5~inv;cu", "f": "Le gritas que estás ahí. Que estás bien. Pero ella no te escucha. O no quiere creer lo que escucha."}, {"v": "neutro;ui:¿Y SI NO VUELVO?", "f": "Ser invisible sonaba increíble. Hasta que entiendes que lo mejor de existir es que alguien te vea."}]}, {"tipo": "planos", "titulo": "", "frames": 662, "words": [["De", 0.15], ["regreso", 0.46], ["a", 0.78], ["casa", 1.09], ["ves", 1.4], ["a", 1.71], ["tu", 2.02], ["hermano", 2.34], ["jugando", 2.65], ["con", 2.96], ["una", 3.27], ["pelota", 3.59], ["cerca", 3.9], ["de", 4.21], ["la", 4.53], ["calle.", 4.84], ["La", 5.15], ["pelota", 5.46], ["rueda", 5.78], ["hacia", 6.09], ["la", 6.4], ["pista.", 6.71], ["Él", 7.03], ["corre", 7.34], ["detrás", 7.65], ["sin", 7.96], ["mirar.", 8.28], ["Un", 8.59], ["carro", 8.9], ["viene", 9.21], ["a", 9.53], ["toda", 9.84], ["velocidad.", 10.15], ["No", 10.46], ["lo", 10.78], ["piensas.", 11.09], ["Corres", 11.4], ["más", 11.71], ["rápido", 12.03], ["que", 12.34], ["nunca", 12.65], ["y", 12.96], ["lo", 13.28], ["jalas", 13.59], ["hacia", 13.9], ["la", 14.21], ["acera.", 14.53], ["El", 14.84], ["carro", 15.15], ["pasa", 15.46], ["a", 15.78], ["centímetros.", 16.09], ["Tu", 16.4], ["hermano", 16.71], ["mira", 17.02], ["alrededor,", 17.34], ["temblando,", 17.65], ["sin", 17.96], ["entender", 18.27], ["quién", 18.59], ["lo", 18.9], ["salvó.", 19.21], ["Y", 19.52], ["dice,", 19.84], ["bajito:", 20.15], ["—Gracias…", 20.46], ["seas", 20.77], ["quien", 21.09], ["seas.", 21.4]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "reloj": "04:10"}, "planos": [{"v": "calle;H=riendo@0.4;X=normal@0.75~inv", "f": "De regreso a casa ves a tu hermano jugando con una pelota cerca de la calle."}, {"v": "calle;H=riendo@0.5;fx:pelota", "f": "La pelota rueda hacia la pista. Él corre detrás sin mirar."}, {"v": "calle;H=sorprendido@0.5;cu", "f": "Un carro viene a toda velocidad."}, {"v": "calle;X=enojado@0.5~inv;cu", "f": "No lo piensas. Corres más rápido que nunca y lo jalas hacia la acera."}, {"v": "calle;H=llorando@0.5;cu", "f": "El carro pasa a centímetros. Tu hermano mira alrededor, temblando, sin entender quién lo salvó."}, {"v": "calle;H=llorando@0.4;X=llorando@0.7~inv", "f": "Y dice, bajito: —Gracias… seas quien seas."}]}, {"tipo": "planos", "titulo": "", "frames": 512, "words": [["Esa", 0.15], ["noche", 0.46], ["te", 0.78], ["sientas", 1.09], ["en", 1.4], ["tu", 1.71], ["cama", 2.02], ["a", 2.34], ["esperar.", 2.65], ["Once", 2.96], ["y", 3.27], ["cincuenta", 3.59], ["y", 3.9], ["nueve.", 4.21], ["Tres…", 4.53], ["dos…", 4.84], ["uno…", 5.15], ["Un", 5.46], ["cosquilleo", 5.78], ["te", 6.09], ["recorre", 6.4], ["el", 6.71], ["cuerpo.", 7.03], ["Miras", 7.34], ["tus", 7.65], ["manos.", 7.96], ["Ahí", 8.28], ["están.", 8.59], ["Bajas", 8.9], ["corriendo", 9.21], ["y", 9.53], ["abrazas", 9.84], ["a", 10.15], ["tu", 10.46], ["mamá", 10.78], ["tan", 11.09], ["fuerte", 11.4], ["que", 11.71], ["casi", 12.03], ["se", 12.34], ["le", 12.65], ["cae", 12.96], ["el", 13.28], ["café.", 13.59], ["Tu", 13.9], ["perro,", 14.21], ["por", 14.53], ["fin,", 14.84], ["deja", 15.15], ["de", 15.46], ["ladrarle", 15.78], ["al", 16.09], ["aire.", 16.4]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "reloj": "00:00"}, "planos": [{"v": "noche;X=pensando@0.5~inv", "f": "Esa noche te sientas en tu cama a esperar."}, {"v": "noche;fx:cuenta", "f": "Once y cincuenta y nueve. Tres… dos… uno…"}, {"v": "noche;X=sorprendido@0.5;fx:brillo", "f": "Un cosquilleo te recorre el cuerpo. Miras tus manos. Ahí están."}, {"v": "cuarto;M=llorando@0.62!saluda;X=riendo@0.3", "f": "Bajas corriendo y abrazas a tu mamá tan fuerte que casi se le cae el café."}, {"v": "cocina;P=riendo@0.5", "f": "Tu perro, por fin, deja de ladrarle al aire."}]}, {"tipo": "planos", "titulo": "", "frames": 606, "words": [["Al", 0.15], ["día", 0.46], ["siguiente", 0.78], ["le", 1.09], ["respondes", 1.4], ["a", 1.71], ["Camila.", 2.02], ["Le", 2.34], ["das", 2.65], ["las", 2.96], ["gracias", 3.27], ["a", 3.59], ["Mateo.", 3.9], ["Y", 4.21], ["a", 4.53], ["Sofía", 4.84], ["le", 5.15], ["dices:", 5.46], ["—Ayer", 5.78], ["sí", 6.09], ["vine.", 6.4], ["Solo", 6.71], ["que", 7.03], ["no", 7.34], ["me", 7.65], ["viste.", 7.96], ["Ella", 8.28], ["se", 8.59], ["ríe", 8.9], ["sin", 9.21], ["entender", 9.53], ["nada.", 9.84], ["Pero", 10.15], ["sonríe.", 10.46], ["Porque", 10.78], ["no", 11.09], ["necesitas", 11.4], ["ser", 11.71], ["invisible", 12.03], ["para", 12.34], ["descubrir", 12.65], ["quién", 12.96], ["te", 13.28], ["quiere.", 13.59], ["Solo", 13.9], ["necesitas", 14.21], ["fijarte.", 14.53], ["Y", 14.84], ["tú,", 15.15], ["si", 15.46], ["fueras", 15.78], ["invisible", 16.09], ["por", 16.4], ["veinticuatro", 16.71], ["horas,", 17.02], ["¿qué", 17.34], ["harías", 17.65], ["primero?", 17.96], ["Te", 18.27], ["leo", 18.59], ["en", 18.9], ["los", 19.21], ["comentarios.", 19.52]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "reloj": null}, "planos": [{"v": "salon;X=riendo@0.3;C=riendo@0.68", "f": "Al día siguiente le respondes a Camila. Le das las gracias a Mateo."}, {"v": "biblio;X=sonrojado@0.3;S=sonrojado@0.68", "f": "Y a Sofía le dices: —Ayer sí vine. Solo que no me viste."}, {"v": "biblio;S=riendo@0.5;cu", "f": "Ella se ríe sin entender nada. Pero sonríe."}, {"v": "patio;X=riendo@0.5;fx:brillo", "f": "Porque no necesitas ser invisible para descubrir quién te quiere. Solo necesitas fijarte."}, {"v": "neutro;X=pensando@0.5;ui:¿QUÉ HARÍAS TÚ?", "f": "Y tú, si fueras invisible por veinticuatro horas, ¿qué harías primero? Te leo en los comentarios."}]}]