[{"tipo": "planos", "titulo": "", "frames": 316, "words": [["Imagina", 0.15], ["que", 0.63], ["te", 0.76], ["despiertas,", 0.88], ["te", 1.97], ["miras", 2.08], ["al", 2.42], ["espejo", 2.53], ["y", 3.1], ["no", 3.8], ["hay", 3.96], ["nadie.", 4.08], ["Eres", 5.17], ["invisible.", 5.51], ["Solo", 6.94], ["por", 7.3], ["24", 7.57], ["horas,", 7.98], ["¿qué", 9.19], ["harías", 9.46], ["primero?", 9.78]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "reloj": null}, "planos": [{"v": "cuarto;X=normal@0.5;cu", "f": "Imagina que te despiertas, te miras al espejo…"}, {"v": "cuarto;fx:espejo", "f": "y no hay nadie."}, {"v": "cuarto;X=sorprendido@0.5~inv;cu", "f": "Eres invisible."}, {"v": "neutro;ui:24 HORAS", "f": "Solo por veinticuatro horas."}, {"v": "neutro;X=pensando@0.5~inv", "f": "¿Qué harías primero?"}]}, {"tipo": "planos", "titulo": "", "frames": 101, "words": [["¿Qué", 0.05], ["pasaría", 0.12], ["si", 0.53], ["fueras", 0.71], ["invisible", 1.07], ["por", 1.5], ["24", 1.93], ["horas?", 2.39]], "caps": [], "p": {"esc": null, "med": null, "flash": true, "reloj": null}, "planos": [{"v": "tit", "f": "¿Qué pasaría si fueras invisible por 24 horas?"}]}, {"tipo": "planos", "titulo": "", "frames": 519, "words": [["Suena", 0.05], ["la", 0.41], ["alarma.", 0.59], ["Te", 1.68], ["estiras.", 1.78], ["Vas", 2.8], ["al", 3.02], ["baño", 3.23], ["medio", 3.48], ["dormido.", 3.68], ["Y", 4.89], ["en", 4.93], ["el", 5.04], ["espejo…", 5.16], ["solo", 6.02], ["está", 6.32], ["la", 6.57], ["pared.", 6.7], ["Te", 7.72], ["tocas", 8.0], ["la", 8.34], ["cara.", 8.47], ["Sí,", 9.33], ["ahí", 9.9], ["está.", 10.04], ["Pero", 10.92], ["no", 11.13], ["se", 11.36], ["ve.", 11.56], ["Por", 12.29], ["suerte,", 12.47], ["la", 13.22], ["ropa", 13.28], ["también", 13.65], ["desapareció.", 14.1], ["Eso", 15.49], ["hubiera", 15.69], ["sido", 16.01], ["un", 16.33], ["problema.", 16.49]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "reloj": "23:59"}, "planos": [{"v": "cuarto;X=normal@0.5", "f": "Suena la alarma. Te estiras. Vas al baño medio dormido."}, {"v": "cuarto;fx:espejo", "f": "Y en el espejo… solo está la pared."}, {"v": "cuarto;X=sorprendido@0.5~inv;cu", "f": "Te tocas la cara. Sí, ahí está. Pero no se ve."}, {"v": "cuarto;X=pensando@0.5~inv", "f": "Por suerte, la ropa también desapareció. Eso hubiera sido un problema."}]}, {"tipo": "planos", "titulo": "", "frames": 402, "words": [["Tu", 0.05], ["mamá", 0.12], ["abre", 0.44], ["la", 0.64], ["puerta.", 0.8], ["—¡Arriba,", 1.82], ["que", 2.37], ["llegas", 2.41], ["tarde!", 2.75], ["Mira", 3.64], ["la", 3.91], ["cama", 4.11], ["vacía.", 4.34], ["Mira", 5.54], ["debajo", 5.75], ["de", 6.18], ["la", 6.32], ["cama.", 6.43], ["—¿Ya", 7.52], ["se", 7.65], ["fue", 7.81], ["este", 8.0], ["niño", 8.2], ["sin", 8.47], ["desayunar?", 8.7], ["Estás", 9.88], ["a", 10.33], ["medio", 10.42], ["metro", 10.65], ["de", 11.01], ["ella.", 11.26], ["Aguantas", 12.08], ["la", 12.56], ["risa.", 12.79]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "reloj": "23:40"}, "planos": [{"v": "cuarto;M=normal@0.62!saluda;X=normal@0.28~inv", "f": "Tu mamá abre la puerta: —¡Arriba, que llegas tarde!"}, {"v": "cuarto;M=sorprendido@0.5;cu", "f": "Mira la cama vacía. Mira debajo de la cama."}, {"v": "cuarto;M=enojado@0.5;cu", "f": "—¿Ya se fue este niño sin desayunar?"}, {"v": "cuarto;X=riendo@0.5~inv;cu", "f": "Estás a medio metro de ella. Aguantas la risa."}]}, {"tipo": "planos", "titulo": "", "frames": 281, "words": [["Pero", 0.05], ["tu", 0.16], ["perro", 0.35], ["no", 0.62], ["se", 0.78], ["deja", 0.94], ["engañar.", 1.14], ["—Te", 2.21], ["huele.", 2.46], ["Le", 3.32], ["ladra", 3.43], ["al", 3.75], ["aire", 3.86], ["durante", 4.05], ["cinco", 4.3], ["minutos", 4.77], ["seguidos.", 5.2], ["—¿Y", 6.32], ["a", 6.5], ["este", 6.59], ["perro", 6.77], ["qué", 7.13], ["le", 7.25], ["pasa?", 7.34], ["—dice", 8.29], ["tu", 8.63], ["mamá.", 8.77]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "reloj": "23:20"}, "planos": [{"v": "cocina;P=sorprendido@0.6;X=normal@0.25~inv", "f": "Pero tu perro no se deja engañar. Te huele."}, {"v": "cocina;P=enojado@0.5", "f": "Le ladra al aire durante cinco minutos seguidos."}, {"v": "cocina;M=pensando@0.6;P=enojado@0.3", "f": "—¿Y a este perro qué le pasa? —dice tu mamá."}]}, {"tipo": "planos", "titulo": "", "frames": 544, "words": [["Tienes", 0.05], ["hambre.", 0.37], ["Agarras", 1.28], ["una", 1.71], ["tostada.", 1.84], ["Tu", 3.05], ["hermano", 3.27], ["levanta", 3.68], ["la", 4.07], ["vista", 4.11], ["y", 4.43], ["ve", 4.89], ["una", 5.02], ["tostada", 5.18], ["flotando", 5.66], ["en", 6.16], ["el", 6.29], ["aire.", 6.43], ["Una", 7.47], ["tostada.", 7.65], ["Flotando.", 8.7], ["Mordiéndose", 9.88], ["sola.", 10.56], ["—¡Mamá!", 11.49], ["¡La", 12.35], ["tostada", 12.54], ["está", 13.04], ["embrujada!", 13.22], ["Deja", 14.44], ["de", 14.74], ["inventar", 14.87], ["y", 15.44], ["come.", 15.56], ["Primer", 16.46], ["punto", 16.8], ["para", 17.19], ["el", 17.46], ["poder.", 17.58]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "reloj": "23:05"}, "planos": [{"v": "cocina;X=normal@0.35~inv;fx:tostada", "f": "Tienes hambre. Agarras una tostada."}, {"v": "cocina;H=sorprendido@0.62;X=normal@0.3~inv;fx:tostada", "f": "Tu hermano levanta la vista y ve una tostada flotando en el aire."}, {"v": "cocina;H=sorprendido@0.5;cu", "f": "Una tostada. Flotando. Mordiéndose sola."}, {"v": "cocina;H=llorando@0.4;M=enojado@0.7", "f": "—¡Mamá! ¡La tostada está embrujada! —Deja de inventar y come."}, {"v": "cocina;X=riendo@0.5~inv;cu", "f": "Primer punto para el poder."}]}, {"tipo": "planos", "titulo": "", "frames": 972, "words": [["En", 0.05], ["la", 0.19], ["calle", 0.3], ["te", 0.53], ["das", 0.73], ["cuenta", 0.89], ["de", 1.12], ["algo.", 1.37], ["Nadie", 2.21], ["te", 2.62], ["ve,", 2.82], ["así", 3.43], ["que", 3.66], ["nadie", 3.84], ["te", 4.18], ["juzga.", 4.45], ["Bailas", 5.59], ["en", 5.98], ["la", 6.13], ["acera.", 6.27], ["Haces", 7.16], ["caras.", 7.36], ["Cantas", 8.43], ["en", 8.81], ["voz", 8.99], ["alta.", 9.11], ["El", 10.15], ["señor", 10.27], ["del", 10.54], ["kiosco", 10.72], ["escucha", 11.17], ["una", 11.61], ["canción", 11.76], ["que", 12.17], ["sale", 12.42], ["de", 12.67], ["la", 12.83], ["nada", 12.97], ["y", 13.24], ["se", 13.69], ["persigna.", 13.83], ["Una", 15.15], ["paloma", 15.46], ["camina", 15.83], ["directo", 16.21], ["hacia", 16.67], ["ti,", 16.8], ["choca", 17.62], ["con", 17.87], ["tu", 18.1], ["zapato", 18.21], ["y", 18.64], ["se", 18.94], ["queda", 19.05], ["mirándote", 19.26], ["como", 19.8], ["si", 20.03], ["hubiera", 20.16], ["visto", 20.39], ["un", 20.64], ["fantasma.", 20.82], ["Llegas", 22.07], ["al", 22.41], ["colegio.", 22.59], ["La", 23.89], ["directora", 24.0], ["vigila", 24.52], ["la", 24.91], ["puerta", 25.07], ["como", 25.32], ["siempre.", 25.59], ["Pasas", 26.77], ["a", 27.13], ["su", 27.29], ["lado", 27.34], ["tarde,", 27.56], ["sin", 28.43], ["uniforme", 28.56], ["completo,", 29.06], ["y", 30.15], ["no", 30.24], ["pasa", 30.45], ["nada.", 30.72], ["Nada.", 31.7]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "reloj": "22:30"}, "planos": [{"v": "calle;X=riendo@0.5~inv", "f": "En la calle te das cuenta de algo: nadie te ve, así que nadie te juzga."}, {"v": "calle;X=riendo@0.5~inv;cu", "f": "Bailas en la acera. Haces caras. Cantas en voz alta."}, {"v": "calle;K=sorprendido@0.6;X=riendo@0.25~inv", "f": "El señor del kiosco escucha una canción que sale de la nada y se persigna."}, {"v": "calle;X=riendo@0.5~inv", "f": "Una paloma camina directo hacia ti, choca con tu zapato y se queda mirándote como si hubiera visto un fantasma."}, {"v": "entrada;D=enojado@0.6;X=normal@0.25~inv", "f": "Llegas al colegio. La directora vigila la puerta como siempre."}, {"v": "entrada;X=riendo@0.5~inv;cu", "f": "Pasas a su lado tarde, sin uniforme completo, y no pasa nada. Nada."}]}, {"tipo": "planos", "titulo": "", "frames": 819, "words": [["En", 0.05], ["clase", 0.19], ["el", 0.46], ["profesor", 0.69], ["pasa", 1.23], ["lista.", 1.5], ["Dice", 2.75], ["tu", 3.02], ["nombre.", 3.16], ["Nadie", 4.14], ["responde.", 4.5], ["—Ausente.", 5.84], ["Otra", 7.18], ["vez.", 7.52], ["Y", 8.36], ["entonces", 8.52], ["lo", 8.81], ["ves.", 9.09], ["Sobre", 9.77], ["su", 10.02], ["escritorio,", 10.15], ["las", 11.22], ["respuestas", 11.38], ["del", 11.99], ["examen", 12.24], ["de", 12.69], ["mañana.", 12.81], ["Nadie", 13.81], ["te", 14.22], ["vería.", 14.37], ["Nadie", 15.26], ["lo", 15.67], ["sabría", 15.78], ["nunca.", 16.17], ["Lo", 17.14], ["piensas", 17.26], ["un", 17.69], ["segundo…", 17.87], ["y", 18.85], ["te", 19.03], ["alejas", 19.19], ["del", 19.51], ["escritorio.", 19.71], ["Ser", 21.07], ["invisible", 21.23], ["no", 21.8], ["te", 22.07], ["convierte", 22.23], ["en", 22.73], ["otra", 22.89], ["persona.", 23.02], ["Solo", 24.0], ["hace", 24.25], ["más", 24.54], ["fácil", 24.73], ["que", 25.09], ["se", 25.32], ["note", 25.48], ["quién", 25.75], ["eres", 26.2], ["de", 26.52], ["verdad.", 26.66]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "reloj": "20:15"}, "planos": [{"v": "salon;T=normal@0.6;X=normal@0.25~inv", "f": "En clase el profesor pasa lista. Dice tu nombre. Nadie responde."}, {"v": "salon;T=enojado@0.5;cu;ui:AUSENTE", "f": "—Ausente. Otra vez."}, {"v": "salon;X=pensando@0.5~inv;fx:examen", "f": "Y entonces lo ves: sobre su escritorio, las respuestas del examen de mañana."}, {"v": "salon;X=pensando@0.5~inv;cu", "f": "Nadie te vería. Nadie lo sabría nunca."}, {"v": "salon;X=normal@0.5~inv", "f": "Lo piensas un segundo… y te alejas del escritorio."}, {"v": "salon;X=riendo@0.5~inv;cu", "f": "Ser invisible no te convierte en otra persona. Solo hace más fácil que se note quién eres de verdad."}]}, {"tipo": "planos", "titulo": "", "frames": 834, "words": [["Claro", 0.05], ["que", 0.28], ["no", 0.46], ["todo", 0.59], ["es", 0.89], ["tan", 1.12], ["noble.", 1.23], ["Hay", 2.09], ["que", 2.39], ["aprovechar", 2.5], ["un", 2.91], ["poco.", 3.07], ["Le", 3.82], ["escondes", 3.91], ["la", 4.41], ["tiza", 4.54], ["al", 4.86], ["profesor.", 5.02], ["Él", 6.34], ["busca", 6.5], ["en", 6.79], ["su", 7.02], ["bolsillo,", 7.16], ["en", 7.86], ["el", 7.97], ["escritorio,", 8.06], ["debajo", 8.9], ["de", 9.22], ["la", 9.4], ["silla.", 9.49], ["Se", 10.52], ["la", 10.65], ["devuelves", 10.77], ["justo", 11.2], ["delante", 11.51], ["de", 12.06], ["él,", 12.24], ["sobre", 12.83], ["el", 13.13], ["libro.", 13.33], ["El", 14.31], ["profesor", 14.44], ["la", 14.94], ["mira,", 15.03], ["se", 15.71], ["quita", 15.83], ["las", 16.03], ["gafas,", 16.21], ["se", 17.14], ["las", 17.24], ["vuelve", 17.35], ["a", 17.69], ["poner…", 17.76], ["y", 18.53], ["decide", 18.78], ["que", 19.07], ["mejor", 19.26], ["hoy", 19.6], ["da", 19.78], ["clase", 19.96], ["sin", 20.37], ["tiza.", 20.64], ["Media", 21.59], ["clase", 21.89], ["se", 22.34], ["ríe", 22.64], ["sin", 23.0], ["saber", 23.23], ["de", 23.52], ["qué.", 23.73], ["Y", 24.41], ["tú", 24.45], ["te", 24.57], ["ríes", 24.7], ["más", 24.98], ["fuerte", 25.11], ["que", 25.41], ["todos,", 25.57], ["porque", 26.45], ["nadie", 26.63], ["te", 26.91], ["escucha.", 27.11]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "reloj": "19:30"}, "planos": [{"v": "salon;T=normal@0.6;X=riendo@0.25~inv", "f": "Claro que no todo es tan noble. Hay que aprovechar un poco."}, {"v": "salon;T=sorprendido@0.5;cu", "f": "Le escondes la tiza al profesor. Él busca en su bolsillo, en el escritorio, debajo de la silla."}, {"v": "salon;X=riendo@0.5~inv;cu", "f": "Se la devuelves justo delante de él, sobre el libro."}, {"v": "salon;T=sorprendido@0.6;X=riendo@0.25~inv", "f": "El profesor la mira, se quita las gafas, se las vuelve a poner… y decide que mejor hoy da clase sin tiza."}, {"v": "salon;C=riendo@0.4;MT=riendo@0.72", "f": "Media clase se ríe sin saber de qué. Y tú te ríes más fuerte que todos, porque nadie te escucha."}]}, {"tipo": "planos", "titulo": "", "frames": 911, "words": [["En", 0.05], ["el", 0.16], ["almuerzo", 0.3], ["descubres", 0.82], ["el", 1.53], ["lado", 1.68], ["malo.", 1.93], ["—No", 2.93], ["puedes", 3.0], ["comprar", 3.36], ["comida.", 3.7], ["Intentas", 4.61], ["pedir", 5.11], ["una", 5.36], ["pizza.", 5.63], ["La", 6.61], ["señora", 6.75], ["de", 7.04], ["la", 7.22], ["cafetería", 7.34], ["escucha", 7.97], ["una", 8.65], ["voz,", 8.81], ["grita", 9.68], ["y", 10.08], ["cierra", 10.36], ["la", 10.67], ["ventanilla.", 10.83], ["Te", 12.08], ["sientas", 12.2], ["junto", 12.67], ["a", 12.85], ["Camila,", 13.04], ["como", 13.94], ["siempre.", 14.03], ["Ella", 15.17], ["deja", 15.37], ["un", 15.67], ["pedazo", 15.85], ["de", 16.26], ["pan", 16.4], ["en", 16.69], ["tu", 16.94], ["lugar", 17.1], ["vacío,", 17.35], ["por", 18.21], ["costumbre.", 18.35], ["Te", 19.64], ["lo", 19.78], ["comes.", 19.91], ["Ella", 20.84], ["mira", 21.05], ["el", 21.32], ["plato", 21.5], ["vacío,", 21.78], ["frunce", 22.73], ["el", 23.14], ["ceño…", 23.3], ["y", 24.27], ["sonríe", 24.34], ["como", 24.91], ["si", 25.11], ["supiera", 25.29], ["algo.", 25.66], ["—Qué", 26.68], ["raro", 26.84], ["—dice—.", 27.22], ["Juraría", 28.68], ["que", 29.09], ["hoy", 29.31], ["estás", 29.49], ["aquí.", 29.74]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "reloj": "18:50"}, "planos": [{"v": "comedor;X=normal@0.5~inv", "f": "En el almuerzo descubres el lado malo: no puedes comprar comida."}, {"v": "comedor;X=preocupado@0.5~inv;cu", "f": "Intentas pedir una pizza. La señora de la cafetería escucha una voz, grita y cierra la ventanilla."}, {"v": "comedor;C=normal@0.62;X=normal@0.28~inv", "f": "Te sientas junto a Camila, como siempre. Ella deja un pedazo de pan en tu lugar vacío, por costumbre."}, {"v": "comedor;X=sonrojado@0.5~inv;cu", "f": "Te lo comes. Ella mira el plato vacío, frunce el ceño… y sonríe como si supiera algo."}, {"v": "comedor;C=pensando@0.5;cu", "f": "—Qué raro —dice—. Juraría que hoy estás aquí."}]}, {"tipo": "planos", "titulo": "", "frames": 764, "words": [["En", 0.05], ["el", 0.16], ["pasillo", 0.28], ["pasa", 0.64], ["algo", 0.89], ["que", 1.21], ["no", 1.39], ["esperabas.", 1.53], ["Escuchas", 2.64], ["lo", 3.14], ["que", 3.27], ["dicen", 3.39], ["de", 3.64], ["ti", 3.82], ["cuando", 4.0], ["no", 4.16], ["estás.", 4.41], ["Mateo,", 5.43], ["el", 6.0], ["popular,", 6.11], ["dice.", 6.91], ["El", 7.95], ["de", 8.11], ["la", 8.25], ["gorra", 8.36], ["es", 8.68], ["buena", 8.84], ["gente.", 9.04], ["El", 10.08], ["otro", 10.22], ["día", 10.4], ["me", 10.7], ["ayudó", 10.99], ["con", 11.38], ["mates.", 11.51], ["Mateo.", 12.56], ["Sabe", 13.53], ["que", 13.78], ["existes.", 13.94], ["Camila", 14.92], ["mira", 15.31], ["tu", 15.51], ["silla", 15.76], ["vacía", 16.01], ["y", 16.58], ["dice.", 16.89], ["—Qué", 17.87], ["raro", 17.96], ["que", 18.28], ["no", 18.44], ["vino.", 18.57], ["Le", 19.35], ["voy", 19.44], ["a", 19.6], ["escribir.", 19.71], ["Tu", 20.64], ["celular", 20.78], ["vibra", 21.19], ["en", 21.8], ["tu", 21.96], ["bolsillo.", 22.07], ["¿Estás", 23.32], ["bien?", 23.64], ["Es", 24.73], ["ella.", 24.86]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "reloj": "17:40"}, "planos": [{"v": "pasillo;MT=normal@0.3;C=normal@0.68;X=normal@0.5~inv", "f": "En el pasillo pasa algo que no esperabas: escuchas lo que dicen de ti cuando no estás."}, {"v": "pasillo;MT=riendo@0.5;cu", "f": "Mateo, el popular, dice: —El de la gorra es buena gente. El otro día me ayudó con mates."}, {"v": "pasillo;X=sorprendido@0.5~inv;cu", "f": "Mateo. Sabe que existes."}, {"v": "pasillo;C=preocupado@0.5;cu", "f": "Camila mira tu silla vacía y dice: —Qué raro que no vino. Le voy a escribir."}, {"v": "pasillo;X=sonrojado@0.5~inv", "f": "Tu celular vibra en tu bolsillo. \"¿Estás bien?\". Es ella."}]}, {"tipo": "planos", "titulo": "", "frames": 854, "words": [["En", 0.05], ["la", 0.14], ["biblioteca", 0.23], ["está", 0.78], ["Sofía,", 0.98], ["en", 1.93], ["la", 2.05], ["mesa", 2.14], ["de", 2.37], ["siempre,", 2.55], ["dibujando.", 3.46], ["Te", 4.84], ["acercas", 5.04], ["despacio.", 5.52], ["Por", 6.77], ["primera", 6.93], ["vez", 7.25], ["puedes", 7.54], ["mirar", 7.84], ["su", 8.27], ["cuaderno", 8.4], ["sin", 8.93], ["que", 9.13], ["lo", 9.29], ["cierre", 9.43], ["de", 9.77], ["golpe.", 9.86], ["Es", 10.92], ["un", 11.13], ["dibujo", 11.26], ["tuyo.", 11.7], ["Con", 12.51], ["la", 12.67], ["gorra.", 12.83], ["Sonriendo.", 13.74], ["Ella", 14.94], ["suspira", 15.17], ["y", 15.76], ["dice", 16.08], ["bajito.", 16.3], ["—Ojalá", 17.46], ["hubiera", 17.8], ["venido", 18.05], ["hoy.", 18.44], ["Sin", 19.1], ["pensarlo,", 19.28], ["respondes.", 19.91], ["Aquí", 20.87], ["estoy.", 21.09], ["Sofía", 21.98], ["da", 22.39], ["un", 22.5], ["salto,", 22.64], ["mira", 23.43], ["a", 23.61], ["todos", 23.75], ["lados", 24.0], ["y", 24.25], ["no", 24.59], ["ve", 24.73], ["a", 24.86], ["nadie.", 24.95], ["Sales", 25.84], ["corriendo", 26.0], ["antes", 26.61], ["de", 27.04], ["arruinarlo", 27.27], ["más.", 27.86]], "caps": [], "p": {"esc": null, "med": null, "flash": false, "reloj": "14:20"}, "planos": [{"v": "biblio;S=normal@0.62;X=normal@0.28~inv", "f": "En la biblioteca está Sofía, en la mesa de siempre, dibujando."}, {"v": "biblio;X=sonrojado@0.5~inv", "f": "Te acercas despacio. Por primera vez puedes mirar su cuaderno sin que lo cierre de golpe."}, {"v": "neutro;fx:dibujos", "f": "Es un dibujo tuyo. Con la gorra. Sonriendo."}, {"v": "biblio;S=sonrojado@0.5;cu", "f": "Ella suspira y dice bajito: —Ojalá hubiera venido hoy."}, {"v": "biblio;X=sonrojado@0.5~inv;cu", "f": "Sin pensarlo, respondes: —Aquí estoy."}, {"v": "biblio;S=sorprendido@0.5;cu", "f": "Sofía da un salto, mira a todos lados… y no ve a nadie."}, {"v": "biblio;X=preocupado@0.5~inv", "f": "Sales corriendo antes de arruinarlo más."}]}, {"tipo": "planos", "titulo": "", "frames": 958, "words": [["Por", 0.05], ["la", 0.14], ["tarde,", 0.3], ["la", 1.16], ["gracia"